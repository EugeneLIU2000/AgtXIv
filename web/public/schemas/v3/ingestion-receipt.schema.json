{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/ingestion-receipt.schema.json",
  "title": "KnowledgeIngestionReceipt",
  "description": "Atomic before/after transaction with a total candidate partition.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.ingestion-receipt/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "before_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.knowledge-snapshot/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact snapshot compared before mutation."
        },
        "after_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.knowledge-snapshot/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact resulting snapshot, identical on abort."
        },
        "decision_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.admission-decision/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact accepted/rejected/blocked partition."
        },
        "candidate_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Complete transaction candidate universe."
        },
        "accepted_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "All and only authorized additions."
        },
        "rejected_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Rejected candidates."
        },
        "blocked_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Candidates still blocked."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ABORTED",
            "COMMITTED"
          ],
          "description": "Actual atomic transaction result."
        }
      },
      "required": [
        "before_ref",
        "after_ref",
        "decision_ref",
        "candidate_refs",
        "accepted_refs",
        "rejected_refs",
        "blocked_refs",
        "outcome"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false
}
