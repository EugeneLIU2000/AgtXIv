{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/source-snapshot.schema.json",
  "title": "SourceSnapshot",
  "description": "Immutable source bytes and acquisition boundary for one paper version.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.source-snapshot/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Exact bibliographic work identifier."
        },
        "paper_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Explicit source version, never latest."
        },
        "source_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "description": "Acquisition location retained as provenance."
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40,
          "description": "Time the bytes were acquired."
        },
        "acquisition_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
                },
                {
                  "properties": {
                    "record_type": {
                      "enum": [
                        "agtxiv.v3.source-acquisition/0.0.0"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact acquisition report when available; local legacy inputs may have no such history."
        },
        "acquisition_method": {
          "type": "string",
          "enum": [
            "ARXIV_SOURCE",
            "ARXIV_PDF",
            "LOCAL_IMPORT",
            "OTHER_EXACT_SOURCE"
          ],
          "description": "How these bytes were obtained."
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/SourceUnit"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Complete supplied source inventory."
        },
        "archive": {
          "anyOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original source archive if available."
        },
        "missing_material": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 10000,
          "description": "Source material known to be absent."
        },
        "rights_status": {
          "type": "string",
          "enum": [
            "KNOWN",
            "UNRESOLVED",
            "RESTRICTED"
          ],
          "description": "Recorded availability and reuse-rights boundary."
        },
        "rights_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "Public source and redistribution conditions."
        }
      },
      "required": [
        "paper_id",
        "paper_version",
        "source_uri",
        "acquired_at",
        "acquisition_ref",
        "acquisition_method",
        "units",
        "archive",
        "missing_material",
        "rights_status",
        "rights_note"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false
}
