{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/release-audit.schema.json",
  "title": "ReleaseAudit",
  "description": "Independent paper-level review of the exact candidate and its scope.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.release-audit/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "manifest_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.release-manifest/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact fixed candidate under audit."
        },
        "review": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ReviewContext",
          "description": "Actual independent paper auditor."
        },
        "ordered_target_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Targets audited in dependency order."
        },
        "assessment_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "properties": {
                  "record_type": {
                    "enum": [
                      "agtxiv.v3.axis-assessment/0.0.0"
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Exact assessments selected without changing them."
        },
        "frontier_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "properties": {
                  "record_type": {
                    "enum": [
                      "agtxiv.v3.frontier-item/0.0.0"
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 10000,
          "description": "Complete retained frontier."
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "DO_NOT_RELEASE",
            "RECOMMEND_PROFILE_RELEASE"
          ],
          "description": "Profile-scoped recommendation, not paper truth."
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Public audit findings and limits."
        }
      },
      "required": [
        "manifest_ref",
        "review",
        "ordered_target_refs",
        "assessment_refs",
        "frontier_refs",
        "recommendation",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false
}
