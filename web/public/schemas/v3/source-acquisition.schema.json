{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/source-acquisition.schema.json",
  "title": "SourceAcquisition",
  "description": "Observed acquisition success or failure, including failures before a snapshot exists.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.source-acquisition/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "request_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.source-request/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact request and acquisition policy."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "FAILED",
            "BLOCKED",
            "ACQUIRED"
          ],
          "description": "Actual acquisition outcome, not source fidelity."
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40,
          "description": "Actual request start."
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40,
          "description": "Actual request completion."
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ArtifactRef"
          },
          "maxItems": 10000,
          "description": "Actual returned source bytes."
        },
        "final_uri": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ],
          "description": "Final observed URL, null if unavailable."
        },
        "transport_evidence": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ArtifactRef"
          },
          "maxItems": 10000,
          "description": "Retained transport evidence."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "Failure or success conditions and limitations."
        }
      },
      "required": [
        "request_ref",
        "outcome",
        "started_at",
        "finished_at",
        "artifacts",
        "final_uri",
        "transport_evidence",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "outcome": {
                "const": "ACQUIRED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "artifacts": {
                "minItems": 1
              },
              "final_uri": {
                "type": "string",
                "format": "uri",
                "maxLength": 4096
              }
            }
          }
        }
      }
    }
  ]
}
