{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/relation-assessment.schema.json",
  "title": "RelationAssessment",
  "description": "Witness-backed relation between exact claims or knowledge records.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.relation-assessment/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "source_ref": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef",
          "description": "Source endpoint; read source relation target."
        },
        "target_ref": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef",
          "description": "Target endpoint, distinct from the source."
        },
        "relation": {
          "type": "string",
          "enum": [
            "EQUIVALENT",
            "SPECIALIZES",
            "GENERALIZES",
            "CORRECTS",
            "QUALIFIES",
            "REFUTES",
            "SUPPORTS",
            "INCOMPARABLE",
            "CONFLICTING",
            "SAME_OCCURRENCE",
            "MATH_EQUIVALENT_SEMANTICS_DISTINCT"
          ],
          "description": "Exact typed relation."
        },
        "review": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ReviewContext",
          "description": "Independent relation assessment."
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ParameterComparison"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Domain, assumption and semantic alignment witnesses."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PROPOSED",
            "BLOCKED",
            "DISPUTED",
            "ACCEPTED",
            "REJECTED"
          ],
          "description": "Relation assessment state, not endpoint truth."
        },
        "witness_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Mathematical and scientific support."
        }
      },
      "required": [
        "source_ref",
        "target_ref",
        "relation",
        "review",
        "comparisons",
        "outcome",
        "witness_refs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "outcome": {
                "const": "ACCEPTED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "witness_refs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
