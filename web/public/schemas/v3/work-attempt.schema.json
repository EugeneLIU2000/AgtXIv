{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/work-attempt.schema.json",
  "title": "WorkAttempt",
  "description": "Bounded attributable execution with measured resource use.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.work-attempt/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "plan_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.agentization-plan/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Governing work budget."
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Executed operation."
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Exact inputs or targets."
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40,
          "description": "Execution start time."
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40,
          "description": "Execution stop time."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "FAILED",
            "BLOCKED",
            "DEFERRED",
            "SUCCEEDED"
          ],
          "description": "Execution outcome without scientific promotion."
        },
        "output_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Already-created outputs only; records referring back to this attempt are listed by a later completion receipt."
        },
        "logs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ArtifactRef"
          },
          "maxItems": 10000,
          "description": "Preserved public execution logs."
        },
        "cost_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Observed resource units."
        },
        "progress_observed": {
          "type": "boolean",
          "description": "Whether a new result or actionable diagnosis was obtained."
        }
      },
      "required": [
        "plan_ref",
        "operation",
        "target_refs",
        "started_at",
        "finished_at",
        "outcome",
        "output_refs",
        "logs",
        "cost_units",
        "progress_observed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false
}
