  "x-agtxiv-processing-limits": {
    "maxDownloadBytes": 8388608,
    "maxExpandedBytes": 16777216,
    "maxFileBytes": 2097152,
    "maxTexBytes": 4194304,
    "maxEntries": 1024,
    "maxFiles": 512,
    "maxPathBytes": 512,
    "maxCandidates": 240,
    "maxExcerptCharacters": 1800,
    "maxIncludes": 512,
    "maxCommands": 50000,
    "maxStructuralSpans": 4096,
    "maxReferenceCues": 1024,
    "maxCitationCues": 1024,
    "maxLabels": 1024,
    "maxIssues": 256,
    "maxAnchoredBytes": 33554432,
