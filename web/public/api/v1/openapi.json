        "operationId": "downloadV3Schema",
        "tags": [
          "Contracts"
        ],
        "summary": "Download an original V3 schema or manifest",
        "description": "Schema $id URIs are identifiers. Resolve canonical references through the downloaded local catalog; do not assume agtxiv.org serves schema bytes.",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "source-snapshot.schema.json"
          }
        ],
        "responses": {
          "200": {
            "description": "Unmodified source schema or manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job, paper, or resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Job": {
        "$ref": "job.schema.json"
      },
      "Analysis": {
        "$ref": "analysis.schema.json"
      },
      "Error": {
        "type": "object",
        "properties": {
          "api_version": {
            "const": "1.0"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "api_version",
          "error"
        ],
        "additionalProperties": false
      },
      "RecordRef": {
        "type": "object",
        "properties": {
          "record_type": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "record_type",
          "record_id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "Field": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "definition": {
            "type": "object"
          }
        },
        "required": [
          "name",
          "type",
          "required",
          "description",
          "definition"
        ],
        "additionalProperties": false
      },
      "RecordFamily": {
        "type": "object",
        "properties": {
          "record_type": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "roadmap_tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Field"
            }
          },
          "sha256": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "record_type",
          "schema",
          "title",
          "roadmap_tasks",
          "description",
          "fields",
          "sha256",
          "url"
        ],
        "additionalProperties": false
      },
      "Paper": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "arxiv",
          "source_url",
          "legacy_status",
          "provenance",
          "view",
          "imports",
          "claims",
          "note"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "arxiv": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
