{"artifact": {"artifact_hash": "sha256:d6b3635da05e8f867260c928d589861b72acfb49d08b60bd9e784b27f077fad3", "schema_uri": "https://agtxiv.org/schema/math-claimir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "claim": {"content_hash": "sha256:9cedb1a9746637e57cd67638f4242ee914232919c78350c9f2a34184d9a84ee7", "id": "claim:1307.7171v1:pure-stabilizer-clifford-orbit", "record_revision": 1}, "id": "math-claim-ir:1307.7171v1:pure-stabilizer-clifford-orbit", "normalization": {"preprocessing_record_ref": "source-preprocessing:1307.7171v1:resource-theory-of-stabilizer-computation", "profile": "agtxiv.expanded-standard-latex/1.0.0", "relation_to_source": "SOURCE_IMPLICIT_CONTEXT_EXPLICIT", "unresolved_symbols": []}, "normalized_statement_expanded_latex": "For every prime number $d$, let $\\mathcal{H}_d\\cong\\mathbb{C}^d$ and let $\\mathcal{C}_d$ be the Clifford group defined by its action on the generalized Pauli operators. The set of pure stabilizer state vectors is $\\operatorname{PureSTAB}(\\mathcal{H}_d)=\\{U\\left|0\\right\\rangle:U\\in\\mathcal{C}_d\\}$.", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.math-claimir/1.0.0", "semantic_content_hash": "sha256:028dd871c4570f0e74870ebb8dc139aff4f63aa61dbecdaaf02f9e7ff01718c9", "source": {"occurrence_work": "arxiv:1307.7171v1", "proof_anchors": [], "source_statement_expanded_latex": "For prime dimension $d$, the pure stabilizer states are defined as $\\{S_i\\}=\\{U\\left|0\\right\\rangle:U\\in\\mathcal{C}_d\\}$.", "statement_anchors": ["anchor:1307.7171v1:stabilizer-free-set"]}, "statement_kind": "definition", "structured_statement": {"assumptions": {"explicit": [], "source_implicit": [{"expression_latex": "\\mathcal{H}_d\\cong\\mathbb{C}^d", "id": "hilbert-space-dimension", "origin": "SOURCE_IMPLICIT"}]}, "conclusion": {"expression_latex": "\\operatorname{PureSTAB}(\\mathcal{H}_d)=\\{U\\left|0\\right\\rangle\\mid U\\in\\mathcal{C}_d\\}", "relation": "definition"}, "conventions": ["The Clifford group is the source-defined normalizer of the generalized Pauli operators up to phase.", "Pure states are represented here by unit vectors, as in the displayed source definition."], "local_binders": [], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": [{"binder": "forall", "domain_latex": "\\{p\\in\\mathbb{N}:p\\text{ is prime}\\}", "origin": "SOURCE_EXPLICIT", "variable_latex": "d"}], "typed_objects": [{"scope": "claim", "semantic_type": "prime_natural_number", "symbol_latex": "d"}, {"scope": "claim", "semantic_type": "finite_dimensional_complex_hilbert_space", "symbol_latex": "\\mathcal{H}_d"}, {"carrier_latex": "\\mathcal{H}_d", "scope": "claim", "semantic_type": "clifford_group", "symbol_latex": "\\mathcal{C}_d"}, {"carrier_latex": "\\mathcal{H}_d", "scope": "claim", "semantic_type": "unit_vector", "symbol_latex": "\\left|0\\right\\rangle"}, {"carrier_latex": "\\mathcal{H}_d", "scope": "claim", "semantic_type": "set_of_pure_state_vectors", "symbol_latex": "\\operatorname{PureSTAB}(\\mathcal{H}_d)"}]}, "supersedes": null}
