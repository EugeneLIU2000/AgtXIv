{"artifact": {"artifact_hash": "sha256:ee07e13b088906620c6516ec68e5baa2c67a56bbd8f28e788c4c265065d2fcaf", "schema_uri": "https://agtxiv.org/schema/math-claimir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "claim": {"content_hash": "sha256:1d6823403ccfcfb8c18b178d6025a075d452b2aa5e05df35d3dc4893ac67d94b", "id": "claim:9705052v1:stabilizer-coding-space-fixed-space", "record_revision": 1}, "id": "math-claim-ir:9705052v1:stabilizer-coding-space-fixed-space", "normalization": {"preprocessing_record_ref": "source-preprocessing:stabilizer-codes-and-quantum-error-correction", "profile": "agtxiv.expanded-standard-latex/1.0.0", "relation_to_source": "LOGICAL_FORM_EXPANDED", "unresolved_symbols": []}, "normalized_statement_expanded_latex": "For every $n\\in\\mathbb{N}$ and every Abelian subgroup $S\\leq\\mathcal{G}_n$, the coding space stabilized by $S$ is $T=\\{\\lvert\\psi\\rangle\\in(\\mathbb{C}^2)^{\\otimes n}\\mid M\\lvert\\psi\\rangle=\\lvert\\psi\\rangle\\text{ for every }M\\in S\\}$.", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.math-claimir/1.0.0", "semantic_content_hash": "sha256:2dd49b5c314d0bf1713508280d23becc316d233e8f8e1eb4ff55aaed388bafd2", "source": {"occurrence_work": "arxiv:quant-ph/9705052v1", "proof_anchors": [], "source_statement_expanded_latex": "The stabilizer $S$ is some Abelian subgroup of $\\mathcal{G}$ and the coding space $T$ is the space of vectors fixed by $S$.", "statement_anchors": ["anchor:9705052v1:general-stabilizer-code"]}, "statement_kind": "definition", "structured_statement": {"assumptions": {"explicit": [{"expression_latex": "S\\leq\\mathcal{G}_n\\text{ is Abelian}", "id": "a1", "origin": "SOURCE_EXPLICIT", "source_anchor": "anchor:9705052v1:general-stabilizer-code"}], "source_implicit": []}, "conclusion": {"expression_latex": "T=\\{\\lvert\\psi\\rangle\\in(\\mathbb{C}^2)^{\\otimes n}\\mid\\forall M\\in S,\\ M\\lvert\\psi\\rangle=\\lvert\\psi\\rangle\\}", "relation": "defined_as"}, "conventions": ["\\mathcal{G}_n\\text{ is the }n\\text{-qubit Pauli group with global phases }\\{1,-1,i,-i\\}", "\\lvert\\psi\\rangle\\text{ denotes a vector, not a projective ray}"], "local_binders": [], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": [{"binder": "forall", "domain_latex": "\\mathbb{N}", "origin": "SOURCE_IMPLICIT", "variable_latex": "n"}, {"binder": "forall", "domain_latex": "\\{R\\mid R\\leq\\mathcal{G}_n\\text{ and }R\\text{ is Abelian}\\}", "origin": "SOURCE_EXPLICIT", "variable_latex": "S"}], "typed_objects": [{"scope": "claim", "semantic_type": "natural_number", "symbol_latex": "n"}, {"scope": "global", "semantic_type": "n_qubit_pauli_group", "symbol_latex": "\\mathcal{G}_n"}, {"carrier_latex": "\\mathcal{G}_n", "scope": "claim", "semantic_type": "abelian_subgroup", "symbol_latex": "S"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "claim", "semantic_type": "complex_linear_subspace", "symbol_latex": "T"}]}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:fe638fb28e2ef51d21821cc98a86a75505e7e6f8a3d7611366632b3477ee5b6c", "schema_uri": "https://agtxiv.org/schema/math-claimir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "claim": {"content_hash": "sha256:33f4da7a73898c6cbf5e06c9498bbe1fac86dfe256e7bd9af5fc839007ce7133", "id": "claim:9705052v1:stabilizer-cardinality", "record_revision": 1}, "id": "math-claim-ir:9705052v1:stabilizer-cardinality", "normalization": {"preprocessing_record_ref": "source-preprocessing:stabilizer-codes-and-quantum-error-correction", "profile": "agtxiv.expanded-standard-latex/1.0.0", "relation_to_source": "LOGICAL_FORM_EXPANDED", "unresolved_symbols": []}, "normalized_statement_expanded_latex": "For every $n,k\\in\\mathbb{N}$ with $k\\leq n$, if $S$ is the stabilizer of an $n$-qubit code encoding $k$ qubits, then $\\lvert S\\rvert=2^{n-k}$.", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.math-claimir/1.0.0", "semantic_content_hash": "sha256:cab29594b72e0f11cd6cb53f49680a56a095e0e41b78e7d1aab3711c8d10d077", "source": {"occurrence_work": "arxiv:quant-ph/9705052v1", "proof_anchors": [], "source_statement_expanded_latex": "For a code to encode $k$ qubits in $n$, $S$ has $2^{n-k}$ elements.", "statement_anchors": ["anchor:9705052v1:general-stabilizer-code"]}, "statement_kind": "equation", "structured_statement": {"assumptions": {"explicit": [{"expression_latex": "S\\text{ is the stabilizer of an }n\\text{-qubit code encoding }k\\text{ qubits}", "id": "a1", "origin": "SOURCE_EXPLICIT", "source_anchor": "anchor:9705052v1:general-stabilizer-code"}], "source_implicit": [{"expression_latex": "k\\leq n", "id": "a2", "origin": "SOURCE_IMPLICIT", "source_anchor": "anchor:9705052v1:general-stabilizer-code"}]}, "conclusion": {"expression_latex": "\\lvert S\\rvert=2^{n-k}", "relation": "equal"}, "conventions": ["\\lvert S\\rvert\\text{ denotes finite group cardinality}"], "local_binders": [], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": [{"binder": "forall", "domain_latex": "\\mathbb{N}", "origin": "SOURCE_IMPLICIT", "variable_latex": "n"}, {"binder": "forall", "domain_latex": "\\mathbb{N}", "origin": "SOURCE_EXPLICIT", "variable_latex": "k"}, {"binder": "forall", "domain_latex": "\\{R\\mid R\\text{ is an }n\\text{-qubit stabilizer encoding }k\\text{ qubits}\\}", "origin": "SOURCE_EXPLICIT", "variable_latex": "S"}], "typed_objects": [{"scope": "claim", "semantic_type": "natural_number", "symbol_latex": "n"}, {"scope": "claim", "semantic_type": "natural_number", "symbol_latex": "k"}, {"carrier_latex": "\\mathcal{G}_n", "scope": "claim", "semantic_type": "stabilizer_subgroup", "symbol_latex": "S"}]}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:d9192c28d100265ae4132cddc8a3eab50df076665acfa43f8993071023ddf2e7", "schema_uri": "https://agtxiv.org/schema/math-claimir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "claim": {"content_hash": "sha256:171a0784182c8ff3592ee2d683f1fe27661b86dba370525e0fb0b8a575362531", "id": "claim:9705052v1:stabilizer-fixed-space-dimension", "record_revision": 1}, "id": "math-claim-ir:9705052v1:stabilizer-fixed-space-dimension", "normalization": {"preprocessing_record_ref": "source-preprocessing:stabilizer-codes-and-quantum-error-correction", "profile": "agtxiv.expanded-standard-latex/1.0.0", "relation_to_source": "SOURCE_IMPLICIT_CONTEXT_EXPLICIT", "unresolved_symbols": []}, "normalized_statement_expanded_latex": "For every $n,k\\in\\mathbb{N}$ with $k\\leq n$ and every subgroup $S\\leq\\mathcal{G}_n$, if $S$ is Abelian, $\\lvert S\\rvert=2^{n-k}$, $iI\\notin S$, and $-I\\notin S$, then the complex dimension of $T=\\{\\lvert\\psi\\rangle\\in(\\mathbb{C}^2)^{\\otimes n}\\mid M\\lvert\\psi\\rangle=\\lvert\\psi\\rangle\\text{ for every }M\\in S\\}$ is $2^k$.", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.math-claimir/1.0.0", "semantic_content_hash": "sha256:7bb4a67964fcfbeabd8e19b8b58c416d317e0e686d9aff37e97935567ebc7673", "source": {"occurrence_work": "arxiv:quant-ph/9705052v1", "proof_anchors": [], "source_statement_expanded_latex": "For a code to encode $k$ qubits in $n$, $T$ has $2^k$ dimensions and $S$ has $2^{n-k}$ elements. Provided $S$ is Abelian and neither $i$ nor $-1$ is in $S$, the space $T=\\{\\lvert\\psi\\rangle\\ {\\rm s.t.}\\ M\\lvert\\psi\\rangle=\\lvert\\psi\\rangle\\ \\forall M\\in S\\}$ does have dimension $2^k$.", "statement_anchors": ["anchor:9705052v1:general-stabilizer-code"]}, "statement_kind": "theorem", "structured_statement": {"assumptions": {"explicit": [{"expression_latex": "S\\text{ is Abelian}", "id": "a1", "origin": "SOURCE_EXPLICIT", "source_anchor": "anchor:9705052v1:general-stabilizer-code"}, {"expression_latex": "\\lvert S\\rvert=2^{n-k}", "id": "a2", "origin": "SOURCE_EXPLICIT", "source_anchor": "anchor:9705052v1:general-stabilizer-code"}, {"expression_latex": "iI\\notin S", "id": "a3", "origin": "SOURCE_EXPLICIT", "source_anchor": "anchor:9705052v1:general-stabilizer-code"}, {"expression_latex": "-I\\notin S", "id": "a4", "origin": "SOURCE_EXPLICIT", "source_anchor": "anchor:9705052v1:general-stabilizer-code"}], "source_implicit": [{"expression_latex": "k\\leq n", "id": "a5", "origin": "SOURCE_IMPLICIT", "source_anchor": "anchor:9705052v1:general-stabilizer-code"}]}, "conclusion": {"expression_latex": "\\dim_{\\mathbb{C}}T=2^k", "relation": "equal"}, "conventions": ["\\mathcal{G}_n\\text{ includes scalar phases}", "\\text{the source symbols }i\\text{ and }-1\\text{ denote }iI\\text{ and }-I"], "local_binders": [{"binder": "let", "scope": "conclusion", "value_latex": "\\{\\lvert\\psi\\rangle\\in(\\mathbb{C}^2)^{\\otimes n}\\mid\\forall M\\in S,\\ M\\lvert\\psi\\rangle=\\lvert\\psi\\rangle\\}", "variable_latex": "T"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": [{"binder": "forall", "domain_latex": "\\mathbb{N}", "origin": "SOURCE_IMPLICIT", "variable_latex": "n"}, {"binder": "forall", "domain_latex": "\\mathbb{N}", "origin": "SOURCE_EXPLICIT", "variable_latex": "k"}, {"binder": "forall", "domain_latex": "\\{R\\mid R\\leq\\mathcal{G}_n\\}", "origin": "SOURCE_EXPLICIT", "variable_latex": "S"}], "typed_objects": [{"scope": "claim", "semantic_type": "natural_number", "symbol_latex": "n"}, {"scope": "claim", "semantic_type": "natural_number", "symbol_latex": "k"}, {"scope": "global", "semantic_type": "n_qubit_pauli_group", "symbol_latex": "\\mathcal{G}_n"}, {"carrier_latex": "\\mathcal{G}_n", "scope": "claim", "semantic_type": "subgroup", "symbol_latex": "S"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "local", "semantic_type": "complex_linear_subspace", "symbol_latex": "T"}]}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:5ccd2530be4e704aa7c780edcaeea5947f1e644e080c09211a0681ffc5a1fd60", "schema_uri": "https://agtxiv.org/schema/math-claimir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "claim": {"content_hash": "sha256:19785c806f8364fba4adaca9fa9bc1601c169f0f0c256b8f0a474c72f80e4a8d", "id": "claim:9705052v1:decoding-stabilizer-one-dimensional-fixed-space", "record_revision": 1}, "id": "math-claim-ir:9705052v1:decoding-stabilizer-one-dimensional-fixed-space", "normalization": {"preprocessing_record_ref": "source-preprocessing:stabilizer-codes-and-quantum-error-correction", "profile": "agtxiv.expanded-standard-latex/1.0.0", "relation_to_source": "SOURCE_IMPLICIT_CONTEXT_EXPLICIT", "unresolved_symbols": []}, "normalized_statement_expanded_latex": "In the encoded-zero preparation construction, let $S_0=\\langle M_1,\\ldots,M_{n-k},\\overline{Z}_1,\\ldots,\\overline{Z}_k\\rangle$ act on $(\\mathbb{C}^2)^{\\otimes n}$. Then $\\dim_{\\mathbb{C}}\\{\\lvert\\psi\\rangle\\mid A\\lvert\\psi\\rangle=\\lvert\\psi\\rangle\\text{ for every }A\\in S_0\\}=1$.", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.math-claimir/1.0.0", "semantic_content_hash": "sha256:84426159d3fa32f8b980f22ef3d468c05c433afb34506eae4751b7a0fa00b7a8", "source": {"occurrence_work": "arxiv:quant-ph/9705052v1", "proof_anchors": [], "source_statement_expanded_latex": "The stabilizer generated by $M_1,\\ldots,M_{n-k},\\overline{Z}_1,\\ldots,\\overline{Z}_k$ has $n$ generators, so there is only one joint $+1$ eigenvector, which is the encoded $0$ for the original code.", "statement_anchors": ["anchor:9705052v1:n-generator-unique-state"]}, "statement_kind": "claim", "structured_statement": {"assumptions": {"explicit": [{"expression_latex": "M_1,\\ldots,M_{n-k},\\overline{Z}_1,\\ldots,\\overline{Z}_k\\text{ are the operators in the source decoding construction}", "id": "a1", "origin": "SOURCE_EXPLICIT", "source_anchor": "anchor:9705052v1:n-generator-unique-state"}], "source_implicit": [{"expression_latex": "k\\leq n", "id": "a2", "origin": "SOURCE_IMPLICIT", "source_anchor": "anchor:9705052v1:n-generator-unique-state"}]}, "conclusion": {"expression_latex": "\\dim_{\\mathbb{C}}T_0=1", "relation": "equal"}, "conventions": ["\\text{the source phrase only one joint }+1\\text{ eigenvector is represented as one-dimensionality}", "\\overline{Z}_j\\text{ denotes the encoded Pauli }Z\\text{ operator}"], "local_binders": [{"binder": "let", "scope": "conclusion", "value_latex": "\\langle M_1,\\ldots,M_{n-k},\\overline{Z}_1,\\ldots,\\overline{Z}_k\\rangle", "variable_latex": "S_0"}, {"binder": "let", "scope": "conclusion", "value_latex": "\\{\\lvert\\psi\\rangle\\mid\\forall A\\in S_0,\\ A\\lvert\\psi\\rangle=\\lvert\\psi\\rangle\\}", "variable_latex": "T_0"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": [{"binder": "forall", "domain_latex": "\\mathbb{N}", "origin": "SOURCE_IMPLICIT", "variable_latex": "n"}, {"binder": "forall", "domain_latex": "\\mathbb{N}", "origin": "SOURCE_IMPLICIT", "variable_latex": "k"}], "typed_objects": [{"scope": "claim", "semantic_type": "natural_number", "symbol_latex": "n"}, {"scope": "claim", "semantic_type": "natural_number", "symbol_latex": "k"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "claim", "semantic_type": "original_code_stabilizer_generators", "symbol_latex": "M_1,\\ldots,M_{n-k}"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "claim", "semantic_type": "encoded_Z_operators", "symbol_latex": "\\overline{Z}_1,\\ldots,\\overline{Z}_k"}, {"carrier_latex": "\\mathcal{G}_n", "scope": "local", "semantic_type": "stabilizer_subgroup", "symbol_latex": "S_0"}]}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:37fd9d3bc8a8305b5c4ba5ce0289b1e488c2c32e479c35c6f6e90ef2c49f8e8b", "schema_uri": "https://agtxiv.org/schema/math-claimir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "claim": {"content_hash": "sha256:e3f37649b37f93387c5bf58fc801311a31626815c41ea8d644b55af3060f76bc", "id": "claim:9705052v1:unnormalized-group-sum-lands-in-coding-space", "record_revision": 1}, "id": "math-claim-ir:9705052v1:unnormalized-group-sum-lands-in-coding-space", "normalization": {"preprocessing_record_ref": "source-preprocessing:stabilizer-codes-and-quantum-error-correction", "profile": "agtxiv.expanded-standard-latex/1.0.0", "relation_to_source": "LOGICAL_FORM_EXPANDED", "unresolved_symbols": []}, "normalized_statement_expanded_latex": "For every finite stabilizer subgroup $S\\leq\\mathcal{G}_n$ and every $\\lvert\\psi\\rangle\\in(\\mathbb{C}^2)^{\\otimes n}$, define $A_S=\\sum_{M\\in S}M$. Then $NA_S\\lvert\\psi\\rangle=A_S\\lvert\\psi\\rangle$ for every $N\\in S$, and therefore $A_S\\lvert\\psi\\rangle\\in T=\\{v\\mid Nv=v\\text{ for every }N\\in S\\}$.", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.math-claimir/1.0.0", "semantic_content_hash": "sha256:7242757e0fde646b8cbb4915c290d3834eaac33300e44672218932fbe4506b0a", "source": {"occurrence_work": "arxiv:quant-ph/9705052v1", "proof_anchors": [], "source_statement_expanded_latex": "For every $N\\in S$, $N(\\sum_{M\\in S}M)\\lvert\\psi\\rangle=(\\sum_{M\\in S}NM)\\lvert\\psi\\rangle=(\\sum_{M^{\\prime}\\in S}M^{\\prime})\\lvert\\psi\\rangle$, so $\\sum_{M\\in S}M\\lvert\\psi\\rangle$ is in the coding space $T$ for any state $\\lvert\\psi\\rangle$.", "statement_anchors": ["anchor:9705052v1:encoding-group-sum-fixedness"]}, "statement_kind": "lemma", "structured_statement": {"assumptions": {"explicit": [], "source_implicit": [{"expression_latex": "S\\leq\\mathcal{G}_n\\text{ is finite and closed under multiplication}", "id": "a1", "origin": "SOURCE_IMPLICIT", "source_anchor": "anchor:9705052v1:encoding-group-sum-fixedness"}]}, "conclusion": {"expression_latex": "A_S\\lvert\\psi\\rangle\\in T", "relation": "membership"}, "conventions": ["\\sum_{M\\in S}M\\text{ is unnormalized}", "\\text{left multiplication by }N\\in S\\text{ permutes }S"], "local_binders": [{"binder": "let", "scope": "conclusion", "value_latex": "\\sum_{M\\in S}M", "variable_latex": "A_S"}, {"binder": "let", "scope": "conclusion", "value_latex": "\\{v\\in(\\mathbb{C}^2)^{\\otimes n}\\mid\\forall N\\in S,\\ Nv=v\\}", "variable_latex": "T"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": [{"binder": "forall", "domain_latex": "\\mathbb{N}", "origin": "SOURCE_IMPLICIT", "variable_latex": "n"}, {"binder": "forall", "domain_latex": "\\{R\\mid R\\leq\\mathcal{G}_n\\text{ is a finite stabilizer subgroup}\\}", "origin": "SOURCE_IMPLICIT", "variable_latex": "S"}, {"binder": "forall", "domain_latex": "(\\mathbb{C}^2)^{\\otimes n}", "origin": "SOURCE_EXPLICIT", "variable_latex": "\\lvert\\psi\\rangle"}], "typed_objects": [{"scope": "claim", "semantic_type": "natural_number", "symbol_latex": "n"}, {"carrier_latex": "\\mathcal{G}_n", "scope": "claim", "semantic_type": "finite_stabilizer_subgroup", "symbol_latex": "S"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "claim", "semantic_type": "state_vector", "symbol_latex": "\\lvert\\psi\\rangle"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "local", "semantic_type": "linear_operator", "symbol_latex": "A_S"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "local", "semantic_type": "complex_linear_subspace", "symbol_latex": "T"}]}, "supersedes": null}
