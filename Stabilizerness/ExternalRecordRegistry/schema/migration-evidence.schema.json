{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/migration-evidence/1.0.0",
  "title": "External evidence reclassified during ClaimIR migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "record_revision", "produced_at", "legacy_record_id", "evidence_kind", "statement", "source_anchors", "provenance", "content_hash"],
  "properties": {
    "schema": {"const": "agtxiv.migration-evidence/1.0.0"},
    "id": {"type": "string", "pattern": "^evidence:"},
    "record_revision": {"const": 1},
    "produced_at": {"type": "string"},
    "legacy_record_id": {"type": "string"},
    "evidence_kind": {"enum": ["NUMERICAL_CHECK", "COUNTEREXAMPLE", "FORMALIZATION_OBSERVATION", "SOURCE_AUDIT", "ALIGNMENT_OBSERVATION"]},
    "statement": {"type": "string"},
    "source_anchors": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
