AL", "mapped_targets": [], "residual_physical_semantics": "No finite-shot confidence statement, noise robustness guarantee, or experimental acceptance threshold is established; their applicability remains unresolved.", "source_anchors": ["anchor:2602.18939v1:fixed-window-monotonicity-claim", "anchor:2602.18939v1:fixed-window-monotonicity-proof"]}, {"component_id": "component:measurement-window-covariance", "description": "A statement that transforms the measurement window covariantly with the operation is distinct from the literal fixed-window assertion.", "disposition": "RESIDUAL", "mapped_targets": [], "residual_physical_semantics": "Monotonicity for a covariantly transformed measurement window is not established or refuted by this fixed-window alignment; its applicability remains unresolved.", "source_anchors": ["anchor:2602.18939v1:fixed-window-monotonicity-claim", "anchor:2602.18939v1:fixed-window-monotonicity-proof"]}]}
