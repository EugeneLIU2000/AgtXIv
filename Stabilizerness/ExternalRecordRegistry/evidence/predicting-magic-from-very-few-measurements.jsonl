{"content_hash": "sha256:4e2eeb192391119654bc52728cde43ab8a83d097f61e575b4b5f680d3e45d206", "evidence_kind": "COUNTEREXAMPLE", "id": "evidence:2602.18939v1:fixed-window-monotonicity-counterexample", "legacy_record_id": "statement:2602.18939v1:fixed-window-monotonicity-claimed", "produced_at": "2026-08-22T00:00:00Z", "provenance": {"checked_values": {"final": "sqrt(2)", "initial": "1", "operation": "R_X(pi/2) Clifford"}, "claimir_truth_status_mutation": false, "proposition_ref": "math-proposition-ir:2602.18939v1:fixed-window-counterexample@1", "review_path": "agents/predicting-magic-from-very-few-measurements/reviews/reduced-rom-monotonicity-counterexample.md", "verification_record": "verification:2602.18939v1:fixed-window-monotonicity-audit"}, "record_revision": 1, "schema": "agtxiv.migration-evidence/1.0.0", "source_anchors": ["anchor:2602.18939v1:fixed-window-monotonicity-claim", "anchor:2602.18939v1:fixed-window-monotonicity-proof"], "statement": "An exact one-qubit calculation with the fixed window {X,Z} gives reduced RoM 1 before and sqrt(2) after the free Clifford rotation exp(-i pi X/4); therefore the source's fixed-window monotonicity assertion is false."}
{"content_hash": "sha256:162a1861bb5a8f9dacf45d9a2d22fb2353aa7a3d5eefa10774d7859c4d303909", "evidence_kind": "SOURCE_AUDIT", "id": "evidence:2602.18939v1:vrep-published-proof-gap", "legacy_record_id": "statement:2602.18939v1:reduced-polytope-vrep", "produced_at": "2026-08-22T00:00:00Z", "provenance": {"claimir_truth_status_mutation": false, "counterexample": "For n=2, M={Z_1,X_2}, and |00>, the measured stabilizer support {Z_1} is not maximal; projection (1,0) is the midpoint of (1,1) and (1,-1).", "review_path": "agents/predicting-magic-from-very-few-measurements/reviews/vrep-proof-gap.md", "verification_record": "verification:2602.18939v1:vrep-proof-audit"}, "record_revision": 1, "schema": "agtxiv.migration-evidence/1.0.0", "source_anchors": ["anchor:2602.18939v1:vrep-theorem", "anchor:2602.18939v1:vrep-proof"], "statement": "The published proof does not establish the asserted V-representation: at lines 716-720 it incorrectly infers that a full-rank stabilizer group's signed intersection with the measurement window is maximal, and lines 728-732 do not repair the extremality argument."}
