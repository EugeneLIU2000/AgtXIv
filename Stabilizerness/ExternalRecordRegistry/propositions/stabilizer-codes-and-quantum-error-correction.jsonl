{"artifact": {"artifact_hash": "sha256:e8b84bce8cf1a903718ad9056806b66d71fa031a821d9e778eb4d12b1e823e27", "schema_uri": "https://agtxiv.org/schema/mathematical-proposition-ir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "derivation_provenance": {"canonical_source_anchors_consulted": ["anchor:9705052v1:encoding-group-sum-fixedness"], "notes": "The thesis proves fixedness of an unnormalized stabilizer sum, not normalized idempotence for arbitrary finite-group representations.", "reconstructed_from_legacy_records": ["assumption:9705052v1:finite-group-representation-core", "statement:9705052v1:group-average-projector"], "source_relation": "FORMAL_RECONSTRUCTION_NOT_EXPLICITLY_STATED_IN_SOURCE"}, "id": "math-proposition-ir:9705052v1:finite-group-average-idempotent", "normalized_statement_expanded_latex": "For every finite group $G$, complex vector space $V$, and representation $\\rho:G\\to\\operatorname{GL}_{\\mathbb{C}}(V)$, if $\\lvert G\\rvert$ is invertible and $A=\\lvert G\\rvert^{-1}\\sum_{g\\in G}\\rho(g)$, then $A\\circ A=A$.", "origin": "SOURCE_INDEPENDENT_PROPOSITION", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.mathematical-proposition-ir/1.0.0", "semantic_content_hash": "sha256:a1a63e19f23c8e2a69d038ef4a8dc4e60e6046e9ca6b66a24e9b4180c22c2d36", "structured_statement": {"assumptions": ["G is finite", "V is a complex vector space", "\\rho:G\\to\\operatorname{GL}_{\\mathbb{C}}(V) is a representation", "\\lvert G\\rvert\\cdot1_{\\mathbb{C}} is invertible"], "conclusion": {"expression_latex": "A\\circ A=A", "relation": "equal"}, "conventions": ["All sums are finite."], "local_binders": [{"binder": "let", "value_latex": "\\lvert G\\rvert^{-1}\\sum_{g\\in G}\\rho(g)", "variable_latex": "A"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": ["\\forall G", "\\forall V", "\\forall\\rho"], "typed_objects": {"A": "complex_linear_map", "G": "finite_group", "V": "complex_vector_space", "\\rho": "complex_linear_representation"}}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:b7bf467305df94a3433d60a29329c0b75981f9fa777a4c9f19e1cdfdade2e3eb", "schema_uri": "https://agtxiv.org/schema/mathematical-proposition-ir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "derivation_provenance": {"canonical_source_anchors_consulted": ["anchor:9705052v1:encoding-group-sum-fixedness"], "notes": "The forward range inclusion follows the source reindexing step; the reverse inclusion and arbitrary-representation generality are reconstructed.", "reconstructed_from_legacy_records": ["assumption:9705052v1:finite-group-representation-core", "statement:9705052v1:group-average-projector"], "source_relation": "FORMAL_RECONSTRUCTION_GENERALIZES_SOURCE_STEP"}, "id": "math-proposition-ir:9705052v1:finite-group-average-range-fixed-space", "normalized_statement_expanded_latex": "Under the finite-group representation assumptions, the range of $A=\\lvert G\\rvert^{-1}\\sum_{g\\in G}\\rho(g)$ is exactly $V^G=\\{v\\in V\\mid\\rho(g)v=v\\text{ for every }g\\in G\\}$.", "origin": "SOURCE_INDEPENDENT_PROPOSITION", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.mathematical-proposition-ir/1.0.0", "semantic_content_hash": "sha256:de82be7cfb63909a3d75f233c87114f65f98924c7fb3ce0c872c923a827d2ad2", "structured_statement": {"assumptions": ["G is finite", "V is a complex vector space", "\\rho:G\\to\\operatorname{GL}_{\\mathbb{C}}(V) is a representation", "\\lvert G\\rvert\\cdot1_{\\mathbb{C}} is invertible"], "conclusion": {"expression_latex": "\\operatorname{range}(A)=V^G", "relation": "equal"}, "conventions": ["All sums are finite."], "local_binders": [{"binder": "let", "value_latex": "\\lvert G\\rvert^{-1}\\sum_{g\\in G}\\rho(g)", "variable_latex": "A"}, {"binder": "let", "value_latex": "\\{v\\in V\\mid\\forall g\\in G,\\rho(g)v=v\\}", "variable_latex": "V^G"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": ["\\forall G", "\\forall V", "\\forall\\rho"], "typed_objects": {"A": "complex_linear_map", "G": "finite_group", "V": "complex_vector_space", "V^G": "complex_linear_subspace", "\\rho": "complex_linear_representation"}}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:1a5c81cd7ff09abd6450d4f2eaac8a4daae7a5e2b3cb98b5f31515d08e8a2a13", "schema_uri": "https://agtxiv.org/schema/mathematical-proposition-ir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "derivation_provenance": {"canonical_source_anchors_consulted": ["anchor:9705052v1:pauli-group", "anchor:9705052v1:general-stabilizer-code"], "notes": "Cardinality is derived from subset-product injectivity rather than postulated.", "reconstructed_from_legacy_records": ["assumption:9705052v1:rank-n-phase-normalized-stabilizer"], "source_relation": "MODERN_PHASE_NORMALIZED_SPECIALIZATION_NOT_STATED_AT_ANCHOR"}, "id": "math-proposition-ir:9705052v1:rank-n-phase-normalized-stabilizer-cardinality", "normalized_statement_expanded_latex": "Let $P_1,\\ldots,P_n$ be mutually commuting Hermitian involutive $n$-qubit Pauli operators whose subset-product map is injective, and let $S=\\langle P_1,\\ldots,P_n\\rangle$. Then $\\lvert S\\rvert=2^n$.", "origin": "SOURCE_INDEPENDENT_PROPOSITION", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.mathematical-proposition-ir/1.0.0", "semantic_content_hash": "sha256:47bd20bb159467d2702ff430b33d3e5f8237e007c8b27e1b39a0a29643d9e19a", "structured_statement": {"assumptions": ["P_j^\\dagger=P_j", "P_j^2=I", "P_jP_\\ell=P_\\ell P_j", "A\\mapsto\\prod_{j\\in A}P_j is injective on subsets", "-I\\notin S"], "conclusion": {"expression_latex": "\\lvert S\\rvert=2^n", "relation": "equal"}, "conventions": ["Independence means injectivity of the binary subset-product map."], "local_binders": [{"binder": "let", "value_latex": "\\langle P_1,\\ldots,P_n\\rangle", "variable_latex": "S"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": ["\\forall n\\in\\mathbb{N}", "\\forall(P_1,\\ldots,P_n)\\in\\mathcal{G}_n^n"], "typed_objects": {"P_1,\\ldots,P_n": "n_qubit_pauli_operators", "S": "generated_subgroup", "n": "natural_number"}}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:f37973f22d0669de1810dbbf906c639f12ac3896e8261e3459855d6175a43a14", "schema_uri": "https://agtxiv.org/schema/mathematical-proposition-ir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "derivation_provenance": {"canonical_source_anchors_consulted": ["anchor:9705052v1:general-stabilizer-code", "anchor:9705052v1:n-generator-unique-state"], "notes": "The thesis states one-dimensionality for its specific encoded-zero stabilizer, not this standalone modern generator package.", "reconstructed_from_legacy_records": ["assumption:9705052v1:rank-n-phase-normalized-stabilizer", "statement:9705052v1:pure-stabilizer-state"], "source_relation": "DERIVED_MODERN_SPECIALIZATION_OF_SOURCE_DIMENSION_PATTERN"}, "id": "math-proposition-ir:9705052v1:rank-n-phase-normalized-fixed-space-dimension", "normalized_statement_expanded_latex": "Under the phase-normalized rank-$n$ Pauli-generator assumptions, $\\operatorname{Fix}_{+}(S)=\\{v\\in(\\mathbb{C}^2)^{\\otimes n}\\mid Pv=v\\text{ for every }P\\in S\\}$ has complex dimension one.", "origin": "SOURCE_INDEPENDENT_PROPOSITION", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.mathematical-proposition-ir/1.0.0", "semantic_content_hash": "sha256:49f68ec7144c7908fd22efb2213252239f3787634b14896f785abb0a8c6ceefc", "structured_statement": {"assumptions": ["P_j^\\dagger=P_j", "P_j^2=I", "P_jP_\\ell=P_\\ell P_j", "the subset-product map is injective", "-I\\notin S"], "conclusion": {"expression_latex": "\\dim_{\\mathbb{C}}\\operatorname{Fix}_{+}(S)=1", "relation": "equal"}, "conventions": ["The fixed space is a vector subspace, not a projective state space."], "local_binders": [{"binder": "let", "value_latex": "\\langle P_1,\\ldots,P_n\\rangle", "variable_latex": "S"}, {"binder": "let", "value_latex": "\\{v\\mid\\forall P\\in S, Pv=v\\}", "variable_latex": "\\operatorname{Fix}_{+}(S)"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": ["\\forall n\\in\\mathbb{N}", "\\forall(P_1,\\ldots,P_n)\\in\\mathcal{G}_n^n"], "typed_objects": {"P_1,\\ldots,P_n": "n_qubit_pauli_operators", "S": "generated_subgroup", "\\operatorname{Fix}_{+}(S)": "complex_linear_subspace", "n": "natural_number"}}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:55805aa06d3033b18b82423c4c583225bf5e2d683367fc2c940f73134e4fc2f5", "schema_uri": "https://agtxiv.org/schema/mathematical-proposition-ir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "derivation_provenance": {"canonical_source_anchors_consulted": ["anchor:9705052v1:n-generator-unique-state"], "notes": "Global-phase uniqueness is reconstructed from one-dimensionality and is not stated at the source occurrence.", "reconstructed_from_legacy_records": ["statement:9705052v1:pure-stabilizer-state"], "source_relation": "MATHEMATICAL_CONSEQUENCE_NOT_EXPLICITLY_STATED_IN_SOURCE"}, "id": "math-proposition-ir:9705052v1:rank-n-normalized-fixed-vectors-global-phase", "normalized_statement_expanded_latex": "Let $P_1,\\ldots,P_n$ be commuting Hermitian involutive $n$-qubit Pauli operators with injective subset-product map, let $S=\\langle P_1,\\ldots,P_n\\rangle$, assume $-I\\notin S$, and suppose $\\dim_{\\mathbb{C}}\\operatorname{Fix}_{+}(S)=1$. If $\\psi,\\phi\\in\\operatorname{Fix}_{+}(S)$ are unit vectors, then there exists $\\lambda\\in\\mathbb{C}$ with $\\lvert\\lambda\\rvert=1$ and $\\phi=\\lambda\\psi$.", "origin": "SOURCE_INDEPENDENT_PROPOSITION", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.mathematical-proposition-ir/1.0.0", "semantic_content_hash": "sha256:b1a75856ff91f5b4e45998e901ea97bb23663875e8d37edd9251bee427d7b2cc", "structured_statement": {"assumptions": ["P_j^\\dagger=P_j for every j", "P_j^2=I for every j", "P_jP_\\ell=P_\\ell P_j for all j and \\ell", "the subset-product map A\\mapsto\\prod_{j\\in A}P_j is injective", "S=\\langle P_1,\\ldots,P_n\\rangle", "-I\\notin S", "\\dim_{\\mathbb{C}}\\operatorname{Fix}_{+}(S)=1", "\\lVert\\psi\\rVert=\\lVert\\phi\\rVert=1"], "conclusion": {"expression_latex": "\\exists\\lambda\\in\\mathbb{C},\\lvert\\lambda\\rvert=1\\wedge\\phi=\\lambda\\psi", "relation": "exists_unit_phase_relating_vectors"}, "conventions": ["The norm is the Hilbert-space norm."], "local_binders": [{"binder": "let", "value_latex": "\\langle P_1,\\ldots,P_n\\rangle", "variable_latex": "S"}, {"binder": "let", "value_latex": "\\{v\\in(\\mathbb{C}^2)^{\\otimes n}\\mid\\forall P\\in S, Pv=v\\}", "variable_latex": "\\operatorname{Fix}_{+}(S)"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": ["\\forall n\\in\\mathbb{N}", "\\forall(P_1,\\ldots,P_n)\\in\\mathcal{G}_n^n", "\\forall\\psi,\\phi\\in\\operatorname{Fix}_{+}(S)"], "typed_objects": {"P_1,\\ldots,P_n": "n_qubit_pauli_operators", "S": "generated_subgroup", "\\lambda": "complex_number", "\\operatorname{Fix}_{+}(S)": "complex_linear_subspace", "\\phi": "unit_fixed_vector", "\\psi": "unit_fixed_vector", "n": "natural_number"}}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:699160c7fee15f432a9480e8d804258c1980e43fbe18c548fdfec328a4980f5a", "schema_uri": "https://agtxiv.org/schema/mathematical-proposition-ir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "derivation_provenance": {"canonical_source_anchors_consulted": ["anchor:9705052v1:general-stabilizer-code", "anchor:9705052v1:n-generator-unique-state"], "notes": "The source occurrence does not introduce rank-one projectors or pure-stabilizer-state density-matrix terminology.", "reconstructed_from_legacy_records": ["statement:9705052v1:pure-stabilizer-state"], "source_relation": "MODERN_DENSITY_OPERATOR_INTERPRETATION_NOT_EXPLICITLY_STATED_IN_SOURCE"}, "id": "math-proposition-ir:9705052v1:rank-n-fixed-vector-pure-density-operator", "normalized_statement_expanded_latex": "Let $P_1,\\ldots,P_n$ be commuting Hermitian involutive $n$-qubit Pauli operators with injective subset-product map, let $S=\\langle P_1,\\ldots,P_n\\rangle$, assume $-I\\notin S$, and suppose $\\dim_{\\mathbb{C}}\\operatorname{Fix}_{+}(S)=1$. If $\\psi\\in\\operatorname{Fix}_{+}(S)$ is a unit vector and $P_{\\psi}=\\lvert\\psi\\rangle\\langle\\psi\\rvert$, then $P_{\\psi}$ is a pure $n$-qubit stabilizer-state density operator.", "origin": "SOURCE_INDEPENDENT_PROPOSITION", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.mathematical-proposition-ir/1.0.0", "semantic_content_hash": "sha256:dee216feec629ffd1195405183983ae971108d3c90aa73e7e8af6c78caa80c87", "structured_statement": {"assumptions": ["P_j^\\dagger=P_j for every j", "P_j^2=I for every j", "P_jP_\\ell=P_\\ell P_j for all j and \\ell", "the subset-product map A\\mapsto\\prod_{j\\in A}P_j is injective", "S=\\langle P_1,\\ldots,P_n\\rangle", "-I\\notin S", "\\dim_{\\mathbb{C}}\\operatorname{Fix}_{+}(S)=1", "\\lVert\\psi\\rVert=1"], "conclusion": {"expression_latex": "P_{\\psi}\\text{ is positive semidefinite, trace one, and rank one}", "relation": "has_property"}, "conventions": ["A pure density operator is positive semidefinite, trace one, and rank one.", "The projector is invariant under global phase."], "local_binders": [{"binder": "let", "value_latex": "\\langle P_1,\\ldots,P_n\\rangle", "variable_latex": "S"}, {"binder": "let", "value_latex": "\\{v\\in(\\mathbb{C}^2)^{\\otimes n}\\mid\\forall P\\in S, Pv=v\\}", "variable_latex": "\\operatorname{Fix}_{+}(S)"}, {"binder": "let", "value_latex": "\\lvert\\psi\\rangle\\langle\\psi\\rvert", "variable_latex": "P_{\\psi}"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": ["\\forall n\\in\\mathbb{N}", "\\forall(P_1,\\ldots,P_n)\\in\\mathcal{G}_n^n", "\\forall\\psi\\in\\operatorname{Fix}_{+}(S)"], "typed_objects": {"P_1,\\ldots,P_n": "n_qubit_pauli_operators", "P_{\\psi}": "density_operator", "S": "generated_subgroup", "\\operatorname{Fix}_{+}(S)": "complex_linear_subspace", "\\psi": "unit_fixed_vector", "n": "natural_number"}}, "supersedes": null}
