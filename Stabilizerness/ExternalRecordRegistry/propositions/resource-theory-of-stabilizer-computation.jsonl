{"artifact": {"artifact_hash": "sha256:a5bdf8ae82c824665a4a1a75a63af9c06382308fd73980f2a6a7c53e5f2358a2", "schema_uri": "https://agtxiv.org/schema/mathematical-proposition-ir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "derivation_provenance": {"convention_alignment": "matched qubit Pauli phases, exclusion of nontrivial scalar phases, and equality of pure states up to global phase are required", "derivation_kind": "EXACT_CROSS_SOURCE_DEFINITION_BRIDGE", "input_records": ["statement:9705052v1:pure-stabilizer-state", "statement:1307.7171v1:pure-stabilizer-clifford-orbit"], "later_verification_state_imported": false, "legacy_record_id": "statement:1307.7171v1:fixed-space-clifford-orbit-equivalence", "source_anchors": ["anchor:9705052v1:general-stabilizer-code", "anchor:1307.7171v1:stabilizer-free-set"]}, "id": "math-proposition-ir:1307.7171v1:fixed-space-clifford-orbit-equivalence", "normalized_statement_expanded_latex": "For every integer $n\\geq1$, under matched $n$-qubit Pauli-phase conventions, a pure-state ray $[\\psi]$ is the unique common $+1$ eigenspace of a rank-$n$ phase-normalized stabilizer group if and only if $[\\psi]=[U\\left|0^n\\right\\rangle]$ for some $n$-qubit Clifford unitary $U$.", "origin": "DERIVED_CLAIM", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.mathematical-proposition-ir/1.0.0", "semantic_content_hash": "sha256:a05ecc1eb740c94c89496540ea19209ca08b393f2219a00846516c7899667385", "structured_statement": {"assumptions": {"explicit": [{"expression_latex": "\\text{The two sources use matched Pauli-phase conventions.}", "id": "matched-pauli-phases", "origin": "IMPORTED"}], "source_implicit": []}, "conclusion": {"expression_latex": "\\operatorname{Fix}_{+}(S)=\\operatorname{span}\\{\\psi\\}\\Longleftrightarrow\\exists U\\in\\mathcal{C}_{2,n},\\ [\\psi]=[U\\left|0^n\\right\\rangle]", "relation": "if_and_only_if"}, "conventions": ["Pure states are compared as rays, so global phase is immaterial."], "local_binders": [{"binder": "exists", "domain_latex": "\\mathcal{C}_{2,n}", "scope": "right_hand_side", "variable_latex": "U"}], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": [{"binder": "forall", "domain_latex": "\\mathbb{N}_{\\geq1}", "origin": "SOURCE_IMPLICIT", "variable_latex": "n"}, {"binder": "forall", "domain_latex": "\\{\\text{rank-}n\\text{ phase-normalized stabilizer groups on }n\\text{ qubits}\\}", "origin": "SOURCE_IMPLICIT", "variable_latex": "S"}, {"binder": "forall", "domain_latex": "\\mathbb{P}((\\mathbb{C}^2)^{\\otimes n})", "origin": "SOURCE_IMPLICIT", "variable_latex": "[\\psi]"}], "typed_objects": [{"scope": "claim", "semantic_type": "positive_integer", "symbol_latex": "n"}, {"scope": "claim", "semantic_type": "rank_n_phase_normalized_stabilizer_group", "symbol_latex": "S"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "claim", "semantic_type": "pure_state_ray", "symbol_latex": "[\\psi]"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "claim", "semantic_type": "n_qubit_clifford_unitary", "symbol_latex": "U"}]}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:3bec672147757a7a6e3f9a41a4e0a33f9b657ec838476ccea9fa3c1d11bf93b2", "schema_uri": "https://agtxiv.org/schema/mathematical-proposition-ir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "derivation_provenance": {"derivation_kind": "QUBIT_SPECIALIZATION_AND_DEFINITION_ALIGNMENT", "input_records": ["statement:1307.7171v1:fixed-space-clifford-orbit-equivalence", "statement:1307.7171v1:stabilizer-convex-hull"], "later_verification_state_imported": false, "legacy_record_id": "statement:1307.7171v1:n-qubit-stabilizer-polytope", "source_anchors": ["anchor:1307.7171v1:resource-split", "anchor:1307.7171v1:stabilizer-free-set"]}, "id": "math-proposition-ir:1307.7171v1:n-qubit-fixed-space-stabilizer-polytope", "normalized_statement_expanded_latex": "For every integer $n\\geq1$ under the matched conventions of the fixed-space/Clifford-orbit bridge, the $n$-qubit stabilizer polytope is the convex hull of the rank-one projectors onto the unique common $+1$ eigenstates of rank-$n$ phase-normalized stabilizer groups; equivalently, it is the convex hull of $U\\left|0^n\\right\\rangle\\!\\left\\langle0^n\\right|U^{\\dagger}$ over $n$-qubit Clifford unitaries $U$.", "origin": "DERIVED_CLAIM", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.mathematical-proposition-ir/1.0.0", "semantic_content_hash": "sha256:166498d3b6670dc76480d3860f1e44871ea84b0c74d2bf4d23f39e71cd1cda91", "structured_statement": {"assumptions": {"explicit": [{"expression_latex": "\\text{The fixed-space and Clifford-orbit pure-state definitions are aligned under matched conventions.}", "id": "bridge-hypothesis", "origin": "IMPORTED"}], "source_implicit": []}, "conclusion": {"expression_latex": "\\operatorname{STAB}_n=\\operatorname{conv}\\{\\left|\\psi_S\\right\\rangle\\!\\left\\langle\\psi_S\\right|: \\operatorname{Fix}_{+}(S)=\\operatorname{span}\\{\\psi_S\\}\\}=\\operatorname{conv}\\{U\\left|0^n\\right\\rangle\\!\\left\\langle0^n\\right|U^{\\dagger}:U\\in\\mathcal{C}_{2,n}\\}", "relation": "equality"}, "conventions": ["The convex hull uses ordinary finite probability mixtures."], "local_binders": [], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": [{"binder": "forall", "domain_latex": "\\mathbb{N}_{\\geq1}", "origin": "SOURCE_IMPLICIT", "variable_latex": "n"}], "typed_objects": [{"scope": "claim", "semantic_type": "positive_integer", "symbol_latex": "n"}, {"scope": "claim", "semantic_type": "convex_set_of_n_qubit_density_operators", "symbol_latex": "\\operatorname{STAB}_n"}, {"scope": "claim", "semantic_type": "rank_n_phase_normalized_stabilizer_group", "symbol_latex": "S"}, {"scope": "claim", "semantic_type": "n_qubit_clifford_unitary", "symbol_latex": "U"}]}, "supersedes": null}
{"artifact": {"artifact_hash": "sha256:499aaff2fe1323f02efb02ecae17695fa5d0e0fa5a5a4717ce1cab78d1977214", "schema_uri": "https://agtxiv.org/schema/mathematical-proposition-ir/1.0.0", "schema_version": "1.0.0", "serialization_profile": {"content_hash": "sha256:5d1274af89953b515bfc41caf2813dad2334b9de2176e942366aa650127a434c", "id": "agtxiv.canonical-json/1.0.0"}}, "derivation_provenance": {"derivation_kind": "QUBIT_SPECIALIZATION_OF_MAGIC_MEMBERSHIP", "input_records": ["statement:1307.7171v1:magic-membership", "math-proposition-ir:1307.7171v1:n-qubit-fixed-space-stabilizer-polytope"], "later_verification_state_imported": false, "legacy_record_id": "statement:1307.7171v1:n-qubit-stabilizer-polytope", "source_anchors": ["anchor:1307.7171v1:resource-split", "anchor:1307.7171v1:stabilizer-protocol-and-monotone", "anchor:1307.7171v1:stabilizer-free-set"]}, "id": "math-proposition-ir:1307.7171v1:n-qubit-magic-outside-stabilizer-polytope", "normalized_statement_expanded_latex": "For every integer $n\\geq1$ and every $n$-qubit density operator $\\rho$, using the specialized stabilizer polytope $\\operatorname{STAB}_n$, the state $\\rho$ is magic if and only if $\\rho\\notin\\operatorname{STAB}_n$.", "origin": "DERIVED_CLAIM", "produced_at": "2026-08-22T00:00:00Z", "revision": 1, "schema": "agtxiv.mathematical-proposition-ir/1.0.0", "semantic_content_hash": "sha256:28ee741f6e26f2362d3674d97e7764c1c7c41a82c95b06ca8ce67acb9e4034bb", "structured_statement": {"assumptions": {"explicit": [{"expression_latex": "\\operatorname{STAB}_n\\text{ is the }n\\text{-qubit specialization of the source-defined stabilizer-state set.}", "id": "specialized-free-set", "origin": "IMPORTED"}], "source_implicit": []}, "conclusion": {"expression_latex": "\\rho\\text{ is magic}\\Longleftrightarrow\\rho\\notin\\operatorname{STAB}_n", "relation": "if_and_only_if"}, "conventions": [], "local_binders": [], "mathematical_mode": {"exactness": "exact", "finite_or_asymptotic": "finite"}, "quantifiers": [{"binder": "forall", "domain_latex": "\\mathbb{N}_{\\geq1}", "origin": "SOURCE_IMPLICIT", "variable_latex": "n"}, {"binder": "forall", "domain_latex": "\\mathcal{S}((\\mathbb{C}^2)^{\\otimes n})", "origin": "SOURCE_IMPLICIT", "variable_latex": "\\rho"}], "typed_objects": [{"scope": "claim", "semantic_type": "positive_integer", "symbol_latex": "n"}, {"carrier_latex": "(\\mathbb{C}^2)^{\\otimes n}", "scope": "claim", "semantic_type": "n_qubit_density_operator", "symbol_latex": "\\rho"}, {"scope": "claim", "semantic_type": "convex_set_of_n_qubit_density_operators", "symbol_latex": "\\operatorname{STAB}_n"}]}, "supersedes": null}
