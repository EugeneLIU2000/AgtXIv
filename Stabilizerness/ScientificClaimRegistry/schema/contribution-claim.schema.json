{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/contribution-claim/1.1.0",
  "title": "AgtXIv ContributionClaim profile of ScientificClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "record_revision", "supersedes", "produced_at", "paper_id", "role", "granularity", "contribution_kind", "contribution_tags", "source_characterization", "normalized_statement", "scope_hints", "facets", "occurrences", "semantic_content_hash", "artifact", "content_hash"],
  "properties": {
    "schema": {"const": "agtxiv.contribution-claim/1.1.0"},
    "id": {"type": "string", "pattern": "^claim:contribution:"},
    "record_revision": {"type": "integer", "minimum": 1},
    "supersedes": {"oneOf": [{"$ref": "https://agtxiv.org/schema/target-ref/1.0.0"}, {"type": "null"}]},
    "produced_at": {"type": "string", "format": "date-time"},
    "paper_id": {"type": "string", "pattern": "^arxiv:"},
    "role": {"const": "CONTRIBUTION"},
    "granularity": {"const": "NARRATIVE_ATOMIC"},
    "contribution_kind": {"type": "string", "pattern": "^org\\.agtxiv\\.contribution\\.[a-z0-9_]+$"},
    "contribution_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^org\\.agtxiv\\.contribution_tag\\.[a-z0-9_]+$"}},
    "source_characterization": {"$ref": "#/$defs/sourceCharacterization"},
    "normalized_statement": {"type": "string", "minLength": 1},
    "scope_hints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "facets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/facet"}},
    "occurrences": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/occurrence"}},
    "semantic_content_hash": {"$ref": "#/$defs/hash"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceCharacterization": {
      "type": "object", "additionalProperties": false,
      "required": ["speech_act", "formality", "conditionality"],
      "properties": {
        "speech_act": {"type": "string", "pattern": "^org\\.agtxiv\\.speech_act\\.[a-z0-9_]+$"},
        "formality": {"type": "string", "pattern": "^org\\.agtxiv\\.formality\\.[a-z0-9_]+$"},
        "conditionality": {"type": "string", "pattern": "^org\\.agtxiv\\.conditionality\\.(unconditional|conditional|mixed|not_applicable)$"}
      }
    },
    "facet": {
      "type": "object", "additionalProperties": false,
      "required": ["facet_id", "facet_kind", "statement"],
      "properties": {
        "facet_id": {"type": "string", "pattern": "^facet:[a-z0-9][a-z0-9-]*$"},
        "facet_kind": {"type": "string", "pattern": "^org\\.agtxiv\\.facet\\.[a-z0-9_]+$"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "occurrence_role", "source_zone", "source_characterization", "source_artifact", "line_start", "line_end", "source_text"],
      "properties": {
        "id": {"type": "string", "pattern": "^occurrence:"},
        "occurrence_role": {"enum": ["PRIMARY", "REALIZATION", "BODY_SUPPORT"]},
        "source_zone": {"type": "string", "pattern": "^org\\.agtxiv\\.source_zone\\.[a-z0-9_]+$"},
        "source_characterization": {"$ref": "#/$defs/sourceCharacterization"},
        "source_artifact": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/hash"}
          }
        },
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "source_text": {"type": "string", "minLength": 1}
      }
    },
    "serializationProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "content_hash"],
      "properties": {
        "id": {"const": "agtxiv.record-canonical-json/1.0.0"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_uri", "schema_version", "serialization_profile", "artifact_hash"],
      "properties": {
        "schema_uri": {"const": "https://agtxiv.org/schema/contribution-claim/1.1.0"},
        "schema_version": {"const": "1.1.0"},
        "serialization_profile": {"$ref": "#/$defs/serializationProfile"},
        "artifact_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
