{"content_hash": "sha256:334f5715f501e26c9514c0fc2608b7c60f7b85d66cc0614d7ca4a3d66e13c3a6", "id": "claim:graph-theoretic-nonstabilizerness:measurement-set-domain", "kind": "assumption", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 2, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:measurement-window-domain"], "supersedes": {"id": "claim:graph-theoretic-nonstabilizerness:measurement-set-domain", "revision": 1}, "text": "The measurement window is a finite nonempty ordered set of nonidentity Hermitian n-qubit Pauli observables."}
{"content_hash": "sha256:91164530d2ed6f372466010b249542005b6fe9a08dc555c8ef3304890a9cf5c4", "id": "claim:graph-theoretic-nonstabilizerness:signed-observable-convention", "kind": "convention", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:exact-vrep-report", "anchor:2607.26154v1:clifford-covariance"], "supersedes": null, "text": "Signed Pauli observables are retained in expectation coordinates, while phase-free representatives determine graph commutation data."}
{"content_hash": "sha256:82f8a91c0740597bee9f5ab86894188af99ba856c3c84ca5e6781fa449e1d13e", "id": "claim:graph-theoretic-nonstabilizerness:rho-density", "kind": "assumption", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:closed-form-theorem"], "supersedes": null, "text": "An n-qubit quantum state is a positive semidefinite operator of trace one."}
{"content_hash": "sha256:035b44e80060d003dd1e4711ba114584538856083e66ef2dcef6dc5c1bd92b36", "id": "claim:graph-theoretic-nonstabilizerness:no-active-characterization", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:pauli-active-dependency"], "supersedes": null, "text": "A Pauli measurement set has no active dependencies exactly when every dependency contains an anticommuting pair."}
{"content_hash": "sha256:a64d7c77ba88d7757e6a6ee62df6a97d527308e76e52a99bcbd1f50840bd2e4f", "id": "claim:graph-theoretic-nonstabilizerness:perfect-graph-definition", "kind": "definition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 2, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:perfect-graph-definition"], "supersedes": {"id": "claim:graph-theoretic-nonstabilizerness:perfect-graph-definition", "revision": 1}, "text": "A finite graph is perfect exactly when each induced subgraph has chromatic number equal to clique number."}
{"content_hash": "sha256:560df198b856fa1c2bb98614a9b6de5c0eabf34d7e90ecf95278daa422e2d55f", "id": "claim:graph-theoretic-nonstabilizerness:sign-relaxed-polytope-definition", "kind": "definition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:sign-relaxation"], "supersedes": null, "text": "The sign-relaxed reduced stabilizer polytope is the convex hull of every signed vector on every maximal commuting context."}
{"content_hash": "sha256:cda5200776172454ab0f210c707ae0c664cd9dce7f69723fcc6c55a25d738018", "id": "claim:graph-theoretic-nonstabilizerness:sign-relaxed-outer-inclusion", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:sign-relaxation"], "supersedes": null, "text": "The exact reduced stabilizer polytope is contained in its sign relaxation."}
{"content_hash": "sha256:2caba461cfbd9255b0e04a0c572421d910973128d1d45d3e1673b104bacaed23", "id": "claim:graph-theoretic-nonstabilizerness:sign-set-collapse", "kind": "lemma", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:pauli-active-dependency"], "supersedes": null, "text": "No active dependency is equivalent to every commuting context admitting all deterministic sign assignments."}
{"content_hash": "sha256:cafcf2bc7d53941e169eb55b98ee698c6b5bba835571c527d4be084d768d5cac", "id": "claim:graph-theoretic-nonstabilizerness:relaxation-polytope-exactness", "kind": "theorem", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:pauli-active-dependency"], "supersedes": null, "text": "The exact and sign-relaxed reduced stabilizer polytopes coincide exactly when the measurement set has no active dependencies."}
{"content_hash": "sha256:baca9b0ab856587ef0b4ce16ad7d20477f2a938f87bbb06d4f731bf3432ce76a", "id": "claim:graph-theoretic-nonstabilizerness:relaxation-robustness-exactness", "kind": "theorem", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:pauli-active-dependency"], "supersedes": null, "text": "When the measurement set has no active dependencies, exact and sign-relaxed reduced robustness coincide for every quantum state."}
{"content_hash": "sha256:eb66735a0e427432fe0165a3926ea0dfbc82e7a87f1b64459c42b67e896fd1c4", "id": "claim:graph-theoretic-nonstabilizerness:relaxed-dual-vertex-form", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:relaxation-proofs"], "supersedes": null, "text": "The sign-relaxed reduced robustness equals its finite-dimensional linear-program dual over all maximal contexts and all sign assignments."}
{"content_hash": "sha256:6c0827dce9ae18d79f887c68043d04dc05ddd5eb0001956538bbf90ffce8b935", "id": "claim:graph-theoretic-nonstabilizerness:relaxed-dual-mwis", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:dual-mwis"], "supersedes": null, "text": "The sign-relaxed reduced robustness equals a dual program whose sole graph constraint is a maximum-weight independent-set inequality."}
{"content_hash": "sha256:7991165ec07125421963a4a60bdde5360d64c72fb96cdd504ef2d7395414deaa", "id": "claim:graph-theoretic-nonstabilizerness:mwis-separation", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:dual-mwis"], "supersedes": null, "text": "One maximum-weight independent-set computation tests a candidate point in the sign-relaxed dual and supplies a violated constraint when infeasible."}
{"content_hash": "sha256:7cb1124361d3fa7b88f1bc4f1923213f35b1e80cd3019e48e1a478834ee5992a", "id": "claim:graph-theoretic-nonstabilizerness:exact-graph-dual", "kind": "theorem", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:relaxation-proofs"], "supersedes": null, "text": "Without active dependencies, exact reduced robustness equals the graph-only maximum-weight-independent-set dual."}
{"content_hash": "sha256:c34f770d4af42057651ab4ecc0123148ddfb17f8f7aad1415f358e84bca1d405", "id": "claim:graph-theoretic-nonstabilizerness:perfect-antiblocker", "kind": "lemma", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:perfect-antiblocker-report"], "supersedes": null, "text": "For a finite perfect graph, the nonnegative vectors with weighted independence number at most one are exactly the convex hull of clique incidence vectors, including the empty clique."}
{"content_hash": "sha256:9168a6687534c0387f16decb4e334d18bd2557bd08e9cda18072214e27ac5c40", "id": "claim:graph-theoretic-nonstabilizerness:closed-form-equality", "kind": "theorem", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:closed-form-theorem"], "supersedes": null, "text": "In the solvable regime, reduced robustness is the maximum of one and the largest absolute-expectation sum over a frustration-graph clique."}
{"content_hash": "sha256:172cbaa9ea0a3a5b52fe40083fe54e1fab4f29d4081316678ede0346379f8a66", "id": "claim:graph-theoretic-nonstabilizerness:clique-upper-bound", "kind": "theorem", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:closed-form-theorem"], "supersedes": null, "text": "In the solvable regime, reduced robustness is at most the square root of the frustration graph clique number."}
{"content_hash": "sha256:1d6ca948d63b03e552e8963522b5e301755e3e059f389b7f792dca693f18d2d1", "id": "claim:graph-theoretic-nonstabilizerness:capacity-attainment", "kind": "theorem", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:closed-form-theorem"], "supersedes": null, "text": "Every density operator supported on the positive eigenspace of the normalized sum over a maximum clique attains the clique-number bound."}
{"content_hash": "sha256:7b438e623a358bc3ebcc5407f31746d7965a76b67163ab5585875cd9c5aded29", "id": "claim:graph-theoretic-nonstabilizerness:clifford-covariance", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:clifford-covariance"], "supersedes": null, "text": "Clifford conjugation of the ordered measurement window is covariant with inverse conjugation of the state."}
{"content_hash": "sha256:2b60bef5a0f7dbde1a490eb8a75f11c6c1eca462afe93a2d882fbc7e3c3429b5", "id": "claim:graph-theoretic-nonstabilizerness:clifford-solvability-preservation", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-22T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:clifford-covariance"], "supersedes": null, "text": "Clifford conjugation preserves absence of active dependencies and perfectness of the frustration graph."}
{"content_hash": "sha256:6b2e111f967a9de7c0aeb1c0e934ba0ee65b3277f5146d24480130347fb72227", "id": "claim:graph-theoretic-nonstabilizerness:relaxed-affine-span", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-23T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:relaxation-proofs"], "supersedes": null, "text": "The sign-relaxed context vectors affinely span the full expectation-coordinate space."}
{"content_hash": "sha256:a4173cea401debf6f490d7c9aa069ab31a267af6567536052cdeffd0414f26c5", "id": "claim:graph-theoretic-nonstabilizerness:relaxed-primal-feasibility", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-23T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:relaxation-proofs"], "supersedes": null, "text": "The sign-relaxed primal decomposition is feasible for every expectation vector."}
{"content_hash": "sha256:f65461f6185d062c1fc4d3fc2b3090776a8e58836a585a5df7d651e10bca7d56", "id": "claim:graph-theoretic-nonstabilizerness:relaxed-primal-lower-bound", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-23T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:relaxation-proofs"], "supersedes": null, "text": "Every feasible sign-relaxed affine decomposition has l1 objective at least one."}
{"content_hash": "sha256:3783b6c8ac47cca479f026e93af236ca677b03d21175badf80c02565ed9472f6", "id": "claim:graph-theoretic-nonstabilizerness:solvable-witness-capacity", "kind": "theorem", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-23T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:witness-capacity", "anchor:2607.26154v1:closed-form-theorem"], "supersedes": null, "text": "In the solvable regime, the witness capacity of the measurement window equals the square root of the frustration-graph clique number."}
{"content_hash": "sha256:424a2aa1eaf12faa9b6b43a66fc934f6187d464d43f0093cfda324fa1183398a", "id": "claim:graph-theoretic-nonstabilizerness:clifford-capacity-covariance", "kind": "proposition", "origin": "SOURCE_OCCURRENCE", "paper_id": "arxiv:2607.26154v1", "produced_at": "2026-08-23T00:00:00Z", "record_revision": 1, "schema": "agtxiv.scientific-claim/1.0.0", "source_anchors": ["anchor:2607.26154v1:clifford-covariance", "anchor:2607.26154v1:witness-capacity"], "supersedes": null, "text": "Clifford conjugation preserves the witness capacity of an ordered Pauli measurement window."}
