{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v2/contract-kernel/common/immutable-record-envelope/1.0.0",
  "title": "AgtXIv immutable record envelope",
  "description": "Disjoint base and contract-bound immutable envelope shapes. ContractBundleRelease uses baseEnvelope; runtime records use contractBoundEnvelope.",
  "$defs": {
    "coreEnvelope": {
      "type": "object",
      "required": [
        "record_type",
        "schema_ref",
        "record_id",
        "record_revision",
        "created_at"
      ],
      "properties": {
        "record_type": {
          "type": "string",
          "minLength": 15,
          "maxLength": 256,
          "pattern": "^agtxiv\\.[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)*/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "schema_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v2/contract-kernel/common/exact-asset-ref/1.0.0"
            },
            {
              "type": "object",
              "required": [
                "media_type"
              ],
              "properties": {
                "media_type": {
                  "const": "application/schema+json"
                }
              }
            }
          ]
        },
        "record_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contract_bundle_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v2/contract-kernel/common/exact-record-ref/1.0.0"
            },
            {
              "type": "object",
              "required": [
                "record_type"
              ],
              "properties": {
                "record_type": {
                  "const": "agtxiv.contract-bundle-release/1.0.0"
                }
              }
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
        },
        "producer_context": {
          "$ref": "https://agtxiv.org/schema/v2/contract-kernel/common/producer-context/1.0.0"
        },
        "supersedes_ref": {
          "$ref": "https://agtxiv.org/schema/v2/contract-kernel/common/exact-record-ref/1.0.0"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "record_revision": {
                "const": 1
              }
            },
            "required": [
              "record_revision"
            ]
          },
          "then": {
            "not": {
              "required": [
                "supersedes_ref"
              ]
            }
          },
          "else": {
            "required": [
              "supersedes_ref"
            ]
          }
        }
      ]
    },
    "baseEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/coreEnvelope"
        },
        {
          "not": {
            "required": [
              "contract_bundle_ref"
            ]
          }
        },
        {
          "required": [
            "record_type"
          ],
          "properties": {
            "record_type": {
              "const": "agtxiv.contract-bundle-release/1.0.0"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "contractBoundEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/coreEnvelope"
        },
        {
          "required": [
            "contract_bundle_ref"
          ]
        },
        {
          "not": {
            "required": [
              "record_type"
            ],
            "properties": {
              "record_type": {
                "const": "agtxiv.contract-bundle-release/1.0.0"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/baseEnvelope"
    },
    {
      "$ref": "#/$defs/contractBoundEnvelope"
    }
  ]
}
