{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v2/contract-kernel/common/digest/1.0.0",
  "title": "AgtXIv SHA-256 digest",
  "description": "A lowercase SHA-256 digest with an explicit algorithm prefix.",
  "type": "string",
  "minLength": 71,
  "maxLength": 71,
  "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
}
