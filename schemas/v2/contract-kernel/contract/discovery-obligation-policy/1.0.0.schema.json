{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v2/contract-kernel/contract/discovery-obligation-policy/1.0.0",
  "title": "Discovery obligation policy",
  "$defs": {
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "family_id",
        "stage_id",
        "region_selector",
        "required_component_kinds",
        "minimum_cardinality",
        "applicability_rule"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "family_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "stage_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "region_selector": {
          "enum": [
            "WHOLE_SOURCE_TREE",
            "EVERY_SOURCE_ROW",
            "TEX_DOCUMENT_BODY",
            "TEX_APPENDIX",
            "BIBLIOGRAPHY",
            "OPAQUE_BINARY"
          ]
        },
        "required_component_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "enum": [
              "DOCUMENT_TEXT",
              "APPENDIX_TEXT",
              "BIBLIOGRAPHY_TEXT",
              "FIGURE_BINARY",
              "ARCHIVE_BINARY",
              "UNRESOLVED_SOURCE_REGION"
            ]
          }
        },
        "minimum_cardinality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "applicability_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "operands"
          ],
          "properties": {
            "rule": {
              "enum": [
                "ALWAYS",
                "IF_MATCHING_SOURCE_MEDIA_TYPE",
                "IF_MATCHING_PATH_SUFFIX"
              ]
            },
            "operands": {
              "type": "array",
              "minItems": 0,
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "document_schema_ref",
    "policy_id",
    "policy_version",
    "policy_status",
    "catalog_ref",
    "profile_ref",
    "projection_algorithm",
    "applicability_vocabulary",
    "component_matching_rules",
    "resource_limits",
    "obligations"
  ],
  "properties": {
    "document_type": {
      "const": "AGTXIV_DISCOVERY_OBLIGATION_POLICY"
    },
    "document_schema_ref": {
      "$ref": "https://agtxiv.org/schema/v2/contract-kernel/common/exact-asset-ref/1.0.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "policy_status": {
      "const": "NON_PRODUCTION_CANDIDATE"
    },
    "catalog_ref": {
      "$ref": "https://agtxiv.org/schema/v2/contract-kernel/common/exact-asset-ref/1.0.0"
    },
    "profile_ref": {
      "$ref": "https://agtxiv.org/schema/v2/contract-kernel/common/exact-asset-ref/1.0.0"
    },
    "projection_algorithm": {
      "const": "AGTXIV_DISCOVERY_OBLIGATIONS_V1"
    },
    "applicability_vocabulary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "component_matching_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_discovery_obligations",
        "maximum_discovery_components",
        "maximum_source_files"
      ],
      "properties": {
        "maximum_discovery_obligations": {
          "const": 256
        },
        "maximum_discovery_components": {
          "const": 8192
        },
        "maximum_source_files": {
          "const": 4096
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "family_id",
          "stage_id",
          "region_selector",
          "required_component_kinds",
          "minimum_cardinality",
          "applicability_rule"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          "family_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          "stage_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          "region_selector": {
            "enum": [
              "WHOLE_SOURCE_TREE",
              "EVERY_SOURCE_ROW",
              "TEX_DOCUMENT_BODY",
              "TEX_APPENDIX",
              "BIBLIOGRAPHY",
              "OPAQUE_BINARY"
            ]
          },
          "required_component_kinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "enum": [
                "DOCUMENT_TEXT",
                "APPENDIX_TEXT",
                "BIBLIOGRAPHY_TEXT",
                "FIGURE_BINARY",
                "ARCHIVE_BINARY",
                "UNRESOLVED_SOURCE_REGION"
              ]
            }
          },
          "minimum_cardinality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "applicability_rule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "operands"
            ],
            "properties": {
              "rule": {
                "enum": [
                  "ALWAYS",
                  "IF_MATCHING_SOURCE_MEDIA_TYPE",
                  "IF_MATCHING_PATH_SUFFIX"
                ]
              },
              "operands": {
                "type": "array",
                "minItems": 0,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            }
          }
        }
      }
    }
  }
}
