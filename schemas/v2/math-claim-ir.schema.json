{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v2/math-claim-ir/2.0.0",
  "title": "AgtXIv V2 MathClaimIR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "record_revision", "scope_ref", "source_inventory_entry_id", "components", "content_hash"],
  "properties": {
    "schema": {"const": "agtxiv.math-claim-ir/2.0.0"},
    "id": {"type": "string", "pattern": "^math-claim-ir:"},
    "record_revision": {"type": "integer", "minimum": 1},
    "scope_ref": {"$ref": "#/$defs/exactRef"},
    "source_inventory_entry_id": {"type": "string", "pattern": "^inventory-entry:"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["id", "record_revision", "content_hash"], "properties": {"id": {"type": "string", "minLength": 1}, "record_revision": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/hash"}}},
    "component": {"type": "object", "additionalProperties": false, "required": ["component_id", "component_path", "kind", "normalized_statement"], "properties": {"component_id": {"type": "string", "pattern": "^math-component:"}, "component_path": {"type": "string", "pattern": "^/([^~/]|~[01])+(?:/([^~/]|~[01])*)*$"}, "kind": {"enum": ["DEFINITION", "ASSUMPTION", "CONCLUSION", "DEPENDENCY"]}, "normalized_statement": {"type": "string", "minLength": 1}}}
  }
}
