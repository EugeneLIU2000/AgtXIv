        "rejection_reasons",
        "decision"
      ],
      "properties": {
        "schema": {
          "const": "agtxiv.release-certification-record/2.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^release-certification-record:"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_ref": {
          "$ref": "#/$defs/exactRef"
        },
        "root_agent_audit_ref": {
          "$ref": "#/$defs/exactRef"
        },
        "coordinator": {
          "$ref": "#/$defs/coordinator"
        },
        "root_agent": {
          "$ref": "#/$defs/rootAgent"
        },
        "certifier": {
          "$ref": "#/$defs/certifier"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "decision": {
          "const": "REJECTED"
        },
        "mechanical_checks": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/any0"
            },
            {
              "$ref": "#/$defs/any1"
            },
            {
              "$ref": "#/$defs/any2"
            },
            {
              "$ref": "#/$defs/any3"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "contains": {
            "type": "object",
            "properties": {
              "status": {
                "const": "FAILED"
              }
            },
            "required": [
              "status"
            ]
          },
          "minContains": 1
        },
        "certified_release_hash": {
          "const": null
        },
        "rejection_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "AGENTIZATION_COORDINATOR"
        }
      }
    },
    "rootAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "V2_ROOT_AGENT"
        }
      }
    },
    "certifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "RELEASE_CERTIFIER"
        }
      }
    },
    "passed0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "status"
      ],
      "properties": {
        "check": {
          "const": "ROOT_AGENT_AUDIT_RECOMMENDATION"
        },
        "status": {
          "const": "PASSED"
        }
      }
    },
    "failed0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
