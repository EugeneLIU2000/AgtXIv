      ],
      "properties": {
        "check": {
          "const": "ROOT_AGENT_AUDIT_RECOMMENDATION"
        },
        "status": {
          "const": "FAILED"
        }
      }
    },
    "any0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "status"
      ],
      "properties": {
        "check": {
          "const": "ROOT_AGENT_AUDIT_RECOMMENDATION"
        },
        "status": {
          "enum": [
            "PASSED",
            "FAILED"
          ]
        }
      }
    },
    "passed1": {
      "type": "object",
      "additionalProperties": false,
