{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v2/release-certification-record/2.0.0",
  "title": "AgtXIv V2 Mechanical ReleaseCertificationRecord",
  "description": "Independent mechanical certification or rejection of the exact Root Agent audit/recommendation, hashes, policy, and release binding.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "record_revision",
        "manifest_ref",
        "root_agent_audit_ref",
        "coordinator",
        "root_agent",
        "certifier",
        "content_hash",
        "mechanical_checks",
        "certified_release_hash",
        "rejection_reasons",
        "decision"
      ],
      "properties": {
        "schema": {
          "const": "agtxiv.release-certification-record/2.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^release-certification-record:"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_ref": {
          "$ref": "#/$defs/exactRef"
        },
        "root_agent_audit_ref": {
          "$ref": "#/$defs/exactRef"
        },
        "coordinator": {
          "$ref": "#/$defs/coordinator"
        },
        "root_agent": {
          "$ref": "#/$defs/rootAgent"
        },
        "certifier": {
          "$ref": "#/$defs/certifier"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "decision": {
          "const": "CERTIFIED"
        },
        "mechanical_checks": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/passed0"
            },
            {
              "$ref": "#/$defs/passed1"
            },
            {
              "$ref": "#/$defs/passed2"
            },
            {
              "$ref": "#/$defs/passed3"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "certified_release_hash": {
          "$ref": "#/$defs/hash"
        },
        "rejection_reasons": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
