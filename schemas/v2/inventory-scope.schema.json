{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v2/inventory-scope/2.0.0",
  "title": "AgtXIv V2 InventoryScope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "record_revision",
    "profile_ref",
    "paper_release",
    "entries",
    "content_hash"
  ],
  "properties": {
    "schema": {
      "const": "agtxiv.inventory-scope/2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^inventory-scope:"
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1
    },
    "profile_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "paper_release": {
      "$ref": "#/$defs/paperRelease"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inventoryEntry"
      }
    },
    "content_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "paperRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "release_id",
        "source_uri",
        "source_hash",
        "source_path"
      ],
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "source_hash": {
          "$ref": "#/$defs/hash"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "entry_kind",
        "source_locator",
        "source_hash",
        "source_component_path"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^inventory-entry:"
        },
        "entry_kind": {
          "enum": [
            "SCIENTIFIC_CLAIM",
            "MATH_CLAIM",
            "DEFINITION",
            "ASSUMPTION",
            "FORMALIZATION_TARGET",
            "EVIDENCE_TARGET",
            "ALIGNMENT_TARGET",
            "ASSESSMENT_TARGET"
          ]
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "$ref": "#/$defs/hash"
        },
        "source_component_path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
