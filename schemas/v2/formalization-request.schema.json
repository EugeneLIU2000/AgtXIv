{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v2/formalization-request/2.0.0",
  "title": "AgtXIv V2 FormalizationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "record_revision",
    "mode",
    "target_ref",
    "boundary",
    "environment",
    "requested_artifacts",
    "content_hash"
  ],
  "properties": {
    "schema": {
      "const": "agtxiv.formalization-request/2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^formalization-request:"
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "const": "AUTOMATED"
    },
    "target_ref": {
      "$ref": "#/$defs/componentRef"
    },
    "boundary": {
      "$ref": "#/$defs/boundary"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "requested_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "TARGET_STATEMENT",
          "SOURCE_MODULE",
          "BUILD_REPORT",
          "GENERATED_PROOF"
        ]
      }
    },
    "content_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_revision",
        "content_hash",
        "component_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "component_path": {
          "type": "string",
          "pattern": "^/([^~/]|~[01])+(?:/([^~/]|~[01])*)*$"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "source_component_hash",
        "inventory_entry_id"
      ],
      "properties": {
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "source_component_hash": {
          "$ref": "#/$defs/hash"
        },
        "inventory_entry_id": {
          "type": "string",
          "pattern": "^inventory-entry:"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "descriptor_path",
        "descriptor_hash"
      ],
      "properties": {
        "environment_id": {
          "type": "string",
          "minLength": 1
        },
        "descriptor_path": {
          "type": "string",
          "minLength": 1
        },
        "descriptor_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
