{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v2/release-audit-record/2.0.0",
  "title": "AgtXIv V2 ReleaseAuditRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "record_revision",
    "manifest_ref",
    "profile_ref",
    "scope_ref",
    "coordinator",
    "auditor",
    "checks",
    "outcome",
    "audited_release_hash",
    "content_hash"
  ],
  "properties": {
    "schema": {
      "const": "agtxiv.release-audit-record/2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^release-audit-record:"
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1
    },
    "manifest_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "profile_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "scope_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "coordinator": {
      "$ref": "#/$defs/coordinator"
    },
    "auditor": {
      "$ref": "#/$defs/auditor"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status"
        ],
        "properties": {
          "check": {
            "enum": [
              "EXACT_INPUTS",
              "TOTAL_DISPOSITION_ACCOUNTING",
              "ARTIFACT_INTEGRITY",
              "PROFILE_CONFORMANCE",
              "ROLE_SEPARATION"
            ]
          },
          "status": {
            "const": "PASSED"
          }
        }
      }
    },
    "outcome": {
      "const": "PASSED"
    },
    "audited_release_hash": {
      "$ref": "#/$defs/hash"
    },
    "content_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "AGENTIZATION_COORDINATOR"
        }
      }
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "RELEASE_AUDITOR"
        }
      }
    }
  }
}
