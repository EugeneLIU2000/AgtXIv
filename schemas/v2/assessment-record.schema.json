{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v2/assessment-record/2.0.0",
  "title": "AgtXIv V2 AssessmentRecord",
  "description": "Typed independent authority for one assessment kind over exact targets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "record_revision",
    "source_inventory_entry_id",
    "assessment_kind",
    "target_refs",
    "axis",
    "relation",
    "left_entry_id",
    "right_entry_id",
    "outcome",
    "content_hash"
  ],
  "properties": {
    "schema": {
      "const": "agtxiv.assessment-record/2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^assessment-record:"
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1
    },
    "assessment_kind": {
      "enum": [
        "SOURCE_ALIGNMENT",
        "FORMAL_VERIFICATION",
        "SCIENTIFIC_ACCEPTANCE",
        "CROSS_PAPER_RELATION",
        "ROOT_STAGE_ASSESSMENT"
      ]
    },
    "target_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exactRef"
      }
    },
    "axis": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SOURCE_ASSERTION",
        "FORMAL_VERIFICATION",
        "SCIENTIFIC_ACCEPTANCE",
        null
      ]
    },
    "relation": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "EQUIVALENT",
        "SPECIAL_CASE",
        "GENERALIZES",
        "INCOMPARABLE",
        "CONFLICTING",
        "CORRECTS",
        "SUPPORTS",
        "QUALIFIES",
        "REFUTES",
        null
      ]
    },
    "left_entry_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^knowledge-entry:"
    },
    "right_entry_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^knowledge-entry:"
    },
    "outcome": {
      "enum": [
        "ALIGNED",
        "MISALIGNED",
        "KERNEL_CHECKED",
        "KERNEL_REJECTED",
        "ACCEPTED",
        "REJECTED",
        "RELATION_CONFIRMED",
        "RELATION_REJECTED",
        "PASSED",
        "BLOCKED",
        "UNKNOWN",
        "REFUTED"
      ]
    },
    "content_hash": {
      "$ref": "#/$defs/hash"
    },
    "source_inventory_entry_id": {
      "type": "string",
      "pattern": "^inventory-entry:"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assessment_kind": {
            "const": "SOURCE_ALIGNMENT"
          }
        }
      },
      "then": {
        "properties": {
          "axis": {
            "const": "SOURCE_ASSERTION"
          },
          "relation": {
            "const": null
          },
          "left_entry_id": {
            "const": null
          },
          "right_entry_id": {
            "const": null
          },
          "outcome": {
            "enum": [
              "ALIGNED",
              "MISALIGNED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment_kind": {
            "const": "FORMAL_VERIFICATION"
          }
        }
      },
      "then": {
        "properties": {
          "axis": {
            "const": "FORMAL_VERIFICATION"
          },
          "relation": {
            "const": null
          },
          "left_entry_id": {
            "const": null
          },
          "right_entry_id": {
            "const": null
          },
          "outcome": {
            "enum": [
              "KERNEL_CHECKED",
              "KERNEL_REJECTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment_kind": {
            "const": "SCIENTIFIC_ACCEPTANCE"
          }
        }
      },
      "then": {
        "properties": {
          "axis": {
            "const": "SCIENTIFIC_ACCEPTANCE"
          },
          "relation": {
            "const": null
          },
          "left_entry_id": {
            "const": null
          },
          "right_entry_id": {
            "const": null
          },
          "outcome": {
            "enum": [
              "ACCEPTED",
              "REJECTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment_kind": {
            "const": "CROSS_PAPER_RELATION"
          }
        }
      },
      "then": {
        "properties": {
          "axis": {
            "const": null
          },
          "relation": {
            "not": {
              "const": null
            }
          },
          "left_entry_id": {
            "type": "string"
          },
          "right_entry_id": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "RELATION_CONFIRMED",
              "RELATION_REJECTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment_kind": {
            "const": "ROOT_STAGE_ASSESSMENT"
          }
        }
      },
      "then": {
        "properties": {
          "axis": {
            "const": null
          },
          "relation": {
            "const": null
          },
          "left_entry_id": {
            "const": null
          },
          "right_entry_id": {
            "const": null
          },
          "outcome": {
            "enum": [
              "PASSED",
              "BLOCKED",
              "UNKNOWN",
              "REFUTED"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_revision": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
