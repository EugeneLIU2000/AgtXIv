{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schemas/repository-validation/pytest-test-identity.schema.json",
  "title": "AgtXIv portable deterministic pytest test identity",
  "$comment": "This schema defines the structural interoperability layer for a portable test-identity baseline. Cross-environment reuse is permitted only when the collection contract, exact input bindings, full node IDs, selection and deselection, collection skips, marker declarations, counts, and derived digests are identical. Host runtime observations are intentionally outside this identity, but every evaluation must still strictly qualify them against the bound locks as LOCKED_RUNTIME_MATCHED; this environment qualification is an enforced security check, and exclusion from baseline equality is not a waiver. JSON Schema cannot distinguish lexical 1 and 1.0. The Python validator is the normative authority for semantic invariants, canonical ordering, Unicode normalization, and exact Python numeric types, including rejecting 1.0 where an integer 1 is required. JSON Schema validation alone never establishes baseline acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_scope",
    "collection_contract",
    "input_bindings",
    "counts",
    "node_ids",
    "selected_node_ids",
    "deselected_node_ids",
    "collection_skips",
    "marker_declarations",
    "node_set_sha256",
    "node_order_sha256"
  ],
  "properties": {
    "schema": {
      "const": "agtxiv.pytest-test-identity/1.0.0"
    },
    "evidence_scope": {
      "const": "COLLECTION_IDENTITY_ONLY_NOT_TEST_EXECUTION_RESULT"
    },
    "collection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "rootdir",
        "test_paths",
        "import_mode",
        "plugin_autoload",
        "cacheprovider",
        "config_addopts_enabled",
        "keyword_selection",
        "marker_selection",
        "deselection_policy",
        "collection_skip_policy",
        "double_collection_required",
        "set_digest_scope",
        "order_digest_scope"
      ],
      "properties": {
        "config": {
          "const": "pyproject.toml"
        },
        "rootdir": {
          "const": "."
        },
        "test_paths": {
          "const": [
            "tests"
          ]
        },
        "import_mode": {
          "const": "prepend"
        },
        "plugin_autoload": {
          "const": false
        },
        "cacheprovider": {
          "const": false
        },
        "config_addopts_enabled": {
          "const": false
        },
        "keyword_selection": {
          "type": "null"
        },
        "marker_selection": {
          "type": "null"
        },
        "deselection_policy": {
          "const": "RECORDED_EXACT"
        },
        "collection_skip_policy": {
          "const": "RECORDED_EXACT"
        },
        "double_collection_required": {
          "const": true
        },
        "set_digest_scope": {
          "const": "FULL_COLLECTED_NODE_SET"
        },
        "order_digest_scope": {
          "const": "SELECTED_EXECUTION_ORDER"
        }
      }
    },
    "input_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        ".python-version",
        "pyproject.toml",
        "uv.lock"
      ],
      "properties": {
        ".python-version": {
          "$ref": "#/$defs/input_binding"
        },
        "pyproject.toml": {
          "$ref": "#/$defs/input_binding"
        },
        "uv.lock": {
          "$ref": "#/$defs/input_binding"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected",
        "selected",
        "deselected",
        "collection_skipped",
        "marker_declarations"
      ],
      "properties": {
        "collected": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "selected": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deselected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collection_skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "marker_declarations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/node_id"
      }
    },
    "selected_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/node_id"
      }
    },
    "deselected_node_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/node_id"
      }
    },
    "collection_skips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "reason"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/node_id"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        }
      }
    },
    "marker_declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "markers"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/node_id"
          },
          "markers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "args",
                "kwargs"
              ],
              "properties": {
                "name": {
                  "enum": [
                    "skip",
                    "skipif",
                    "xfail"
                  ]
                },
                "args": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/stable_json_value"
                  }
                },
                "kwargs": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/stable_json_value"
                  }
                }
              }
            }
          }
        }
      }
    },
    "node_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "node_order_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_size",
        "sha256"
      ],
      "properties": {
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "$comment": "Every node ID is also semantically checked for Unicode NFC; JSON Schema cannot express normalization.",
      "pattern": "^tests/(?!\\.\\.(?:/|::|$)|\\.(?:/|::|$))[^/\\\\\\r\\n\\u0000:]+(?:/(?!\\.\\.(?:/|::|$)|\\.(?:/|::|$))[^/\\\\\\r\\n\\u0000:]+)*(?:::(?:(?!::)[^\\r\\n\\u0000])+)*(?![\\s\\S])"
    },
    "stable_json_value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_json_value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stable_json_value"
          }
        }
      ]
    }
  }
}
