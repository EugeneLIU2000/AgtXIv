.DS_Store
.tools/
**/__pycache__/
**/.lake/
.venv/
.uv-cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
coverage.xml
htmlcov/
*.olean
*.ilean
_site/
Reference/Lean-QIT/
Reference/LeanQuantum/

# Frozen third-party source snapshots (recoverable from upstream)
/Reference/vibefeld-*/

# Local paper compilation products (upstream source files remain tracked)
/Reference/Application of a resource theory for magic states to fault-tolerant quantum computing/build/

# Local render and inspection output
/tmp/
/local-archive/
/draft/build/
/slides/build/
~$*

# Derived database sidecars
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# LaTeX build products (source-supplied .bbl files remain trackable)
*.aux
*.log
*.synctex.gz
*.fls
*.fdb_latexmk
*.blg
*.out
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.run.xml
*.bcf
*-blx.bib

# Regenerated or presentation-specific figure derivatives
/figures/*@2x.png
/figures/src/figures.js
/figures/src/ops/
/figures/src/pptx_backend.py
/docs/assets/*.png

# Explicitly excluded presentation/logo material
/Reference/Paper2Agent Reimagining Research Papers As Interactive and Reliable AI Agents/paper2Agent_logo.pdf

# Host probe local run database (regenerated by e2e.py)
/schema v0.2/host_probe/e2e.sqlite

# Live arXiv request throttle control (receipts are retained separately)
/schema v0.3/runs/.arxiv-api-throttle

node_modules/
package-lock.json

# Public schema v0.3 framework excludes local source-bearing research evidence.
# These rules prevent accidental additions; they do not remove tracked history.
/schema v0.3/runs/
/schema v0.3/epoch-migration/runs/20260919-full-case/query-gap-report.json

# A third-party talk's recovered slides and the owner's notes on it stay in the local archive.
/output/pdf/osborne-recovered/
/output/pdf/osborne-slides-recovered.pdf

# Third-party paper sources stay in the local archive (docs/REFERENCES.md lists them).
/Reference/
/References/
