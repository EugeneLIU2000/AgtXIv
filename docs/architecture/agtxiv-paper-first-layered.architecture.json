  "cards": [
    {
      "dot": "violet",
      "title": "Identity, Representation, and Alignment",
      "items": [
        "ScientificClaim owns assertion identity; MathClaimIR owns the canonical mathematical representation and links to an exact ScientificClaim revision.",
        "Exact reference binding does not by itself establish semantic equivalence.",
        "ClaimMathAlignment uses stable component IDs, exact paths, and mapped-or-residual completeness."
      ]
    },
    {
      "dot": "emerald",
      "title": "Artifacts, Facts, and Scoped Conclusions",
      "items": [
        "FormalizationRecord owns target-system artifacts, environments, and candidates; Evidence and Blocker records own independent external facts.",
        "Versioned assessments separately evaluate formalizability, verification, applicability, and acceptance.",
        "A bounded answer selects exact assessments and retains uncertainty and non-implications; AgtXIv.md supplies current boundary evidence."
      ]
    }
  ]
