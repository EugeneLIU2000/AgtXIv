  "cards": [
    {
      "dot": "emerald",
      "title": "Release completion is accounting, not truth",
      "items": [
        "Every in-scope inventory entry has exactly one disposition under the exact profile and scope.",
        "Certification attests package integrity and profile conformance while preserving blocked, deferred, or failed entries."
      ]
    },
    {
      "dot": "violet",
      "title": "Authority stays separated",
      "items": [
        "The AgentizationCoordinator, ReleaseAuditor, and ReleaseCertifier are distinct identities; the legacy Root Agent is not a V2 release role.",
        "FormalizationRecord stores generated outcomes and artifacts only; verification, alignment, and acceptance remain independent records."
      ]
    },
    {
      "dot": "amber",
      "title": "Queries consume releases",
      "items": [
        "PACKAGE_BACKED is read-only and follows certified package references plus the verification-aware index.",
        "PROVISIONAL_FAST_PATH triggers or links query-independent standard agentization, but cannot narrow its profile/scope, write a release, or promote a knowledge-base entry."
      ]
    }
  ]
