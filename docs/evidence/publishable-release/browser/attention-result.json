00^2i/\\dmodel)","latex":"\\begin{align*}\n    PE_{(pos,2i)} = sin(pos / 10000^{2i/\\dmodel}) \\\\\n    PE_{(pos,2i+1)} = cos(pos / 10000^{2i/\\dmodel})\n\\end{align*}","excerptTruncated":false,"anchor":{"path":"model_architecture.tex","sourceSha256":"sha256:d524e853dc5f98bb482ee7289908b9640ee9e6ea38586c14c7c1ea0a5c0f5fdf","startByte":16185,"endByte":16317,"startLine":148,"endLine":151,"spanSha256":"sha256:fe6f0d9013496ecd92b7774d5b924dfb36148b75d39e8eb5350edc7bcdb023d2"},"excerptAnchor":{"path":"model_architecture.tex","sourceSha256":"sha256:d524e853dc5f98bb482ee7289908b9640ee9e6ea38586c14c7c1ea0a5c0f5fdf","startByte":16185,"endByte":16317,"startLine":148,"endLine":151,"spanSha256":"sha256:fe6f0d9013496ecd92b7774d5b924dfb36148b75d39e8eb5350edc7bcdb023d2"},"labels":[],"activity":"ACTIVE","interpretation":"SOURCE_LINKED_CANDIDATE_NOT_SCIENTIFIC_APPROVAL","dependencies":[],"citationCues":[],"assessments":{"source_fidelity":"NO_ASSESSMENT","mathematical_correctness":"NO_ASSESSMENT","formal_alignment":"NO_ASSESSMENT","semantic_applicability":"NO_ASSESSMENT","empirical_support":"NO_ASSESSMENT","computational_reproducibility":"NO_ASSESSMENT"}},{"id":"candidate:c7e1e25263557acb2569e15f","type":"EQUATION","environment":"align","text":"FFN(x, W_1, W_2) = ReLU(xW_1)W_2 A(q, K, V) = Softmax(qK^T)V","latex":"\\begin{align*}\n    FFN(x, W_1, W_2) = ReLU(xW_1)W_2 \\\\\n    A(q, K, V) = Softmax(qK^T)V\n\\end{align*}","excerptTruncated":false,"anchor":{"path":"parameter_attention.tex","sourceSha256":"sha256:c698e2bfec0a0acfa2a6447ceabc920aa4b631df1a291647b7124ae9688aff5d","startByte":500,"endByte":599,"startLine":6,"endLine":9,"spanSha256":"sha256:27a0c9f3aa8ca2b7b4c03cdbbffccadb05ae0ae23351213ac44ecfa905d71d76"},"excerptAnchor":{"path":"parameter_attention.tex","sourceSha256":"sha256:c698e2bfec0a0acfa2a6447ceabc920aa4b631df1a291647b7124ae9688aff5d","startByte":500,"endByte":599,"startLine":6,"endLine":9,"spanSha256":"sha256:27a0c9f3aa8ca2b7b4c03cdbbffccadb05ae0ae23351213ac44ecfa905d71d76"},"labels":[],"activity":"UNKNOWN","interpretation":"SOURCE_LINKED_CANDIDATE_NOT_SCIENTIFIC_APPROVAL","dependencies":[],"citationCues":[],"assessments":{"source_fidelity":"NO_ASSESSMENT","mathematical_correctness":"NO_ASSESSMENT","formal_alignment":"NO_ASSESSMENT","semantic_applicability":"NO_ASSESSMENT","empirical_support":"NO_ASSESSMENT","computational_reproducibility":"NO_ASSESSMENT"}},{"id":"candidate:cec7fe65355c98a40574bdd6","type":"ASSERTION_PARAGRAPH","environment":null,"text":"In this section, we will give a rough justification of this scaling factor, that is, we will show that for any two vectors, \\vecu and \\vecv, whose variance and mean are 1 and 0 respectively, the variance and the mean of the dot product are d_k and 0 respectively. Therefore, dividing by \\sqrtd_k ensures that each component of the attention logits are normalized. The repeated layer norms at each transformer layer encourage \\vecu and \\vecv to be normalized.","latex":"In this section, we will give a rough justification of this scaling factor, that is, we will show that for any two vectors, $\\vec{u}$ and $\\vec{v}$, whose variance and mean are $1$ and $0$ respectively, the variance and the mean of the dot product are $d_k$ and $0$ respectively. Therefore, dividing by $\\sqrt{d_k}$ ensures that each component of the attention logits are normalized. The repeated layer norms at each transformer layer encourage $\\vec{u}$ and $\\vec{v}$ to be normalized. ","excerptTruncated":false,"anchor":{"path":"sqrt_d_trick.tex","sourceSha256":"sha256:db2dfbf394ad8b07c882f77735838f4f2dfbe585b0b5c69ef361e43daa7c906d","startByte":1267,"endByte":1754,"startLine":11,"endLine":11,"spanSha256":"sha256:7f9c4c39c6cb855b48afe3421ef59db52a54e78502231c6ee6c3716f455bf69f"},"excerptAnchor":{"path":"sqrt_d_trick.tex","sourceSha256":"sha256:db2dfbf394ad8b07c882f77735838f4f2dfbe585b0b5c69ef361e43daa7c906d","startByte":1267,"endByte":1754,"startLine":11,"endLine":11,"spanSha256":"sha256:7f9c4c39c6cb855b48afe3421ef59db52a54e78502231c6ee6c3716f455bf69f"},"labels":[],"activity":"INACTIVE","interpretation":"SOURCE_LINKED_CANDIDATE_NOT_SCIENTIFIC_APPROVAL","dependencies":[],"citationCues":[],"assessments":{"source_fidelity":"NO_ASSESSMENT","mathematical_correctness":"NO_ASSESSMENT","formal_alignment":"NO_ASSESSMENT","semantic_applicability":"NO_ASSESSMENT","empirical_support":"NO_ASSESSMENT","computational_reproducibility":"NO_ASSESSMENT"}},{"id":"candidate:82fe594583bf95c373c5d0a8","type":"EQUATION","environment":"align","text":"E[<\\vecu,\\vecv>] & = \\sum_k E[u_i v_i] &By linearity of expectation & =\\sum_k E[u_i]E[v_i] & Assuming independence & = 0","latex":"\\begin{align*}\n    E[<\\vec{u},\\vec{v}>] & =  \\sum_k E[u_i v_i] &\\text{By linearity of expectation} \\\\\n    & =\\sum_k E[u_i]E[v_i] & \\text{Assuming independence} \\\\\n    & = 0\n\\end{align*}","excerptTruncated":false,"anchor":{"path":"sqrt_d_trick.tex","sourceSha256":"sha256:db2dfbf394ad8b07c882f77735838f4f2dfbe585b0b5c69ef361e43daa7c906d","startByte":1757,"endByte":1942,"startLine":14,"endLine":18,"spanSha256":"sha256:d1ef2c3014c5bd3bc175669f0d2006edc7ae4d0897f35a441e099202182133e4"},"excerptAnchor":{"path":"sqrt_d_trick.tex","sourceSha256":"sha256:db2dfbf394ad8b07c882f77735838f4f2dfbe585b0b5c69ef361e43daa7c906d","startByte":1757,"endByte":1942,"startLine":14,"endLine":18,"spanSha256":"sha256:d1ef2c3014c5bd3bc175669f0d2006edc7ae4d0897f35a441e099202182133e4"},"labels":[],"activity":"INACTIVE","interpretation":"SOURCE_LINKED_CANDIDATE_NOT_SCIENTIFIC_APPROVAL","dependencies":[],"citationCues":[],"assessments":{"source_fidelity":"NO_ASSESSMENT","mathematical_correctness":"NO_ASSESSMENT","formal_alignment":"NO_ASSESSMENT","semantic_applicability":"NO_ASSESSMENT","empirical_support":"NO_ASSESSMENT","computational_reproducibility":"NO_ASSESSMENT"}},{"id":"candidate:5441e83079a93d8e83ce4d90","type":"EQUATION","environment":"align","text":"E[(<\\vecu,\\vecv>-E[<\\vecu,\\vecv>])^2] & = E[(<\\vecu,\\vecv>)^2] - E[<\