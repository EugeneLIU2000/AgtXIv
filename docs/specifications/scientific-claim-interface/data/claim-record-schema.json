{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/studies/scientific-claim-interface/claim-record.schema.json",
  "title": "ScientificClaim interface stress-test record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "paper_id",
    "statement",
    "source_spans",
    "atomicity",
    "scope",
    "modality",
    "knowledge_attribution",
    "math_normalization",
    "interface_pressure",
    "review_status"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^candidate:arxiv:2608\\.[0-9]{5}:[a-z0-9-]+$"},
    "paper_id": {"type": "string", "pattern": "^arxiv:2608\\.[0-9]{5}v[0-9]+$"},
    "statement": {"type": "string", "minLength": 1},
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_file", "line_start", "line_end", "exact_text"],
        "properties": {
          "source_file": {"type": "string", "minLength": 1},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "exact_text": {"type": "string", "minLength": 1}
        }
      }
    },
    "atomicity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["single_primary_predication", "split_note"],
      "properties": {
        "single_primary_predication": {"type": "boolean"},
        "split_note": {"type": "string"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "quantifiers", "population_or_system"],
      "properties": {
        "conditions": {"type": "array", "items": {"type": "string"}},
        "quantifiers": {"type": "array", "items": {"type": "string"}},
        "population_or_system": {"type": "string"}
      }
    },
    "modality": {"enum": ["ASSERTED", "CONDITIONAL", "APPROXIMATE", "HYPOTHESIZED", "CONJECTURED", "PREDICTED", "REPORTED", "QUESTIONED"]},
    "knowledge_attribution": {"enum": ["CURRENT_WORK", "PREVIOUS_OWN_WORK", "OTHER_WORK", "COMMUNITY_BACKGROUND", "SYSTEM_DERIVED", "AMBIGUOUS"]},
    "source_designation": {"type": ["string", "null"]},
    "phenomenon_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "math_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suitability", "reason"],
      "properties": {
        "suitability": {"enum": ["YES", "PARTIAL", "NO"]},
        "reason": {"type": "string"}
      }
    },
    "interface_pressure": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "review_status": {"enum": ["EXTRACTED", "SOURCE_CHECKED", "REVISED", "REJECTED"]},
    "review_note": {"type": "string"}
  }
}
