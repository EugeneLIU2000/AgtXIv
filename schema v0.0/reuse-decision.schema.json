{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/reuse-decision.schema.json",
  "title": "ReuseDecision",
  "description": "Permission to reuse an exact result for one specified target and evidence standard.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.reuse-decision/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "source_ref": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef",
          "description": "Exact reusable result."
        },
        "target_ref": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef",
          "description": "Exact proposed target use."
        },
        "profile_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.processing-profile/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Evidence standard required by this use."
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ParameterComparison"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Required object, premise, scope, evidence and environment matching."
        },
        "assessment_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Evidence and relation decisions supporting reuse."
        },
        "review": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ReviewContext",
          "description": "Independent use-specific review."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "REJECT",
            "CONDITIONAL",
            "ALLOW"
          ],
          "description": "Use permission, not a new theorem proof."
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Condition"
          },
          "maxItems": 10000,
          "description": "Remaining conditions required at the target."
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "properties": {
                  "record_type": {
                    "enum": [
                      "agtxiv.v3.relation-assessment/0.0.0"
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 10000,
          "description": "Relevant contradictory or limiting relations."
        },
        "environment_check_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
                },
                {
                  "properties": {
                    "record_type": {
                      "enum": [
                        "agtxiv.v3.environment-check/0.0.0"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact formal import compatibility when relevant."
        }
      },
      "required": [
        "source_ref",
        "target_ref",
        "profile_ref",
        "comparisons",
        "assessment_refs",
        "review",
        "outcome",
        "conditions",
        "conflict_refs",
        "environment_check_ref"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false
}
