{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/formal-check.schema.json",
  "title": "FormalCheckRecord",
  "description": "Independent target-level kernel and transitive axiom evidence.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.formal-check/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "packet_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.formalization-packet/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact target handoff."
        },
        "attempt_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.formalization-attempt/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Files actually checked."
        },
        "environment_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.formal-environment/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact checker environment."
        },
        "review": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ReviewContext",
          "description": "Independence from formal source generation."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "FAILED",
            "BLOCKED",
            "KERNEL_CHECKED"
          ],
          "description": "Scoped observed checker result."
        },
        "built_declarations": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/FormalDeclaration"
          },
          "maxItems": 10000,
          "description": "Declarations actually inspected in the environment."
        },
        "placeholder_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 10000,
          "description": "Detected unresolved placeholders or forbidden mechanisms."
        },
        "logs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ArtifactRef"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Independent checker and axiom-audit logs."
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Actual process exit code represented as a nonnegative integer."
        }
      },
      "required": [
        "packet_ref",
        "attempt_ref",
        "environment_ref",
        "review",
        "outcome",
        "built_declarations",
        "placeholder_findings",
        "logs",
        "exit_code"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "outcome": {
                "const": "KERNEL_CHECKED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "built_declarations": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "is_axiom": {
                      "const": false
                    }
                  }
                }
              },
              "placeholder_findings": {
                "maxItems": 0
              },
              "exit_code": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
