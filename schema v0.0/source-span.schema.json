{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/source-span.schema.json",
  "title": "SourceSpan",
  "description": "Exact source occurrence used to attribute a proposition or condition.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.source-span/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "source_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.source-snapshot/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact source snapshot containing this occurrence."
        },
        "artifact": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ArtifactRef",
          "description": "Raw source bytes containing the occurrence."
        },
        "locator_kind": {
          "type": "string",
          "enum": [
            "RAW_TEXT_BYTES",
            "PDF_REGION",
            "TRANSFORMED_TEXT"
          ],
          "description": "Exact source occurrence representation."
        },
        "byte_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive zero-based byte offset; null for a PDF page region."
        },
        "byte_end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Exclusive byte offset, null for a PDF page region."
        },
        "span_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "minLength": 71,
              "maxLength": 71
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact selected text-byte digest; null for a PDF page region."
        },
        "pdf_region": {
          "anyOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/PdfRegion"
            },
            {
              "type": "null"
            }
          ],
          "description": "Page and box for a PDF occurrence."
        },
        "transformation_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
                },
                {
                  "properties": {
                    "record_type": {
                      "enum": [
                        "agtxiv.v3.source-transformation/0.0.0"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact mapping when using derived text."
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Human-readable page, line or label."
        },
        "activity": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "DORMANT",
            "UNKNOWN"
          ],
          "description": "Occurrence participation in the chosen source rendering."
        }
      },
      "required": [
        "source_ref",
        "artifact",
        "locator_kind",
        "byte_start",
        "byte_end",
        "span_sha256",
        "pdf_region",
        "transformation_ref",
        "locator",
        "activity"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "locator_kind": {
                "const": "RAW_TEXT_BYTES"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "byte_start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "byte_end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "span_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "minLength": 71,
                "maxLength": 71
              },
              "pdf_region": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "locator_kind": {
                "const": "TRANSFORMED_TEXT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "byte_start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "byte_end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "span_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "minLength": 71,
                "maxLength": 71
              },
              "pdf_region": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "locator_kind": {
                "const": "RAW_TEXT_BYTES"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "transformation_ref": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "locator_kind": {
                "const": "TRANSFORMED_TEXT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "transformation_ref": {
                "allOf": [
                  {
                    "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
                  },
                  {
                    "properties": {
                      "record_type": {
                        "enum": [
                          "agtxiv.v3.source-transformation/0.0.0"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "locator_kind": {
                "const": "PDF_REGION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "byte_start": {
                "const": null
              },
              "byte_end": {
                "const": null
              },
              "span_sha256": {
                "const": null
              },
              "pdf_region": {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/PdfRegion"
              },
              "transformation_ref": {
                "const": null
              },
              "artifact": {
                "properties": {
                  "media_type": {
                    "const": "application/pdf"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
