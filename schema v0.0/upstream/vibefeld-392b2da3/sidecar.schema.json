{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/upstream/vibefeld-392b2da3/sidecar.schema.json",
  "title": "AgtXIv pinned vibefeld sidecar import profile",
  "description": "Closed structural profile for one pinned upstream commit. This is neither a scientific validity certificate nor an upstream-issued JSON Schema.",
  "x-upstream-commit": "392b2da3bee5766cca1a201f28e0255056baaba4",
  "x-import-profile": "agtxiv.vibefeld-offline/392b2da3.1",
  "oneOf": [
    {
      "$ref": "#/$defs/Definition"
    },
    {
      "$ref": "#/$defs/Assumption"
    },
    {
      "$ref": "#/$defs/External"
    },
    {
      "$ref": "#/$defs/Lemma"
    },
    {
      "$ref": "#/$defs/PendingDef"
    },
    {
      "$ref": "#/$defs/Config"
    },
    {
      "$ref": "#/$defs/Node"
    }
  ],
  "$defs": {
    "EventType": {
      "type": "string",
      "enum": [
        "proof_initialized",
        "node_created",
        "nodes_claimed",
        "nodes_released",
        "challenge_raised",
        "challenge_resolved",
        "challenge_withdrawn",
        "challenge_superseded",
        "node_validated",
        "node_admitted",
        "node_refuted",
        "node_archived",
        "node_amended",
        "taint_recomputed",
        "def_added",
        "lemma_extracted",
        "lock_reaped",
        "scope_opened",
        "scope_closed",
        "claim_refreshed",
        "refinement_requested",
        "node_submitted",
        "node_unvalidated",
        "node_unadmitted",
        "approach_tried",
        "evidence_attached",
        "outline_set",
        "outline_stage_linked",
        "hint_added",
        "node_vetoed",
        "strategy_proposed",
        "pattern_added",
        "claim_tested",
        "def_checked",
        "node_proof_authored"
      ]
    },
    "NodeType": {
      "type": "string",
      "enum": [
        "claim",
        "local_assume",
        "local_discharge",
        "case",
        "qed"
      ]
    },
    "WorkflowState": {
      "type": "string",
      "enum": [
        "available",
        "claimed",
        "blocked"
      ]
    },
    "EpistemicState": {
      "type": "string",
      "enum": [
        "pending",
        "validated",
        "admitted",
        "refuted",
        "archived",
        "needs_refinement",
        "draft"
      ]
    },
    "TaintState": {
      "type": "string",
      "enum": [
        "clean",
        "self_admitted",
        "tainted",
        "unresolved"
      ]
    },
    "PendingDefStatus": {
      "type": "string",
      "enum": [
        "pending",
        "resolved",
        "cancelled"
      ]
    },
    "NodeID": {
      "type": "string",
      "pattern": "^1(?:\\.[1-9][0-9]*)*$",
      "description": "Canonical hierarchical ID; numeric aliases accepted by Go are deliberately rejected by this import profile."
    },
    "TimestampString": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "RFC3339 timestamp with at most nine fractional digits. Preserve original bytes and nanosecond precision; calendar validity requires format checking."
    },
    "Timestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimestampString"
        },
        {
          "type": "null"
        }
      ],
      "description": "The pinned Go timestamp decoder also accepts null as its zero value; null is never evidence of a recorded time."
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Upstream lowercase SHA256 text without a prefix. Structure alone does not verify its content preimage."
    },
    "NonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "created": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "name",
        "content",
        "content_hash",
        "created"
      ],
      "description": "Pinned Definition from internal/node/definition.go; only non-omitempty JSON fields are required."
    },
    "Assumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "created": {
          "$ref": "#/$defs/Timestamp"
        },
        "justification": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "content_hash",
        "created"
      ],
      "description": "Pinned Assumption from internal/node/assumption.go; only non-omitempty JSON fields are required."
    },
    "External": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "created": {
          "$ref": "#/$defs/Timestamp"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "source",
        "content_hash",
        "created",
        "notes"
      ],
      "description": "Pinned External from internal/node/external.go; only non-omitempty JSON fields are required."
    },
    "Lemma": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "source_node_id": {
          "$ref": "#/$defs/NodeID"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "created": {
          "$ref": "#/$defs/Timestamp"
        },
        "proof": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "source_node_id",
        "content_hash",
        "created"
      ],
      "description": "Pinned Lemma from internal/node/lemma.go; only non-omitempty JSON fields are required."
    },
    "PendingDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "term": {
          "type": "string"
        },
        "requested_by": {
          "$ref": "#/$defs/NodeID"
        },
        "created": {
          "$ref": "#/$defs/Timestamp"
        },
        "resolved_by": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PendingDefStatus"
        }
      },
      "required": [
        "id",
        "term",
        "requested_by",
        "created",
        "resolved_by",
        "status"
      ],
      "description": "Pinned PendingDef from internal/node/pending_def.go; only non-omitempty JSON fields are required."
    },
    "Config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "conjecture": {
          "type": "string"
        },
        "lock_timeout": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "max_depth": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "max_children": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "warn_depth": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "auto_correct_threshold": {
          "type": "number"
        },
        "schema_path": {
          "type": "string"
        },
        "created": {
          "$ref": "#/$defs/Timestamp"
        },
        "version": {
          "const": "1.0"
        }
      },
      "required": [
        "title",
        "conjecture",
        "lock_timeout",
        "max_depth",
        "max_children",
        "warn_depth",
        "auto_correct_threshold",
        "created",
        "version"
      ],
      "description": "Pinned Config from internal/config/config.go; only non-omitempty JSON fields are required."
    },
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/NodeID"
        },
        "type": {
