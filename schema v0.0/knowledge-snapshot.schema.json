{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/knowledge-snapshot.schema.json",
  "title": "KnowledgeSnapshot",
  "description": "Immutable domain knowledge retaining exact records, relationships and conflicts.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.knowledge-snapshot/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "Domain and interpretation scope."
        },
        "predecessor_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
                },
                {
                  "properties": {
                    "record_type": {
                      "enum": [
                        "agtxiv.v3.knowledge-snapshot/0.0.0"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Previous immutable snapshot; null for genesis."
        },
        "entry_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Admitted source, evidence, theorem or frontier records."
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "properties": {
                  "record_type": {
                    "enum": [
                      "agtxiv.v3.relation-assessment/0.0.0"
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 10000,
          "description": "Assessed relations, including conflicts."
        },
        "release_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "properties": {
                  "record_type": {
                    "enum": [
                      "agtxiv.v3.paper-release/0.0.0"
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 10000,
          "description": "Exact backing paper packages."
        },
        "admission_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "properties": {
                  "record_type": {
                    "enum": [
                      "agtxiv.v3.admission-decision/0.0.0"
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 10000,
          "description": "Decisions authorizing additions."
        }
      },
      "required": [
        "domain",
        "predecessor_ref",
        "entry_refs",
        "relation_refs",
        "release_refs",
        "admission_refs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false
}
