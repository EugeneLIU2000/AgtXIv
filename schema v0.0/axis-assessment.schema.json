{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/axis-assessment.schema.json",
  "title": "AxisAssessment",
  "description": "Exactly one of the six Charter questions with bounded evidence.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.axis-assessment/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Exact objects assessed on this axis."
        },
        "axis": {
          "type": "string",
          "enum": [
            "source_fidelity",
            "mathematical_correctness",
            "formal_alignment",
            "semantic_applicability",
            "empirical_support",
            "computational_reproducibility"
          ],
          "description": "One independent Charter verification axis."
        },
        "applicability": {
          "type": "string",
          "enum": [
            "UNDETERMINED",
            "APPLICABLE",
            "NOT_APPLICABLE"
          ],
          "description": "Whether this question applies to these targets."
        },
        "result": {
          "type": "string",
          "enum": [
            "NOT_ASSESSED",
            "INCONCLUSIVE",
            "PARTIALLY_SUPPORTED",
            "SUPPORTED",
            "COUNTEREVIDENCE"
          ],
          "description": "Evidence conclusion, independent of execution success."
        },
        "execution": {
          "type": "string",
          "enum": [
            "DEFERRED",
            "BLOCKED",
            "FAILED",
            "COMPLETED"
          ],
          "description": "What assessment work actually completed."
        },
        "method": {
          "type": "string",
          "enum": [
            "SOURCE_REVIEW",
            "ARGUMENT_REVIEW",
            "KERNEL_AND_ALIGNMENT",
            "FORMAL_ALIGNMENT",
            "SEMANTIC_REVIEW",
            "EMPIRICAL_REVIEW",
            "REPRODUCTION_REVIEW",
            "COUNTEREXAMPLE_REVIEW",
            "UNASSESSED"
          ],
          "description": "Evidence method and strength."
        },
        "review": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ReviewContext",
          "description": "Attributable independent assessment boundary."
        },
        "support_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Exact supporting evidence."
        },
        "counterevidence_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Exact relevant contrary evidence."
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Condition"
          },
          "maxItems": 10000,
          "description": "Conditions retained with this assessment."
        },
        "frontier_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "properties": {
                  "record_type": {
                    "enum": [
                      "agtxiv.v3.frontier-item/0.0.0"
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 10000,
          "description": "Relevant unresolved problems."
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "Public scoped conclusion including non-applicability reasons."
        }
      },
      "required": [
        "target_refs",
        "axis",
        "applicability",
        "result",
        "execution",
        "method",
        "review",
        "support_refs",
        "counterevidence_refs",
        "conditions",
        "frontier_refs",
        "rationale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "applicability": {
                "const": "NOT_APPLICABLE"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "const": "NOT_ASSESSED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "enum": [
                  "SUPPORTED",
                  "PARTIALLY_SUPPORTED"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "support_refs": {
                "minItems": 1
              },
              "execution": {
                "const": "COMPLETED"
              },
              "applicability": {
                "const": "APPLICABLE"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "const": "COUNTEREVIDENCE"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "counterevidence_refs": {
                "minItems": 1
              },
              "execution": {
                "const": "COMPLETED"
              },
              "applicability": {
                "const": "APPLICABLE"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "method": {
                "const": "UNASSESSED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "const": "NOT_ASSESSED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "method": {
                "const": "SOURCE_REVIEW"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "axis": {
                "const": "source_fidelity"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "method": {
                "const": "ARGUMENT_REVIEW"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "axis": {
                "const": "mathematical_correctness"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "method": {
                "const": "KERNEL_AND_ALIGNMENT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "axis": {
                "const": "mathematical_correctness"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "method": {
                "const": "FORMAL_ALIGNMENT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "axis": {
                "const": "formal_alignment"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "method": {
                "const": "SEMANTIC_REVIEW"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "axis": {
                "const": "semantic_applicability"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "method": {
                "const": "EMPIRICAL_REVIEW"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "axis": {
                "const": "empirical_support"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "method": {
                "const": "REPRODUCTION_REVIEW"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "axis": {
                "const": "computational_reproducibility"
              }
            }
          }
        }
      }
    }
  ]
}
