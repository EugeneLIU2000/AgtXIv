{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/contribution-delta.schema.json",
  "title": "ContributionDelta",
  "description": "Attributable knowledge change relative to one fixed baseline.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.contribution-delta/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "baseline_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.baseline-snapshot/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact comparison baseline, not the later transaction snapshot."
        },
        "current_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "This paper's exact result, method or evidence."
        },
        "prior_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Prior objects compared."
        },
        "operation": {
          "type": "string",
          "enum": [
            "INTRODUCES",
            "DERIVES",
            "REPROVES",
            "GENERALIZES",
            "SPECIALIZES",
            "WEAKENS_ASSUMPTIONS",
            "CORRECTS",
            "QUALIFIES",
            "REFUTES",
            "REPRODUCES",
            "INDEPENDENTLY_VERIFIES",
            "UNIFIES",
            "APPLIES"
          ],
          "description": "Attributable type of change, not an importance score."
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "properties": {
                  "record_type": {
                    "enum": [
                      "agtxiv.v3.relation-assessment/0.0.0"
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 10000,
          "description": "Assessed comparison relations."
        },
        "author_declaration": {
          "type": "string",
          "maxLength": 65536,
          "description": "The paper's own novelty statement, attributed separately."
        },
        "review": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ReviewContext",
          "description": "Independent contribution evaluation."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PROPOSED",
            "BLOCKED",
            "DISPUTED",
            "SUPPORTED",
            "REJECTED"
          ],
          "description": "Bounded delta assessment."
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Baseline coverage and unresolved limitations."
        }
      },
      "required": [
        "baseline_ref",
        "current_refs",
        "prior_refs",
        "operation",
        "relation_refs",
        "author_declaration",
        "review",
        "outcome",
        "qualifications"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "outcome": {
                "const": "SUPPORTED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "relation_refs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
