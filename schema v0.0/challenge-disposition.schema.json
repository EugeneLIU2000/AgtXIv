{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/challenge-disposition.schema.json",
  "title": "ChallengeDisposition",
  "description": "Independent disposition of an exact objection and response.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.challenge-disposition/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "challenge_ref": {
          "allOf": [
            {
              "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
            },
            {
              "properties": {
                "record_type": {
                  "enum": [
                    "agtxiv.v3.challenge/0.0.0"
                  ]
                }
              }
            }
          ],
          "description": "Exact original objection."
        },
        "response": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "Public response without private model reasoning."
        },
        "response_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Revised or additional mathematical evidence."
        },
        "review": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ReviewContext",
          "description": "Independent review of whether the objection is answered."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "OPEN",
            "RESOLVED",
            "WITHDRAWN",
            "SUPERSEDED",
            "DISPUTED"
          ],
          "description": "Disposition retaining the original challenge."
        },
        "replacement_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
                },
                {
                  "properties": {
                    "record_type": {
                      "enum": [
                        "agtxiv.v3.challenge/0.0.0"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "New objection if superseded."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "Why the disposition applies to this exact revision."
        }
      },
      "required": [
        "challenge_ref",
        "response",
        "response_refs",
        "review",
        "outcome",
        "replacement_ref",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "outcome": {
                "const": "SUPERSEDED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "replacement_ref": {
                "allOf": [
                  {
                    "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
                  },
                  {
                    "properties": {
                      "record_type": {
                        "enum": [
                          "agtxiv.v3.challenge/0.0.0"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
