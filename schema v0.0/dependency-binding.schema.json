{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/dependency-binding.schema.json",
  "title": "DependencyBinding",
  "description": "Exact use of a premise, definition or external result.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.dependency-binding/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "dependent_ref": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef",
          "description": "Exact object that needs the dependency."
        },
        "prerequisite_ref": {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef",
          "description": "Exact required input."
        },
        "kind": {
          "type": "string",
          "enum": [
            "MATHEMATICAL",
            "DEFINITION",
            "SCOPE",
            "FORMAL_ENVIRONMENT",
            "SEMANTIC",
            "EMPIRICAL",
            "COMPUTATIONAL",
            "VALIDATION"
          ],
          "description": "Type governing review propagation."
        },
        "affected_axes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "source_fidelity",
              "mathematical_correctness",
              "formal_alignment",
              "semantic_applicability",
              "empirical_support",
              "computational_reproducibility"
            ]
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Axes affected by this dependency."
        },
        "proof_plan_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
                },
                {
                  "properties": {
                    "record_type": {
                      "enum": [
                        "agtxiv.v3.proof-plan/0.0.0"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Proof route requiring this input."
        },
        "comparison": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/ParameterComparison"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Exact assumption and object compatibility."
        },
        "reuse_decision_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
                },
                {
                  "properties": {
                    "record_type": {
                      "enum": [
                        "agtxiv.v3.reuse-decision/0.0.0"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Separate authorization for the intended use."
        }
      },
      "required": [
        "dependent_ref",
        "prerequisite_ref",
        "kind",
        "affected_axes",
        "proof_plan_ref",
        "comparison",
        "reuse_decision_ref"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false
}
