{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/v3/0.0.0/frontier-item.schema.json",
  "title": "FrontierItem",
  "description": "Durable unresolved question and the precise next evidence needed.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "agtxiv.v3.frontier-item/0.0.0",
      "description": "Exact record discriminator."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "maxLength": 512,
      "description": "Stable identity; semantic changes may require a new lineage."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exact immutable version within the lineage."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40,
      "description": "Attributable creation time in UTC."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "OBSERVED",
        "SYNTHETIC"
      ],
      "description": "Evidence origin, not an authority status."
    },
    "schema_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Exact manifest hash of the schema bundle."
    },
    "producer": {
      "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/Producer",
      "description": "Actual attributed producer and execution boundary."
    },
    "policy_ref": {
      "allOf": [
        {
          "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
        },
        {
          "properties": {
            "record_type": {
              "enum": [
                "agtxiv.v3.authority-policy/0.0.0"
              ]
            }
          }
        }
      ],
      "description": "Exact authority policy binding."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
      },
      "maxItems": 10000,
      "description": "Explicit exact inputs used to construct this record."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "description": "Canonical record hash excluding this one field only."
    },
    "payload": {
      "type": "object",
      "properties": {
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Exact affected targets."
        },
        "kind": {
          "type": "string",
          "enum": [
            "MISSING_SOURCE",
            "UNPROVED_LEMMA",
            "SCOPE_AMBIGUITY",
            "ALIGNMENT_GAP",
            "MODEL_ASSUMPTION",
            "DATA_MISSING",
            "CONFLICT",
            "ENVIRONMENT",
            "RESOURCE_LIMIT"
          ],
          "description": "Type of unresolved boundary."
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "source_fidelity",
              "mathematical_correctness",
              "formal_alignment",
              "semantic_applicability",
              "empirical_support",
              "computational_reproducibility"
            ]
          },
          "maxItems": 10000,
          "minItems": 1,
          "description": "Applicable affected axes."
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "Concrete unresolved issue."
        },
        "next_evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "What could resolve or narrow the issue."
        },
        "attempt_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "properties": {
                  "record_type": {
                    "enum": [
                      "agtxiv.v3.work-attempt/0.0.0"
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 10000,
          "description": "Exact previous attempts."
        },
        "state": {
          "type": "string",
          "enum": [
            "OPEN",
            "BLOCKED",
            "DEFERRED",
            "RESOLVED",
            "SUPERSEDED"
          ],
          "description": "Frontier lifecycle, preserving history."
        },
        "resolution_refs": {
          "type": "array",
          "items": {
            "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 10000,
          "description": "Evidence when resolved or superseded."
        }
      },
      "required": [
        "target_refs",
        "kind",
        "axes",
        "statement",
        "next_evidence",
        "attempt_refs",
        "state",
        "resolution_refs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "revision",
    "created_at",
    "data_class",
    "schema_bundle_hash",
    "producer",
    "policy_ref",
    "input_refs",
    "content_hash",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "state": {
                "enum": [
                  "RESOLVED",
                  "SUPERSEDED"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "resolution_refs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
