 "payload": {
  "approximation_error": "",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "$\\mathcal{Z}_\\beta(\\psi)=e^{-\\beta}d_n^2\\,\\mathbb{E}_{x\\sim d\\mu_\\psi}[\\cosh(\\beta x)]$, the Pauli-density form of the SPF"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "Markov's inequality applied to $1-x^4$ under $d\\mu_\\psi$"
   },
   {
    "condition_id": "assumption:a3",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "$p\\mapsto\\cosh(\\beta\\epsilon)(1-p)+p$ is decreasing in $p$, so replacing $p_\\epsilon$ by its upper bound preserves the lower bound"
   }
  ],
  "claim_ref": {
   "content_hash": "sha256:b0f8f5612e16f3594f8a19e47ee1d19b4bff054462ce1ae6a316aa40e29ae5d6",
   "record_id": "claim:opus5-2608.14798v1/c36",
   "record_type": "agtxiv.v3.scientific-claim/0.0.0",
   "revision": 1
  },
  "component_ids": [
   "comp:bound"
  ],
  "conclusion": "$\\mathcal{Z}_{\\beta}(\\psi)\\geq\\sup_{\\epsilon\\in[0,1)}e^{-\\beta}d_n^{2}\\left[\\cosh(|\\beta|\\epsilon)(1-f_{\\epsilon}(\\psi))+f_{\\epsilon}(\\psi)\\right]$, $f_{\\epsilon}(\\psi)=\\dfrac{1-2^{-M_{2}(\\psi)-n}}{1-\\epsilon^{4}}$.",
  "definition_refs": [
   {
    "content_hash": "sha256:25570ca9d76dba9ce2ede37ad0830435a435d4f94bf0861893df91243ce438e8",
    "record_id": "definition:opus5-2608.14798v1/spf",
    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:5f73a4eab43c4aa44fb0c8af771c46142c21a7cd2b1029cb4c484f5962a1e6c2",
    "record_id": "definition:opus5-2608.14798v1/pauli-density",
    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:40e760480e8adb7172a32672597ce4a13f39220274ba14abe625384514d807b8",
    "record_id": "definition:opus5-2608.14798v1/sre",
    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   }
  ],
  "exactness": "EXACT",
  "normalization": "the bound is on the unnormalized SPF; $f_\\epsilon$ can exceed 1 for $\\epsilon$ close to 1, in which case the bracket is weaker than the trivial bound and the source does not restrict $\\epsilon$ to exclude this",
  "objects": [
   {
    "convention": "sum over the full multiset ${\\rm Spec}(\\psi)$ including the identity Pauli; $\\mathcal{Z}_0=d_n^2$",
