 "payload": {
  "approximation_error": "",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "faithfulness of $\\mathcal{W}_\\beta$ plus the tighter continuity estimate of Lemma (Continuity of the Stabilizer Work)"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "the right-hand side is independent of which stabilizer state is used, so maximizing over ${\\rm STAB}$ is legitimate"
   },
   {
    "condition_id": "assumption:a3",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [],
    "statement": "$\\|\\psi-\\phi\\|_1=2\\sqrt{1-|\\braket{\\phi|\\psi}|^2}$ for pure states"
   }
  ],
  "claim_ref": {
   "content_hash": "sha256:8096d57883116ee1e372a5fcc43b9d698e8973bdb9a6bed0ca7fbf2c0bede9f2",
   "record_id": "claim:opus5-2608.14798v1/c27",
   "record_type": "agtxiv.v3.scientific-claim/0.0.0",
   "revision": 1
  },
  "component_ids": [
   "comp:ub"
  ],
  "conclusion": "$F_{\\rm Stab}(\\psi)\\leq1-\\tfrac12\\left(\\dfrac{\\cosh\\beta-1}{\\beta\\sinh\\beta}\\,2^{-\\mathcal{W}_{\\beta}(\\psi)}\\mathcal{W}_{\\beta}(\\psi)\\right)^{2}$ for every $\\beta\\geq0$.",
  "definition_refs": [
   {
