      "record_type": "agtxiv.v3.definition/0.0.0",
      "revision": 1
     }
    ],
    "object_type": "real-valued functional of a pure state for each real beta",
    "symbol": "\\mathcal{W}_\\beta(\\psi)",
    "unit": "bits"
   },
   {
    "convention": "maximization over all n-qubit pure stabilizer states; imported from Bravyi et al. (2019)",
    "definition_refs": [
     {
      "content_hash": "sha256:d095d05bf8b5ef057a06a2a67dda6e979fb0a0aaebcd37ed80110a4e6ba5bd47",
