    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   }
  ],
  "exactness": "EXACT",
  "normalization": "$\\log$ base 2 in $\\mathcal{W}$ and the factor $2^{-\\mathcal{W}_\\beta}$; the same base-of-logarithm question flagged for the continuity constant propagates here",
  "objects": [
   {
    "convention": "free-energy difference of the Pauli gas referenced to the unique stabilizer value; $\\log$ base 2",
    "definition_refs": [
     {
      "content_hash": "sha256:ca78393034989fbb3506e02bf1963e93e318615f72c1e7bdf55d4e7e9061a385",
