 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the stabilizer work $\\mathcal{W}_\\beta$ built from the core SPF",
  "components": [
   {
    "component_id": "comp:shared",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:b6610ec263d7e67a2e112b3608701e061547b49619d64a5102c9e45f7a904e63",
      "record_id": "span:opus5-2608.14798v1/unfiltered-work",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathfrak{u}_\\beta$ is faithful, Clifford invariant and sub-additive."
   },
   {
    "component_id": "comp:fails",
    "role": "LIMITATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:b6610ec263d7e67a2e112b3608701e061547b49619d64a5102c9e45f7a904e63",
      "record_id": "span:opus5-2608.14798v1/unfiltered-work",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathfrak{u}_\\beta$ does not always decrease under partial trace for all $\\beta$; this is the stated reason for filtering."
   },
   {
    "component_id": "comp:theorem",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:69561d158fad45a479f0650861047d456f88910b4dae3aeda48e7c14939cab64",
      "record_id": "span:opus5-2608.14798v1/subadd-supporting",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Supporting inequality on reweighted moment vectors, proved via the monotone reweighting lemma applied twice."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:sep",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:b6610ec263d7e67a2e112b3608701e061547b49619d64a5102c9e45f7a904e63",
      "record_id": "span:opus5-2608.14798v1/unfiltered-work",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the sub-additivity statement is for separable pure states across an $A|B$ cut"
   },
   {
    "condition_id": "cond:vectors",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:b6610ec263d7e67a2e112b3608701e061547b49619d64a5102c9e45f7a904e63",
      "record_id": "span:opus5-2608.14798v1/unfiltered-work",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the supporting theorem assumes $a,b$ non-increasing with the stated first two entries"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:b6610ec263d7e67a2e112b3608701e061547b49619d64a5102c9e45f7a904e63",
    "record_id": "span:opus5-2608.14798v1/unfiltered-work",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:69561d158fad45a479f0650861047d456f88910b4dae3aeda48e7c14939cab64",
    "record_id": "span:opus5-2608.14798v1/subadd-supporting",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Defining a stabilizer-work-like function from the unfiltered SPF instead of the core SPF gives the 'unfiltered stabilizer work' $\\mathfrak{u}_\\beta$, which shares faithfulness, Clifford invariance and sub-additivity, but which 'does not always decrease under partial trace for all values of $\\beta$'. Sub-additivity of $\\mathfrak{u}_\\beta$ is proved through a supporting theorem: for non-increasing vectors $a,b$ with $a_0=d_A^2$, $b_0=d_B^2$, $a_1=d_A$, $b_1=d_B$, $a_{k>1}\\leq a_1$, $b_{k>1}\\leq b_1$ and $w_k=x^{2k}/(2k)!$ summing to $c=\\cosh x$, $\\frac{\\sum_kw_ka_kb_k}{(\\sum_kw_ka_k)(\\sum_kw_kb_k)}\\geq\\frac{d_Ad_B+c-1}{(d_A+c-1)(d_B+c-1)}$.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
