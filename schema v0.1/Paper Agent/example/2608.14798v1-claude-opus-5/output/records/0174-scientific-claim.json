     }
    ],
    "text": "Closed form for $\\mathcal{Z}_\\beta(\\ket{T}^{\\otimes n})$."
   },
   {
    "component_id": "comp:general",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:3b252be88dfa26e18b84a301d7ea5e4a3b1022f107cbccb534ecf98501462a1a",
      "record_id": "span:opus5-2608.14798v1/ncopy",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Closed form for $\\mathcal{Z}_\\beta(\\ket{\\psi}^{\\otimes n})$, arbitrary single-qubit $\\ket{\\psi}$."
   },
   {
    "component_id": "comp:sep",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:0234dbcc4f7c789473eb674b3ffd3fd980b165f11e74a43d70803d0a8df84ad9",
      "record_id": "span:opus5-2608.14798v1/tstate",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{Z}_\\beta(\\ket{T}^{\\otimes n})<\\mathcal{Z}_\\beta({\\rm STAB}_n)$ for every $\\beta\\neq0$; equality only at $\\beta=0$."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:product",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:0234dbcc4f7c789473eb674b3ffd3fd980b165f11e74a43d70803d0a8df84ad9",
      "record_id": "span:opus5-2608.14798v1/tstate",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the state is a tensor power of a single-qubit pure state"
   },
   {
    "condition_id": "cond:tvals",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:0234dbcc4f7c789473eb674b3ffd3fd980b165f11e74a43d70803d0a8df84ad9",
      "record_id": "span:opus5-2608.14798v1/tstate",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\braket{T|X|T}=\\braket{T|Y|T}=1/\\sqrt2$ and $\\braket{T|Z|T}=0$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:0234dbcc4f7c789473eb674b3ffd3fd980b165f11e74a43d70803d0a8df84ad9",
    "record_id": "span:opus5-2608.14798v1/tstate",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:3b252be88dfa26e18b84a301d7ea5e4a3b1022f107cbccb534ecf98501462a1a",
    "record_id": "span:opus5-2608.14798v1/ncopy",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Proposition: $\\mathcal{Z}_\\beta(\\ket{T}^{\\otimes n})=e^{-\\beta}[(4^n-3^n)+\\sum_{k=0}^{n}\\binom{n}{k}2^k\\cosh(\\beta2^{-k/2})]$. Theorem ($n$-copy SPF) generalizes this to $n$ copies of an arbitrary single-qubit pure state via $V_\\psi[\\vec n]=\\prod_{\\sigma}\\braket{\\sigma}^{n_\\sigma}$. At $\\beta=0$ the SPF is insensitive to magic ($\\mathcal{Z}_0=4^n$), while for every $\\beta\\neq0$ it separates $\\ket{T}^{\\otimes n}$ from stabilizer states.",
  "system": "product states $\\bigotimes_{l=1}^{n}\\ket{\\psi_l}$ of single-qubit pure states; magic without entanglement across any cut"
 },
