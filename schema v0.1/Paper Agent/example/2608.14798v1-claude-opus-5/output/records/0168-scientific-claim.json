 ],
 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "direct estimation of a single stabilizer Renyi entropy by Bell sampling, and the $\\mathcal{O}(k^2n)$ runtime of running the moment estimator once per moment",
  "components": [
   {
    "component_id": "comp:informal",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:140fa41cd1735581c43efaf4e13983900049e88707d56dcf2c5b17f4bdca36a1",
      "record_id": "span:opus5-2608.14798v1/computability",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Truncated SPF is estimable with the Bell-sampling primitive at additive error $\\epsilon$, failure probability $\\delta$."
   },
   {
    "component_id": "comp:onepass",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:140fa41cd1735581c43efaf4e13983900049e88707d56dcf2c5b17f4bdca36a1",
      "record_id": "span:opus5-2608.14798v1/computability",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     },
     {
      "content_hash": "sha256:dff62dc1515724a235a341896f0c7c76dd506cfd5a0c36be9d70b64b993c1f6d",
      "record_id": "span:opus5-2608.14798v1/sampling-alg",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "A single run with extra classical memory yields all even moments up to order $2k$, reducing classical runtime from $\\mathcal{O}(k^2n)$ to $\\mathcal{O}(kn)$."
   },
   {
    "component_id": "comp:beta-free",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:140fa41cd1735581c43efaf4e13983900049e88707d56dcf2c5b17f4bdca36a1",
      "record_id": "span:opus5-2608.14798v1/computability",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     },
     {
      "content_hash": "sha256:dff62dc1515724a235a341896f0c7c76dd506cfd5a0c36be9d70b64b993c1f6d",
      "record_id": "span:opus5-2608.14798v1/sampling-alg",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The sampling primitive is independent of $\\beta$; $\\beta$ enters only in classical post-processing, while accuracy and sample complexity depend on $\\beta,\\epsilon,\\delta$ and the truncation error."
   },
   {
    "component_id": "comp:samples",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:145ba53dec81c6bd19a41f2c953371f017f9df68076c9e98837208ce54d20362",
      "record_id": "span:opus5-2608.14798v1/estimator-bounds",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{N}=\\mathcal{O}(\\cosh^2\\beta\\,e^{-2\\beta}\\epsilon^{-2}\\log(1/\\delta))$ for the normalized truncation (Hoeffding on $|X_\\alpha|\\leq\\cosh\\beta$)."
   },
   {
    "component_id": "comp:full",
    "role": "APPROXIMATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:2788ba66621fee77f01194dc7da56936f9fab0f510ec5f9b428999d7298a0016",
      "record_id": "span:opus5-2608.14798v1/estimator-conc",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Full normalized SPF at additive $\\epsilon$ requires $\\epsilon>\\Delta(\\beta,k)$ and costs $\\mathcal{O}(\\cosh^2\\beta\\,e^{-2\\beta}(\\epsilon-\\Delta(\\beta,k))^{-2}\\log(1/\\delta))$."
   },
   {
    "component_id": "comp:abstract",
    "role": "LIMITATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:70a0f2d15b2b6a97f4d6941d6eefaa4af275e30088e7ed19441a3419c6cc53c0",
      "record_id": "span:opus5-2608.14798v1/abstract",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The abstract and discussion state without qualification that the SPF and stabilizer work are 'efficiently estimable via Bell sampling'."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:norm",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:140fa41cd1735581c43efaf4e13983900049e88707d56dcf2c5b17f4bdca36a1",
      "record_id": "span:opus5-2608.14798v1/computability",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the guarantee is an additive-error guarantee on the NORMALIZED quantity $d_n^{-1}\\mathcal{Z}_\\beta(\\psi)$, not on $\\mathcal{Z}_\\beta(\\psi)$ itself"
   },
   {
    "condition_id": "cond:trunc",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:140fa41cd1735581c43efaf4e13983900049e88707d56dcf2c5b17f4bdca36a1",
      "record_id": "span:opus5-2608.14798v1/computability",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the full-SPF statement requires $\\epsilon>\\Delta(\\beta,k)$ with $\\Delta(\\beta,k)=d_ne^{-\\beta}(\\cosh\\beta-\\sum_{l=0}^{k}\\beta^{2l}/(2l)!)$"
   },
   {
    "condition_id": "cond:copies",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [
     {
      "content_hash": "sha256:140fa41cd1735581c43efaf4e13983900049e88707d56dcf2c5b17f4bdca36a1",
      "record_id": "span:opus5-2608.14798v1/computability",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "each outer sample consumes two copies for Bell sampling plus $2k$ further copies of $\\ket{\\psi}$ for the inner moment loop"
   },
   {
    "condition_id": "cond:fixed",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:140fa41cd1735581c43efaf4e13983900049e88707d56dcf2c5b17f4bdca36a1",
      "record_id": "span:opus5-2608.14798v1/computability",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$k$ and $\\beta$ are held fixed in the informal statement"
   }
  ],
  "modality": "CONDITIONAL",
  "source_span_refs": [
   {
    "content_hash": "sha256:140fa41cd1735581c43efaf4e13983900049e88707d56dcf2c5b17f4bdca36a1",
    "record_id": "span:opus5-2608.14798v1/computability",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
