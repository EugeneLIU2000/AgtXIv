 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the non-invariant Pauli spectrum itself",
  "components": [
   {
    "component_id": "comp:inv",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:af7cd0ef1b75d0e6e960e3274623cbcf7f57cb59e2de23be8708688cd2d28601",
      "record_id": "span:opus5-2608.14798v1/clifford-inv",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{Z}_\\beta$ is invariant under Clifford unitaries."
   },
   {
    "component_id": "comp:uniq",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:acef9bc0dfca6e579f0bb2ecf06e74838313ba1a85fe7ebb570b3574cb269abc",
      "record_id": "span:opus5-2608.14798v1/uniqueness",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{Z}_\\beta(\\phi)=e^{-\\beta}[(d_n^2-d_n)+d_n\\cosh\\beta]$ for every pure stabilizer state."
   },
   {
    "component_id": "comp:faithful",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:acef9bc0dfca6e579f0bb2ecf06e74838313ba1a85fe7ebb570b3574cb269abc",
      "record_id": "span:opus5-2608.14798v1/uniqueness",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Uniqueness is read as the SPF being 'faithful under free operations (Clifford unitaries)'."
   },
   {
    "component_id": "comp:cspf-ext",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:acef9bc0dfca6e579f0bb2ecf06e74838313ba1a85fe7ebb570b3574cb269abc",
      "record_id": "span:opus5-2608.14798v1/uniqueness",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Both properties extend to the core SPF, with $\\mathcal{Z}^c_\\beta({\\rm STAB}_n)=e^{-\\beta}d_n(\\cosh\\beta-1)$."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:clifford",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:af7cd0ef1b75d0e6e960e3274623cbcf7f57cb59e2de23be8708688cd2d28601",
      "record_id": "span:opus5-2608.14798v1/clifford-inv",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\mathcal{C}\\in\\mathcal{C}l_n$"
   },
   {
    "condition_id": "cond:pure-stab",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:af7cd0ef1b75d0e6e960e3274623cbcf7f57cb59e2de23be8708688cd2d28601",
      "record_id": "span:opus5-2608.14798v1/clifford-inv",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the uniqueness statement is for pure stabilizer states"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:af7cd0ef1b75d0e6e960e3274623cbcf7f57cb59e2de23be8708688cd2d28601",
    "record_id": "span:opus5-2608.14798v1/clifford-inv",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:acef9bc0dfca6e579f0bb2ecf06e74838313ba1a85fe7ebb570b3574cb269abc",
    "record_id": "span:opus5-2608.14798v1/uniqueness",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Proposition (Invariance): $\\mathcal{Z}_\\beta(\\mathcal{C}(\\psi))=\\mathcal{Z}_\\beta(\\psi)$ for all $\\mathcal{C}\\in\\mathcal{C}l_n$. Proposition (Uniqueness): for any $\\ket{\\phi}\\in{\\rm Stab}_n$, $\\mathcal{Z}_\\beta(\\phi)=\\mathcal{Z}_\\beta({\\rm STAB}_n)=e^{-\\beta}[(d_n^2-d_n)+d_n\\cosh\\beta]$. The paper reads uniqueness as faithfulness of the SPF under free operations.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
