   "revision": 1
  },
  "component_ids": [
   "comp:thm"
  ],
  "conclusion": "$\\mathcal{Z}_{\\beta}({\\rm SPS})=e^{-\\beta}\\left[\\tfrac{(d_{n}-1)(d_{n}+2)}{2}+\\cosh\\beta+\\tfrac{d_{n}(d_{n}-1)}{2}\\left(\\cosh\\!\\left(\\tfrac{2\\beta}{d_{n}}\\right)\\right)^{d_{n}/2}\\right]$.",
  "definition_refs": [
   {
