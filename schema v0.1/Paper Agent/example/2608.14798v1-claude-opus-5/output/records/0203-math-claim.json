 "payload": {
  "approximation_error": "",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "$|S|=2^n$, so $S=\\{0,1\\}^n$ and the average is over the pseudorandom function $f$ only"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "the proof rests on exact evaluation of the Pauli-spectrum moments of SPS, deferred to the supplement"
   }
  ],
  "claim_ref": {
   "content_hash": "sha256:11ca0a509ab8747696aa02197deba3486040354ea77b35c07c07d0c59f4fe182",
