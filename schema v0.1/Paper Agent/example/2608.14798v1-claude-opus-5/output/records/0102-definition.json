 "payload": {
  "name": "Pauli spectrum Spec(psi)",
  "objects": [
   {
    "convention": "signed convention $\\tr(\\psi P)$, phase-free Pauli labels, global phases irrelevant",
    "definition_refs": [],
    "object_type": "multiset of $4^n$ reals in $[-1,1]$ indexed by $\\mathcal{P}_n$",
    "symbol": "{\\rm Spec}(\\psi)",
    "unit": ""
   },
   {
    "convention": "Pauli operators taken modulo phase when used as labels",
    "definition_refs": [],
    "object_type": "phase-free $n$-qubit Pauli strings $\\mathcal{P}_1^{\\otimes n}$, $|\\mathcal{P}_n|=4^n$",
    "symbol": "\\mathcal{P}_n",
    "unit": ""
   }
  ],
  "origin": "SOURCE",
  "source_span_refs": [
   {
    "content_hash": "sha256:3ccd1efb3febdd029daa4e32124fa438b78f84c07e92ce47a891df10007fea54",
    "record_id": "span:opus5-2608.14798v1/pauli-spec-def",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:c6cc2e17188966d77809da7c2fe46b65b4efeb7e50c1825da6e269071e850014",
    "record_id": "span:opus5-2608.14798v1/signed-convention",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "For an $n$-qubit pure state $\\ket{\\psi}$, ${\\rm Spec}(\\psi):=\\{\\tr(\\psi P)\\ \\text{for}\\ P\\in\\mathcal{P}_n\\}$, a collection of $4^n$ real numbers indexed by the phase-free Pauli strings. The paper keeps the sign of each expectation value (rather than $|\\tr(\\psi P)|$ as in Beverland et al.) and states in a footnote that Spec should strictly be read as a multiset because multiplicities matter."
 },
