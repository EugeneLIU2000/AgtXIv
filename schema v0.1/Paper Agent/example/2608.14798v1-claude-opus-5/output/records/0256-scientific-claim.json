 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the full signed, labelled Pauli spectrum ${\\rm Spec}(\\psi)$ of Definition (Pauli Spectrum)",
  "components": [
   {
    "component_id": "comp:lossy",
    "role": "LIMITATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:c92ef37f105471ccf73c20580ac9a3a2501fec1f3a54d306a067e8ae9745dce0",
      "record_id": "span:opus5-2608.14798v1/spf-not-full-spectrum",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The map $\\psi\\mapsto\\mathcal{Z}_\\bullet(\\psi)$ is explicitly lossy: labels, signs and odd statistics are not recoverable."
   },
   {
    "component_id": "comp:sufficient",
    "role": "ASSUMPTION",
    "source_span_refs": [
     {
      "content_hash": "sha256:c92ef37f105471ccf73c20580ac9a3a2501fec1f3a54d306a067e8ae9745dce0",
      "record_id": "span:opus5-2608.14798v1/spf-not-full-spectrum",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "What survives is asserted to be 'the stabilizer-relevant information accessible through Pauli moments'."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:even",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [
     {
      "content_hash": "sha256:c92ef37f105471ccf73c20580ac9a3a2501fec1f3a54d306a067e8ae9745dce0",
      "record_id": "span:opus5-2608.14798v1/spf-not-full-spectrum",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "only even moments enter, since $\\cosh$ is an even function of $\\beta x$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:c92ef37f105471ccf73c20580ac9a3a2501fec1f3a54d306a067e8ae9745dce0",
    "record_id": "span:opus5-2608.14798v1/spf-not-full-spectrum",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "The SPF does not retain the full labelled Pauli spectrum; instead it packages the spectrum's Clifford-invariant EVEN statistics into an analytic object, thereby capturing the stabilizer-relevant information accessible through Pauli moments.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
