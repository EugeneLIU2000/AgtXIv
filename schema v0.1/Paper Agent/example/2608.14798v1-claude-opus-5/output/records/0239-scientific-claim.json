 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "$M_{\\alpha=2}$ along the same curve, and the STO-3G versus 6-31G comparison",
  "components": [
   {
    "component_id": "comp:peak",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:ecc50eb7a5c18b6a97fa89acbfaab67405bb09312f6666678f2d7f852999469a",
      "record_id": "span:opus5-2608.14798v1/h2-findings",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Pronounced magic peak in the strongly correlated region in both bases."
   },
   {
    "component_id": "comp:beta",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:ecc50eb7a5c18b6a97fa89acbfaab67405bb09312f6666678f2d7f852999469a",
      "record_id": "span:opus5-2608.14798v1/h2-findings",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\beta$ acts as a resolution knob: small $\\beta$ coarse and smooth, large $\\beta$ sharp and tracking $M_2$."
   },
   {
    "component_id": "comp:caveat",
    "role": "LIMITATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:f66f78e19e5c1f4da3eb8e0e682631429cef358f0d8f2540e9e19c50edeeb86e",
      "record_id": "span:opus5-2608.14798v1/h2-setup",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     },
     {
      "content_hash": "sha256:ecc50eb7a5c18b6a97fa89acbfaab67405bb09312f6666678f2d7f852999469a",
      "record_id": "span:opus5-2608.14798v1/h2-findings",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Explicit refusal to draw physical conclusions; dissociation-limit decay is a minimal-basis artifact."
   },
   {
    "component_id": "comp:reversal",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:faebabe7376215ad023dfc646ff0b85f4e44cce810f4230b8458e80054d98c0e",
      "record_id": "span:opus5-2608.14798v1/h2-631g",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "In 6-31G the geometry ordering between $R=0.5$ and $R=6$ bohr reverses relative to STO-3G."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:basis",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:f66f78e19e5c1f4da3eb8e0e682631429cef358f0d8f2540e9e19c50edeeb86e",
      "record_id": "span:opus5-2608.14798v1/h2-setup",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "results are basis-set and fermion-to-qubit-encoding dependent; neither basis approaches the complete-basis-set limit"
   },
   {
    "condition_id": "cond:method",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:f66f78e19e5c1f4da3eb8e0e682631429cef358f0d8f2540e9e19c50edeeb86e",
      "record_id": "span:opus5-2608.14798v1/h2-setup",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "ground states obtained by exact diagonalization (full CI within basis) of the Jordan-Wigner Hamiltonian"
   },
   {
    "condition_id": "cond:betavals",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:f66f78e19e5c1f4da3eb8e0e682631429cef358f0d8f2540e9e19c50edeeb86e",
      "record_id": "span:opus5-2608.14798v1/h2-setup",
