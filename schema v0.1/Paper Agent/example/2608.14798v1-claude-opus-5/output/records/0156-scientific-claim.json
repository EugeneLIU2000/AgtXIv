 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "discontinuous or unstable magic measures",
  "components": [
   {
    "component_id": "comp:bound",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:58a8dabb55cc6e16cf8ade6a350163c7dd0cbefb2f0ab2165005ebccd2c7a16d",
      "record_id": "span:opus5-2608.14798v1/lipschitz",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$|\\mathcal{Z}_\\beta(\\psi)-\\mathcal{Z}_\\beta(\\phi)|\\leq e^{-\\beta}d_n\\beta\\sinh\\beta\\,\\|\\psi-\\phi\\|_1$."
   },
   {
    "component_id": "comp:symmetry",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:58a8dabb55cc6e16cf8ade6a350163c7dd0cbefb2f0ab2165005ebccd2c7a16d",
      "record_id": "span:opus5-2608.14798v1/lipschitz",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\beta\\sinh\\beta$ carries the $\\mathbb{Z}_2$ symmetry $\\beta\\to-\\beta$ while the prefactor reflects the energy shift in the definition."
   },
   {
    "component_id": "comp:robust",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:58a8dabb55cc6e16cf8ade6a350163c7dd0cbefb2f0ab2165005ebccd2c7a16d",
      "record_id": "span:opus5-2608.14798v1/lipschitz",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Robustness is presented as a physical requirement, not merely a convenient bound."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:pure2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:58a8dabb55cc6e16cf8ade6a350163c7dd0cbefb2f0ab2165005ebccd2c7a16d",
      "record_id": "span:opus5-2608.14798v1/lipschitz",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\ket{\\phi},\\ket{\\psi}$ are $n$-qubit pure states"
   },
   {
    "condition_id": "cond:proof",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:58a8dabb55cc6e16cf8ade6a350163c7dd0cbefb2f0ab2165005ebccd2c7a16d",
      "record_id": "span:opus5-2608.14798v1/lipschitz",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the proof is deferred to the supplemental material and is based on the Clifford-orbit representation"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:58a8dabb55cc6e16cf8ade6a350163c7dd0cbefb2f0ab2165005ebccd2c7a16d",
    "record_id": "span:opus5-2608.14798v1/lipschitz",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Theorem (Lipschitz property): for two $n$-qubit pure states, $|\\mathcal{Z}_\\beta(\\psi)-\\mathcal{Z}_\\beta(\\phi)|\\leq L_n(\\beta)\\|\\psi-\\phi\\|_1$ with $L_n(\\beta)=e^{-\\beta}d_n\\beta\\sinh\\beta$. The paper reads this as guaranteeing that the SPF, and hence the magic monotone built from it, is robust under small perturbations.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
