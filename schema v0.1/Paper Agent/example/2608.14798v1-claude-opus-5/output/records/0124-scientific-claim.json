 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "Clifford-invariant functionals such as $M_\\alpha$ and (later) the SPF",
  "components": [
   {
    "component_id": "comp:noninv",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:abfe3d40a729be6897bcdb38e4329e492030f16a49f1353ca0dd4fa5bf424e97",
      "record_id": "span:opus5-2608.14798v1/clifford-noninvariance",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "${\\rm Spec}(\\psi)\\neq{\\rm Spec}(\\mathcal{C}(\\psi))$ in general."
   },
   {
    "component_id": "comp:action",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:abfe3d40a729be6897bcdb38e4329e492030f16a49f1353ca0dd4fa5bf424e97",
      "record_id": "span:opus5-2608.14798v1/clifford-noninvariance",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The action is by permutation and/or sign flip of spectrum entries."
   },
   {
    "component_id": "comp:readoff",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:abfe3d40a729be6897bcdb38e4329e492030f16a49f1353ca0dd4fa5bf424e97",
      "record_id": "span:opus5-2608.14798v1/clifford-noninvariance",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The stabilizer-group size is invariant and readable from the count of $|x|=1$ entries."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:clifford",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:abfe3d40a729be6897bcdb38e4329e492030f16a49f1353ca0dd4fa5bf424e97",
      "record_id": "span:opus5-2608.14798v1/clifford-noninvariance",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\mathcal{C}\\in\\mathcal{C}l_n$ acts by conjugation"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:abfe3d40a729be6897bcdb38e4329e492030f16a49f1353ca0dd4fa5bf424e97",
    "record_id": "span:opus5-2608.14798v1/clifford-noninvariance",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "The Pauli spectrum is not invariant under general Clifford unitaries: Clifford conjugation may permute spectrum entries and flip their signs. For stabilizer states this permutes and sign-changes the $\\pm1$ entries while leaving the stabilizer-group size unchanged, so $|{\\rm Stab}(\\psi)|$ can be read off by counting entries with $|x|=1$.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
