    "record_id": "span:opus5-2608.14798v1/sps-thm",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:38b1b34d7c8c0569a53f46c711a837d9566a023ff4f96f5c62535b3488d4408a",
    "record_id": "span:opus5-2608.14798v1/sps-nullity",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:62aaf6dafe3043b7b461e25b2507e70e64ac88d70cf9d43d265939d08a6a8e6e",
    "record_id": "span:opus5-2608.14798v1/sps-random-f",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:d01b2baed2e65d02799b780b5effd7ee89a052352d8950d593296b03b9fb4c08",
    "record_id": "span:opus5-2608.14798v1/sps-numerics",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Theorem (SPF for pseudomagic states): for an $n$-qubit SPS sampled uniformly with $|S|=2^n$, $\\mathcal{Z}_\\beta({\\rm SPS})=e^{-\\beta}[\\frac{(d_n-1)(d_n+2)}{2}+\\cosh\\beta+\\frac{d_n(d_n-1)}{2}(\\cosh(2\\beta/d_n))^{d_n/2}]$. The paper adds that stabilizer nullity cannot quantify pseudomagic, since SPS and Haar states both have $\\nu=\\mathcal{O}(n)$, and that the SPF curves of the two families become exponentially close so that distinguishing them is challenging, as it must be for a cryptographic construction.",
  "system": "subset phase states $\\ket{\\psi_{f,S}}$ with pseudorandom $f$ and $S=\\{0,1\\}^n$"
 },
