 ],
 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "$M_\\alpha$ at fixed $\\alpha$ (monotone only for $\\alpha\\geq2$) and the stabilizer nullity",
  "components": [
   {
    "component_id": "comp:faithful",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:27d08981b9804fda5a2df6730eceb11109880c07fabf0b7c0d544663befdbc52",
      "record_id": "span:opus5-2608.14798v1/sw-props",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{W}_\\beta(\\psi_A)=0\\iff\\psi_A\\in{\\rm STAB}_A$, from uniqueness of the cSPF on stabilizer states."
   },
   {
    "component_id": "comp:clifford",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:27d08981b9804fda5a2df6730eceb11109880c07fabf0b7c0d544663befdbc52",
      "record_id": "span:opus5-2608.14798v1/sw-props",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Clifford invariance, from invariance of the SPF."
   },
   {
    "component_id": "comp:subadd",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:923a82717900c72675af88b887c9989accd48a4cbd63c5aecd0beacd07018033",
      "record_id": "span:opus5-2608.14798v1/sw-subadd",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{W}_\\beta(\\psi_A\\otimes\\chi_B)\\leq\\mathcal{W}_\\beta(\\psi_A)+\\mathcal{W}_\\beta(\\chi_B)$, from cSPF supermultiplicativity."
   },
   {
    "component_id": "comp:discard",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:923a82717900c72675af88b887c9989accd48a4cbd63c5aecd0beacd07018033",
      "record_id": "span:opus5-2608.14798v1/sw-subadd",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{W}_\\beta(\\psi_A\\otimes\\chi_B)\\geq\\mathcal{W}_\\beta(\\psi_A)$, with equality iff the discarded subsystem is a stabilizer state, established from $b_k\\leq d_B$."
   },
   {
    "component_id": "comp:monotone",
    "role": "LIMITATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:70a0f2d15b2b6a97f4d6941d6eefaa4af275e30088e7ed19441a3419c6cc53c0",
      "record_id": "span:opus5-2608.14798v1/abstract",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The abstract, the introduction and the discussion call $\\mathcal{W}_\\beta$ a magic monotone at every temperature."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:pure",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:fdf6ddb62edcbede823cc4596aebeaab7afb321f33954b252d51b4c28a20bfd0",
      "record_id": "span:opus5-2608.14798v1/sw-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "restricted to pure states and to the class $\\mathcal{F}$ of deterministic pure-state stabilizer protocols"
   },
   {
    "condition_id": "cond:beta",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [
     {
      "content_hash": "sha256:fdf6ddb62edcbede823cc4596aebeaab7afb321f33954b252d51b4c28a20bfd0",
      "record_id": "span:opus5-2608.14798v1/sw-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "'for every value of its parameter' in the abstract; the properties list does not state a $\\beta$ range and $\\mathcal{W}_0\\equiv0$ by construction"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:fdf6ddb62edcbede823cc4596aebeaab7afb321f33954b252d51b4c28a20bfd0",
