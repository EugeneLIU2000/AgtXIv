      "revision": 1
     }
    ],
    "object_type": "real function $\\mathbb{R}\\times\\mathcal{H}\\to\\mathbb{R}$",
    "symbol": "\\mathcal{Z}_\\beta(\\psi)",
    "unit": ""
   },
   {
    "convention": "$\\mathbf{m}_k=(d_n^{-1}\\sum x^2,\\dots,d_n^{-1}\\sum x^{2k})$",
    "definition_refs": [
     {
