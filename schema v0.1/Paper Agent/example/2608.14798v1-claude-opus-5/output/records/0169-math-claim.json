    "record_id": "definition:opus5-2608.14798v1/truncated-spf",
    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   }
  ],
  "exactness": "APPROXIMATE",
  "normalization": "all guarantees are for $d_n^{-1}\\mathcal{Z}$; since $\\mathcal{Z}_\\beta\\sim d_n^2$, a constant additive error on $d_n^{-1}\\mathcal{Z}$ is a relative error of order $2^{-n}$ on $\\mathcal{Z}$ but does NOT bound $\\mathcal{W}_\\beta$ without further argument",
  "objects": [
   {
    "convention": "sum over the full multiset ${\\rm Spec}(\\psi)$ including the identity Pauli; $\\mathcal{Z}_0=d_n^2$",
    "definition_refs": [
     {
      "content_hash": "sha256:25570ca9d76dba9ce2ede37ad0830435a435d4f94bf0861893df91243ce438e8",
