 "payload": {
  "approximation_error": "truncation floor $\\Delta(\\beta,k)=d_ne^{-\\beta}(\\cosh\\beta-\\sum_{l=0}^{k}\\beta^{2l}/(2l)!)$, which scales with $d_n=2^n$; the stated guarantee is vacuous unless $k$ is chosen large enough that $\\Delta(\\beta,k)<\\epsilon$, and the source does not give the resulting $k(n,\\beta,\\epsilon)$",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "each entry of the accumulated sign vector $\\mathbf{B}_k$ is $\\pm1$, giving $|X_\\alpha|\\leq\\cosh\\beta$ for Hoeffding"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "Bell sampling draws $P$ with probability $|\\langle P|\\eta\\rangle|^2$ and repeated eigenbasis measurements of that $P$ give unbiased even moments"
   },
   {
    "condition_id": "assumption:a3",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "the error is additive on $d_n^{-1}\\mathcal{Z}$, and $\\Delta(\\beta,k)$ itself carries a factor $d_n=2^n$"
   }
  ],
  "claim_ref": {
   "content_hash": "sha256:e70b99120bba246abaa260cfe325c8635d14cd17075530d2063901259f2c842a",
   "record_id": "claim:opus5-2608.14798v1/c14",
   "record_type": "agtxiv.v3.scientific-claim/0.0.0",
   "revision": 1
  },
  "component_ids": [
   "comp:samples",
   "comp:full"
  ],
  "conclusion": "${\\rm Pr}\\left(\\left|\\hat{\\mathcal{Z}}^{(k)}_{\\beta}(\\psi)-\\mathcal{Z}^{(k)}_{\\beta}(\\psi)\\right|/d_{n}\\geq\\epsilon\\right)\\leq2\\exp\\left(-\\mathcal{N}\\epsilon^{2}e^{2\\beta}/(2\\cosh^{2}\\beta)\\right)$, and for $\\epsilon>\\Delta(\\beta,k)$ the same bound with $\\epsilon\\mapsto\\epsilon-\\Delta(\\beta,k)$ controls $(\\mathcal{Z}_{\\beta}(\\psi)-\\hat{\\mathcal{Z}}^{(k)}_{\\beta}(\\psi))/d_{n}$.",
  "definition_refs": [
   {
    "content_hash": "sha256:25570ca9d76dba9ce2ede37ad0830435a435d4f94bf0861893df91243ce438e8",
    "record_id": "definition:opus5-2608.14798v1/spf",
    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   },
   {
