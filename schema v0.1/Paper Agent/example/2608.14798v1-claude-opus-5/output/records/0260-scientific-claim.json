 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the direct definition of $M_\\alpha$ from the Pauli-spectrum distribution $\\Xi(\\psi)$",
  "components": [
   {
    "component_id": "comp:formula",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:ea562a5d4a998d6b6ea458f918769b8a0e95c121a2d580ec031cea7efa32525b",
      "record_id": "span:opus5-2608.14798v1/moment-gf",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Differentiation formula recovering integer-index SREs from the SPF."
   },
   {
    "component_id": "comp:moments",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:ea562a5d4a998d6b6ea458f918769b8a0e95c121a2d580ec031cea7efa32525b",
      "record_id": "span:opus5-2608.14798v1/moment-gf",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\sum_x x^{2m}=\\partial^{2m}_\\beta e^{\\beta}\\mathcal{Z}_\\beta|_{\\beta\\to0}$, i.e. $e^{\\beta}\\mathcal{Z}_\\beta$ is the moment generating object."
   },
   {
    "component_id": "comp:limits",
    "role": "ASSUMPTION",
    "source_span_refs": [
     {
      "content_hash": "sha256:ea562a5d4a998d6b6ea458f918769b8a0e95c121a2d580ec031cea7efa32525b",
      "record_id": "span:opus5-2608.14798v1/moment-gf",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "'The exchange of the limits comes because the positivity of the SPF derivatives.'"
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:integer",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:ea562a5d4a998d6b6ea458f918769b8a0e95c121a2d580ec031cea7efa32525b",
      "record_id": "span:opus5-2608.14798v1/moment-gf",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\alpha\\in\\mathbb{N}$"
   },
   {
    "condition_id": "cond:alpha1",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [
     {
      "content_hash": "sha256:ea562a5d4a998d6b6ea458f918769b8a0e95c121a2d580ec031cea7efa32525b",
      "record_id": "span:opus5-2608.14798v1/moment-gf",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\alpha=1$ is excluded by the prefactor $1/(1-\\alpha)$; the source does not say so"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:ea562a5d4a998d6b6ea458f918769b8a0e95c121a2d580ec031cea7efa32525b",
    "record_id": "span:opus5-2608.14798v1/moment-gf",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Proposition (Stab Renyi from SPF): for integer $\\alpha$, $M_\\alpha(\\psi)=\\lim_{\\beta\\to0}\\frac{1}{1-\\alpha}\\log\\left(\\frac{1}{d_n}\\frac{\\partial^{2\\alpha}}{\\partial\\beta^{2\\alpha}}e^{\\beta}\\mathcal{Z}_\\beta(\\psi)\\right)$, because $\\sum_{x}x^{2m}=\\partial^{2m}_\\beta\\,e^{\\beta}\\mathcal{Z}_\\beta(\\psi)|_{\\beta\\to0}$; the exchange of limits is justified by positivity of the SPF derivatives.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
