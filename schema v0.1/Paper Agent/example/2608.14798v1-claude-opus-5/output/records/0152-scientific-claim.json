 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the direct Pauli-spectrum sum in Definition (SPF)",
  "components": [
   {
    "component_id": "comp:orbit",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:8f3f4ce629c8192d9af399faefa6a652aff5fef36fe60f04a165bb431d6f74fd",
      "record_id": "span:opus5-2608.14798v1/orbit-rep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Clifford-orbit representation via the orbit-stabilizer theorem."
   },
   {
    "component_id": "comp:twirl",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:8f3f4ce629c8192d9af399faefa6a652aff5fef36fe60f04a165bb431d6f74fd",
      "record_id": "span:opus5-2608.14798v1/orbit-rep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Expansion in Clifford $2k$-fold channels $\\Phi^{2k}_{\\mathcal{C}l_n}$ on $2k$ copies."
   },
   {
    "component_id": "comp:design",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:8f3f4ce629c8192d9af399faefa6a652aff5fef36fe60f04a165bb431d6f74fd",
      "record_id": "span:opus5-2608.14798v1/orbit-rep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Because Cliffords form a 2-design, the first genuinely state-dependent contribution appears beyond the second-moment sector."
   },
   {
    "component_id": "comp:renyi",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:c791ff205e456e4f33b8f0c0a1e14de07c3fedb5ea2b68a6b4cbcb23002d889f",
      "record_id": "span:opus5-2608.14798v1/renyi-rep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{Z}_\\beta(\\psi)=e^{-\\beta}[d_n^2+\\frac{d_n}{2}\\beta^2+\\sum_{k\\geq2}\\frac{\\beta^{2k}}{(2k)!}2^{n-(k-1)M_k(\\psi)}]$."
   },
   {
    "component_id": "comp:sampling",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:8f3f4ce629c8192d9af399faefa6a652aff5fef36fe60f04a165bb431d6f74fd",
      "record_id": "span:opus5-2608.14798v1/orbit-rep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The orbit representation is presented as the natural starting point for sampling-based access to the SPF."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:nonid",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:8f3f4ce629c8192d9af399faefa6a652aff5fef36fe60f04a165bb431d6f74fd",
      "record_id": "span:opus5-2608.14798v1/orbit-rep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$P\\neq\\mathbb{I}$ is an arbitrary non-identity Pauli, e.g. $Z^{\\otimes n}$"
   },
   {
    "condition_id": "cond:integer",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:8f3f4ce629c8192d9af399faefa6a652aff5fef36fe60f04a165bb431d6f74fd",
      "record_id": "span:opus5-2608.14798v1/orbit-rep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the Renyi representation uses integer-index stabilizer entropies $M_k$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:8f3f4ce629c8192d9af399faefa6a652aff5fef36fe60f04a165bb431d6f74fd",
    "record_id": "span:opus5-2608.14798v1/orbit-rep",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:c791ff205e456e4f33b8f0c0a1e14de07c3fedb5ea2b68a6b4cbcb23002d889f",
    "record_id": "span:opus5-2608.14798v1/renyi-rep",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Two equivalent representations are given. The Clifford-orbit representation rewrites the SPF as $e^{-\\beta}[\\cosh\\beta+\\frac{d_n^2-1}{|\\mathcal{C}l_n|}\\sum_{C}\\cosh(\\beta\\tr[\\psi P_C])]$ and, after expanding $\\cosh$, in terms of Clifford $2k$-fold twirling channels acting on $2k$ copies. The stabilizer-Renyi representation is $\\mathcal{Z}_\\beta(\\psi)=e^{-\\beta}[d_n^2+\\frac{d_n}{2}\\beta^2+\\sum_{k\\geq2}\\frac{\\beta^{2k}}{(2k)!}2^{n-(k-1)M_k(\\psi)}]$, exhibiting the SPF as a generating function for the moment hierarchy probed by the integer SREs.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
