 "payload": {
  "name": "Subset phase state (SPS)",
  "objects": [
   {
    "convention": "the paper's SPF theorem is restricted to $|S|=2^n$, i.e. $S=\\{0,1\\}^n$, where only the average over $f$ remains",
    "definition_refs": [],
    "object_type": "n-qubit pure state",
    "symbol": "\\ket{\\psi_{f,S}}",
    "unit": ""
   }
  ],
  "origin": "IMPORTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:c67b7fd77ac0492da16489f10643e132e3fecac68a905eea3473c38473c0696e",
    "record_id": "span:opus5-2608.14798v1/sps-def",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "$\\ket{\\psi_{f,S}}=\\frac{1}{\\sqrt{|S|}}\\sum_{x\\in S}(-1)^{f(x)}\\ket{x}$ with $f$ a pseudorandom function and $S\\subseteq\\{0,1\\}^n$ a pseudorandom subset of fixed size $|S|=2^k$, $\\log n\\le k\\le n$."
 },
