 "payload": {
  "name": "Pauli spectrum density d mu",
  "objects": [
   {
    "convention": "uniform weight 1/d_n^2 per spectrum entry, distinct from the purity-weighted distribution Xi",
    "definition_refs": [],
    "object_type": "point (atomic) measure on [-1,1]",
    "symbol": "d\\mu_{\\ket{\\psi}}(x)",
    "unit": ""
   }
  ],
  "origin": "SOURCE",
  "source_span_refs": [
   {
    "content_hash": "sha256:4c98885297933f354669d0b1deeaf57f1f4f137a084ca2d43fbc504758b4dbcd",
    "record_id": "span:opus5-2608.14798v1/density",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "$d\\mu_{\\ket{\\psi}}(x)=\\frac{1}{d_n^2}\\sum_{x_l\\in{\\rm Spec}(\\psi)}\\delta(x-x_l)\\,dx$ on $x\\in[-1,1]$, related to $\\Xi$ by $\\mathbb{E}_{x\\sim\\Xi}[x^{2\\alpha}]=d_n\\,\\mathbb{E}_{x\\sim d\\mu_\\psi}[x^{2(\\alpha+1)}]$, and giving $\\mathcal{Z}_\\beta(\\psi)=e^{-\\beta}d_n^2\\,\\mathbb{E}_{x\\sim d\\mu_\\psi}[\\cosh(\\beta x)]$."
 },
