      "revision": 1
     }
    ],
    "text": "Supermultiplicativity of the core SPF with the stated stabilizer-value denominator."
   },
   {
    "component_id": "comp:lemma",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:9bc97f9f0170e759608b34ce9544533d3dc0059f8336f47e3e1a6eaace03665a",
      "record_id": "span:opus5-2608.14798v1/chebyshev",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Monotone reweighting (Chebyshev-type) lemma supplies the key step."
   },
   {
    "component_id": "comp:pstar",
    "role": "ASSUMPTION",
    "source_span_refs": [
     {
      "content_hash": "sha256:7274d6630488ca1cd4a2c6a96b2340a485bc167ad930842de1543ebb7ddb284a",
      "record_id": "span:opus5-2608.14798v1/supermult",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$p^\\star_k=w_k/\\sum_k w_k$ is said to be derivable from a stabilizer state in system $A$."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:sep",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:7274d6630488ca1cd4a2c6a96b2340a485bc167ad930842de1543ebb7ddb284a",
      "record_id": "span:opus5-2608.14798v1/supermult",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\ket{\\psi_{AB}}=\\ket{\\psi_A}\\otimes\\ket{\\phi_B}$"
   },
   {
    "condition_id": "cond:ratio",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:7274d6630488ca1cd4a2c6a96b2340a485bc167ad930842de1543ebb7ddb284a",
      "record_id": "span:opus5-2608.14798v1/supermult",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the proof asserts $p_k/p^\\star_k\\geq p_{k+1}/p^\\star_{k+1}$ for the constructed distributions"
   },
   {
    "condition_id": "cond:beta",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [
     {
      "content_hash": "sha256:7274d6630488ca1cd4a2c6a96b2340a485bc167ad930842de1543ebb7ddb284a",
      "record_id": "span:opus5-2608.14798v1/supermult",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the admissible range of $\\beta$ is not stated; the denominator $\\cosh\\beta-1$ vanishes at $\\beta=0$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:7274d6630488ca1cd4a2c6a96b2340a485bc167ad930842de1543ebb7ddb284a",
    "record_id": "span:opus5-2608.14798v1/supermult",
