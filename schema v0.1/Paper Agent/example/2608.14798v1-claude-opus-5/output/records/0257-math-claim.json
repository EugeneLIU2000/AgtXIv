 "payload": {
  "approximation_error": "",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [],
    "statement": "$\\cosh$ is even, so $\\mathcal{Z}_\\beta$ is invariant under independent sign flips of spectrum entries"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [],
    "statement": "the sum over ${\\rm Spec}$ is symmetric, so it is invariant under relabelling"
   }
  ],
  "claim_ref": {
   "content_hash": "sha256:3c42acfad57e11c0ab2e7e44cf516216b544afea82101dda7dcad3547fd07139",
   "record_id": "claim:opus5-2608.14798v1/c33",
   "record_type": "agtxiv.v3.scientific-claim/0.0.0",
   "revision": 1
  },
  "component_ids": [
   "comp:lossy"
  ],
  "conclusion": "$\\mathcal{Z}_{\\beta}(\\psi)$ depends on ${\\rm Spec}(\\psi)$ only through the even moments $\\{\\sum_{x}x^{2k}\\}_{k\\geq0}$; in particular any two states whose Pauli spectra agree as multisets up to sign and relabelling have identical SPF at every $\\beta$.",
  "definition_refs": [
   {
    "content_hash": "sha256:25570ca9d76dba9ce2ede37ad0830435a435d4f94bf0861893df91243ce438e8",
    "record_id": "definition:opus5-2608.14798v1/spf",
    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:a0abe20aecbd0a545cb8c94808bbe7c6f209645b09edc521b3d6526b1508c66d",
    "record_id": "definition:opus5-2608.14798v1/pauli-spectrum",
    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   }
  ],
  "exactness": "EXACT",
  "normalization": "the converse (that the even moments determine the SPF) is immediate; the paper does not state whether the even moments determine the magic-relevant content",
  "objects": [
   {
    "convention": "sum over the full multiset ${\\rm Spec}(\\psi)$ including the identity Pauli; $\\mathcal{Z}_0=d_n^2$",
    "definition_refs": [
     {
      "content_hash": "sha256:25570ca9d76dba9ce2ede37ad0830435a435d4f94bf0861893df91243ce438e8",
      "record_id": "definition:opus5-2608.14798v1/spf",
