      "revision": 1
     }
    ],
    "object_type": "real function $\\mathbb{R}\\times\\mathcal{H}\\to\\mathbb{R}$",
    "symbol": "\\mathcal{Z}_\\beta(\\psi)",
    "unit": ""
   },
   {
    "convention": "signed convention $\\tr(\\psi P)$, phase-free Pauli labels, global phases irrelevant",
    "definition_refs": [
     {
      "content_hash": "sha256:a0abe20aecbd0a545cb8c94808bbe7c6f209645b09edc521b3d6526b1508c66d",
