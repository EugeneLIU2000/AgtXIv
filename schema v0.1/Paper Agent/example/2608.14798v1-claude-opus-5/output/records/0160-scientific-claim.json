 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the stabilizer value $\\mathcal{Z}_\\beta({\\rm STAB}_n)$",
  "components": [
   {
    "component_id": "comp:upper",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:782ca8e93ca457dd4d8f0fb145b2f9d4848e6d380092128028cee28b76268146",
      "record_id": "span:opus5-2608.14798v1/bounds-indep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Upper bound is the stabilizer SPF, so stabilizer states maximize the SPF."
   },
   {
    "component_id": "comp:lower",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:782ca8e93ca457dd4d8f0fb145b2f9d4848e6d380092128028cee28b76268146",
      "record_id": "span:opus5-2608.14798v1/bounds-indep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Lower bound $e^{-\\beta}[\\cosh\\beta+(d_n^2-1)\\cosh(\\beta/\\sqrt{d+1})]$."
   },
   {
    "component_id": "comp:extremal",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:782ca8e93ca457dd4d8f0fb145b2f9d4848e6d380092128028cee28b76268146",
      "record_id": "span:opus5-2608.14798v1/bounds-indep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The lower bound is attained by a hypothetical spectrum uniform over all non-identity Paulis."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:beta",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:782ca8e93ca457dd4d8f0fb145b2f9d4848e6d380092128028cee28b76268146",
      "record_id": "span:opus5-2608.14798v1/bounds-indep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\beta\\in\\mathbb{R}$"
   },
   {
    "condition_id": "cond:pure",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:782ca8e93ca457dd4d8f0fb145b2f9d4848e6d380092128028cee28b76268146",
      "record_id": "span:opus5-2608.14798v1/bounds-indep",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\ket{\\psi}$ pure"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:782ca8e93ca457dd4d8f0fb145b2f9d4848e6d380092128028cee28b76268146",
    "record_id": "span:opus5-2608.14798v1/bounds-indep",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Theorem (SPF state-independent bounds): for $\\beta\\in\\mathbb{R}$ and any $n$-qubit pure state, $e^{-\\beta}[(d_n^2-d_n)+d_n\\cosh\\beta]\\geq\\mathcal{Z}_\\beta(\\psi)\\geq e^{-\\beta}[\\cosh\\beta+(d_n^2-1)\\cosh(\\beta/\\sqrt{d+1})]$, the upper bound being the stabilizer value and the lower bound obtained from a spectrum uniform over all non-trivial Paulis.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
