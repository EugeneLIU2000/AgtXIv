 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "Haar-random states ($\\nu\\to n$) and stabilizer states ($\\nu\\to0$)",
  "components": [
   {
    "component_id": "comp:thm",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:6fba13ba7ad8d66fe2ab79257a4e881fe5d485de44eb99c946aa953e1c251c37",
      "record_id": "span:opus5-2608.14798v1/comp-thm",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Exact ensemble SPF for $\\nu$-compressible states."
   },
   {
    "component_id": "comp:limits",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:9b77c466f4768a846f72716c20ed2a6f9a281207d5c10a18fd63fef1bb8a5f51",
      "record_id": "span:opus5-2608.14798v1/comp-checks",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Consistency in the limits $\\nu\\to n$ (Haar) and $\\nu\\to0$ (stabilizer), and the clean cSPF form $2^{n-\\nu}\\mathcal{Z}^c_\\beta({\\rm Haar}_\\nu)$."
   },
   {
    "component_id": "comp:conc",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:5d595e2b298f5b4b3c68906797be3a62c288b2e55f604ce3d3957e9f2ecc3578",
      "record_id": "span:opus5-2608.14798v1/comp-conc",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Concentration with Lipschitz constant $L_{{\\rm Comp}_\\nu}(\\beta)=2^{n-\\nu}L_n(\\beta)$."
   },
   {
    "component_id": "comp:asym",
    "role": "APPROXIMATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:a81269d811aad9585327b9aa59d14d5135d227ab5ea4c431562038f8f3407102",
      "record_id": "span:opus5-2608.14798v1/comp-asym",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     },
     {
      "content_hash": "sha256:8f4b5f1038e4a825e7ac3931a4ebc1138994408f5986dc13cb3c6964ed0d3336",
      "record_id": "span:opus5-2608.14798v1/comp-only-stab",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Asymptotic dependence only on the stabilizer-sector size."
   },
   {
    "component_id": "comp:tdoped",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:164ed3a9ec11695108299edce838db595b6d639536e1267e0ff15498bb419093",
      "record_id": "span:opus5-2608.14798v1/tdoped",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$t$-doped states inherit the result with $\\nu\\leq2lt$."
   },
   {
    "component_id": "comp:alg",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:b30c4aa0c0539323aeee6437c816a645d7b2e2ec18b16566cd81bed9dba1ccf6",
      "record_id": "span:opus5-2608.14798v1/nu-cert",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     },
     {
      "content_hash": "sha256:df2c31508e3125ae49656a3c73e8d78dd8fa54799eca09591d491ad3ce0fd7ea",
      "record_id": "span:opus5-2608.14798v1/oracle-note",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Algorithms 2 and 3 certify $\\nu$-compressibility and return $t_{\\min}$, at the cost of oracle access; the paper notes oracle access can be replaced by the estimator of Theorem (SPF complexity)."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:measure",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:6fba13ba7ad8d66fe2ab79257a4e881fe5d485de44eb99c946aa953e1c251c37",
      "record_id": "span:opus5-2608.14798v1/comp-thm",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "states are sampled from $\\mu_{n,\\nu}=\\mu_{\\mathcal{C}l_n}\\ast\\mu_{{\\rm Haar}_\\nu}$"
   },
   {
    "condition_id": "cond:ens",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:6fba13ba7ad8d66fe2ab79257a4e881fe5d485de44eb99c946aa953e1c251c37",
      "record_id": "span:opus5-2608.14798v1/comp-thm",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the formula is an ensemble average $\\mathbb{E}_{\\psi\\sim\\mu_\\nu}[\\mathcal{Z}_\\beta(\\psi)]$"
   },
   {
    "condition_id": "cond:asym",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:6fba13ba7ad8d66fe2ab79257a4e881fe5d485de44eb99c946aa953e1c251c37",
      "record_id": "span:opus5-2608.14798v1/comp-thm",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the asymptotic form requires $\\beta^2=o(2^\\nu)$"
   },
   {
    "condition_id": "cond:tdoped",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:6fba13ba7ad8d66fe2ab79257a4e881fe5d485de44eb99c946aa953e1c251c37",
      "record_id": "span:opus5-2608.14798v1/comp-thm",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$t$-doped states use non-Clifford gates of constant size $l$, giving $\\nu\\leq2lt$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:6fba13ba7ad8d66fe2ab79257a4e881fe5d485de44eb99c946aa953e1c251c37",
    "record_id": "span:opus5-2608.14798v1/comp-thm",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:9b77c466f4768a846f72716c20ed2a6f9a281207d5c10a18fd63fef1bb8a5f51",
    "record_id": "span:opus5-2608.14798v1/comp-checks",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:5d595e2b298f5b4b3c68906797be3a62c288b2e55f604ce3d3957e9f2ecc3578",
    "record_id": "span:opus5-2608.14798v1/comp-conc",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:a81269d811aad9585327b9aa59d14d5135d227ab5ea4c431562038f8f3407102",
    "record_id": "span:opus5-2608.14798v1/comp-asym",
