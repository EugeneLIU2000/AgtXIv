 "payload": {
  "approximation_error": "",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "the Pauli spectrum of a stabilizer state on $B$ is $d_B$ ones and $d_B^2-d_B$ zeros"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "multiplicativity of the Pauli spectrum under tensor products"
   }
  ],
  "claim_ref": {
   "content_hash": "sha256:6b0a18db2461e384660317833a16f81ecda53435ab37957327ddd14500837168",
   "record_id": "claim:opus5-2608.14798v1/c16",
   "record_type": "agtxiv.v3.scientific-claim/0.0.0",
   "revision": 1
  },
  "component_ids": [
   "comp:stabpure"
  ],
  "conclusion": "$\\mathcal{Z}_{\\beta}(\\psi_{A}\\otimes{\\rm Stab}_{B})=d_{B}\\mathcal{Z}_{\\beta}(\\psi_{A})+e^{-\\beta}(d_{B}^{2}-d_{B})d_{A}^{2}$, and $\\mathcal{Z}^{c}_{\\beta}(\\psi_{A}\\otimes{\\rm Stab}_{B})=d_{B}\\mathcal{Z}^{c}_{\\beta}(\\psi_{A})$.",
  "definition_refs": [
   {
