 "payload": {
  "approximation_error": "",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "$\\cosh$ is even, absorbing Clifford-induced sign flips"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "Clifford conjugation permutes the Pauli spectrum, so the sorted spectra agree"
   },
   {
    "condition_id": "assumption:a3",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "Proposition (Stabilizer Pauli Spectrum) supplies the stabilizer spectrum $d_n$ entries $\\pm1$ and $d_n^2-d_n$ zeros"
   }
  ],
  "claim_ref": {
   "content_hash": "sha256:9bae5f9301b693b3d2c760cad5e8d479b89f3cff6689cb5c170f6004c7a50e9b",
