   "revision": 1
  },
  "component_ids": [
   "comp:inv",
   "comp:uniq"
  ],
  "conclusion": "$\\forall\\mathcal{C}\\in\\mathcal{C}l_n:\\ \\mathcal{Z}_\\beta(\\mathcal{C}(\\psi))=\\mathcal{Z}_\\beta(\\psi)$; and $\\forall\\phi\\in{\\rm Stab}_n:\\ \\mathcal{Z}_\\beta(\\phi)=e^{-\\beta}[(d_n^2-d_n)+d_n\\cosh\\beta]$, $d_n=2^n$.",
