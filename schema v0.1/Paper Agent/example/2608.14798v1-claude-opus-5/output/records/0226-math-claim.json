 "payload": {
  "approximation_error": "${\\rm logPoly}(n)$ on the lower side and $\\mathcal{O}(\\beta^{4})+{\\rm LogPoly}(n)$ on the upper side, with unspecified constants; 'negligible failure probability' is not quantified",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "$\\mathcal{W}_\\beta(\\mathcal{E}):=-\\log\\mathcal{Z}^c_\\beta(\\mathcal{E})+\\log\\mathcal{Z}^c_\\beta({\\rm Stab}_n)$ with $\\mathcal{Z}_\\beta(\\mathcal{E})$ the ensemble-averaged SPF"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "Markov-type tail control, deferred to the supplement"
   }
  ],
  "claim_ref": {
