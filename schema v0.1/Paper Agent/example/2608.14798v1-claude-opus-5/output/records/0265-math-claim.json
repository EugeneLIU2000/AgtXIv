    ],
    "object_type": "real function $\\mathbb{R}\\times\\mathcal{H}\\to\\mathbb{R}$",
    "symbol": "\\mathcal{Z}^c_\\beta(\\psi)",
    "unit": ""
   },
   {
    "convention": "free-energy difference of the Pauli gas referenced to the unique stabilizer value; $\\log$ base 2",
    "definition_refs": [
