  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:e466e6e55c0eafc8ab9b61beacba086c25c14373cbe3be1d2c6250dbcc9a5e50",
    "record_id": "span:opus5-2608.14798v1/prop-stab-spectrum",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Proposition (Stabilizer Pauli Spectrum): the Pauli spectrum of a pure $n$-qubit stabilizer state of a system $A$ consists of $d_A^2-d_A$ zeros and $d_A$ entries equal to $\\pm1$.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
