 ],
 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the $|\\tr(\\psi P)|$ convention of Beverland et al. (2020)",
  "components": [
   {
    "component_id": "comp:def",
    "role": "DEFINITION",
    "source_span_refs": [
     {
      "content_hash": "sha256:3ccd1efb3febdd029daa4e32124fa438b78f84c07e92ce47a891df10007fea54",
      "record_id": "span:opus5-2608.14798v1/pauli-spec-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "${\\rm Spec}(\\psi):=\\{\\tr(\\psi P)\\ \\text{for}\\ P\\in\\mathcal{P}_n\\}$, $4^n$ real entries."
   },
   {
    "component_id": "comp:multiset",
    "role": "DEFINITION",
    "source_span_refs": [
     {
      "content_hash": "sha256:3ccd1efb3febdd029daa4e32124fa438b78f84c07e92ce47a891df10007fea54",
      "record_id": "span:opus5-2608.14798v1/pauli-spec-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Spec should be read as a multiset because multiplicities matter (stated in a footnote, not in the displayed definition)."
   },
   {
    "component_id": "comp:recover",
    "role": "ASSUMPTION",
    "source_span_refs": [
     {
      "content_hash": "sha256:c6cc2e17188966d77809da7c2fe46b65b4efeb7e50c1825da6e269071e850014",
      "record_id": "span:opus5-2608.14798v1/signed-convention",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The absolute-value convention 'can be recovered whenever needed'."
   },
   {
    "component_id": "comp:witness",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:c6cc2e17188966d77809da7c2fe46b65b4efeb7e50c1825da6e269071e850014",
      "record_id": "span:opus5-2608.14798v1/signed-convention",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The Pauli spectrum separates stabilizer structure from nonstabilizer behaviour and is therefore a magic witness."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:pure",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:3ccd1efb3febdd029daa4e32124fa438b78f84c07e92ce47a891df10007fea54",
      "record_id": "span:opus5-2608.14798v1/pauli-spec-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\ket{\\psi}$ is an $n$-qubit pure state"
   },
   {
    "condition_id": "cond:phasefree",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:3ccd1efb3febdd029daa4e32124fa438b78f84c07e92ce47a891df10007fea54",
      "record_id": "span:opus5-2608.14798v1/pauli-spec-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "Pauli operators are taken modulo phase; global phases irrelevant"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:3ccd1efb3febdd029daa4e32124fa438b78f84c07e92ce47a891df10007fea54",
    "record_id": "span:opus5-2608.14798v1/pauli-spec-def",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:c6cc2e17188966d77809da7c2fe46b65b4efeb7e50c1825da6e269071e850014",
    "record_id": "span:opus5-2608.14798v1/signed-convention",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "The paper defines the Pauli spectrum with the sign retained, ${\\rm Spec}(\\psi)=\\{\\tr(\\psi P)\\}_{P\\in\\mathcal{P}_n}$, rather than the absolute-value convention of Beverland et al., stating that the signed convention is the natural one for the typical-set analysis developed later and that the absolute-value version can be recovered whenever needed.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
