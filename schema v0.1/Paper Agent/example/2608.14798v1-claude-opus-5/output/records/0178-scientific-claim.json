 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "multiplicativity $\\mathcal{Z}_\\beta(\\psi_A\\otimes\\phi_B)=\\mathcal{Z}_\\beta(\\psi_A)\\mathcal{Z}_\\beta(\\phi_B)$, which is explicitly denied",
  "components": [
   {
    "component_id": "comp:nonmult",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:e857044e5582a7c528e10c5ba1bd595f6a852a6f25981cd4e2b42931cb047be3",
      "record_id": "span:opus5-2608.14798v1/nonmultiplicativity",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{Z}_\\beta(\\psi_A\\otimes\\phi_B)\\neq\\mathcal{Z}_\\beta(\\psi_A)\\mathcal{Z}_\\beta(\\phi_B)$; the failure is structured."
   },
   {
    "component_id": "comp:decomp",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:1c8ee15e68a4fb268697f956edd21a584a1cebd5eee4b578fa0615afda4c3cb6",
      "record_id": "span:opus5-2608.14798v1/separable",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Four-term decomposition with residual $\\mathcal{Z}^{(R)}_\\beta$."
   },
   {
    "component_id": "comp:residual",
    "role": "DEFINITION",
    "source_span_refs": [
     {
      "content_hash": "sha256:1c8ee15e68a4fb268697f956edd21a584a1cebd5eee4b578fa0615afda4c3cb6",
      "record_id": "span:opus5-2608.14798v1/separable",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     },
     {
      "content_hash": "sha256:aa5889a72b5c1619ed9944e3a52a31f37f387278d552082fa34e295b60de9458",
      "record_id": "span:opus5-2608.14798v1/canonical-splitting",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{Z}^{(R)}_\\beta(\\psi_{AB})=e^{-\\beta}\\sum_{x\\in{\\rm Spec}_R(\\psi_A)\\times{\\rm Spec}_R(\\psi_B)}\\cosh(\\beta x)$ from the Cartesian product of residual spectra, with ${\\rm Spec}_R$ fixed by the supplemental Canonical Splitting proposition as the complement of the $\\pm1$ entries, i.e. every Pauli with $|\\tr(P\\psi)|<1$ including the zeros."
   },
   {
    "component_id": "comp:stabpure",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:7a49731846b3f6963510f3083b2f8a0de01415884cdc3bddc8b55a9139d06514",
      "record_id": "span:opus5-2608.14798v1/stab-pure",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Stabilizer+pure special case, plus the clean core-SPF form $d_B\\mathcal{Z}^c_\\beta(\\psi_A)$."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:sep",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:e857044e5582a7c528e10c5ba1bd595f6a852a6f25981cd4e2b42931cb047be3",
      "record_id": "span:opus5-2608.14798v1/nonmultiplicativity",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\ket{\\psi_{AB}}=\\ket{\\psi_A}\\otimes\\ket{\\psi_B}$"
   },
   {
    "condition_id": "cond:nullity",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:e857044e5582a7c528e10c5ba1bd595f6a852a6f25981cd4e2b42931cb047be3",
      "record_id": "span:opus5-2608.14798v1/nonmultiplicativity",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\nu_{A(B)}$ is the stabilizer nullity of the corresponding subsystem state"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:e857044e5582a7c528e10c5ba1bd595f6a852a6f25981cd4e2b42931cb047be3",
