 ],
 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "$\\mathcal{Z}_\\beta({\\rm STAB}_n)$ and the $\\nu$-compressible family",
  "components": [
   {
    "component_id": "comp:exact",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:70835e0faa74a83ca4976fdb0a18c99fb14cecc5222e00c4df0ec49028239084",
      "record_id": "span:opus5-2608.14798v1/haar",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Closed form in terms of a modified Bessel function of the first kind."
   },
   {
    "component_id": "comp:check",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:70835e0faa74a83ca4976fdb0a18c99fb14cecc5222e00c4df0ec49028239084",
      "record_id": "span:opus5-2608.14798v1/haar",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Consistency check: the $\\beta\\to0$ limit recovers $\\mathcal{Z}_0=d_n^2$ via the small-argument Bessel expansion."
   },
   {
    "component_id": "comp:asym",
    "role": "APPROXIMATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:e8f7fb3dbd1718a3211bab154802e5b1112e2a4088500bffb71d2c12ff87c331",
      "record_id": "span:opus5-2608.14798v1/haar-asym",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Asymptotic flat form $e^{-\\beta}[\\cosh\\beta+(d_n^2-1)(1+o(1))]$ for $\\beta^2=o(d_n)$."
   },
   {
    "component_id": "comp:picture",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:e8f7fb3dbd1718a3211bab154802e5b1112e2a4088500bffb71d2c12ff87c331",
      "record_id": "span:opus5-2608.14798v1/haar-asym",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Reading: Haar spectra narrow to $d_n^2-1$ zeros plus a single one, with $|{\\rm Stab}|=|{\\rm Supp}|=1$ almost surely."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:beta",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:70835e0faa74a83ca4976fdb0a18c99fb14cecc5222e00c4df0ec49028239084",
      "record_id": "span:opus5-2608.14798v1/haar",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\beta\\geq0$ is stated in the theorem"
   },
   {
    "condition_id": "cond:ensavg",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:70835e0faa74a83ca4976fdb0a18c99fb14cecc5222e00c4df0ec49028239084",
      "record_id": "span:opus5-2608.14798v1/haar",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the quantity is the ENSEMBLE AVERAGE $\\mathbb{E}_{\\psi\\sim{\\rm Haar}}[\\mathcal{Z}_\\beta(\\psi)]$, not the SPF of any single state"
   },
   {
    "condition_id": "cond:asym",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:70835e0faa74a83ca4976fdb0a18c99fb14cecc5222e00c4df0ec49028239084",
      "record_id": "span:opus5-2608.14798v1/haar",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the asymptotic form requires $\\beta^2=o(d_n)$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:70835e0faa74a83ca4976fdb0a18c99fb14cecc5222e00c4df0ec49028239084",
    "record_id": "span:opus5-2608.14798v1/haar",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:e8f7fb3dbd1718a3211bab154802e5b1112e2a4088500bffb71d2c12ff87c331",
    "record_id": "span:opus5-2608.14798v1/haar-asym",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Theorem (SPF for Haar-random states): for $\\beta\\geq0$, $\\mathcal{Z}_\\beta({\\rm Haar}_n)=e^{-\\beta}[\\cosh\\beta+(d_n^2-1)\\Gamma(\\frac{d_n+1}{2})(2/\\beta)^{\\frac{d_n-1}{2}}I_{\\frac{d_n-1}{2}}(\\beta)]$. Lemma: for fixed $\\beta$ and large $d_n$, more generally whenever $\\beta^2=o(d_n)$, $\\mathcal{Z}_\\beta({\\rm Haar}_n)=e^{-\\beta}[\\cosh\\beta+(d_n^2-1)(1+o(1))]$. The proof is deferred to the supplement and is based on the Haar Pauli-spectrum density of Turkeshi et al.",
  "system": "$\\ket{\\psi}=U\\ket{0}^{\\otimes n}$ with $U$ Haar-distributed on $U(2^n)$; maximal magic and volume-law entanglement"
 },
