 ],
 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "fixed-$\\alpha$ stabilizer Renyi entropies and $k$-designs",
  "components": [
   {
    "component_id": "comp:levy",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:dec3bf87cf2b5ba5862b8eb4da19f9fd6a827a99540a39875c56be4000f389cb",
      "record_id": "span:opus5-2608.14798v1/haar-conc",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Doubly exponential concentration with the explicit constant $\\frac{2}{9\\pi^3}$."
   },
   {
    "component_id": "comp:selfavg",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:dec3bf87cf2b5ba5862b8eb4da19f9fd6a827a99540a39875c56be4000f389cb",
      "record_id": "span:opus5-2608.14798v1/haar-conc",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Reading: the SPF is self-averaging, so almost all Haar states share the same SPF and stabilizer work."
   },
   {
    "component_id": "comp:alg",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:6102405ae2aaa9650b45615f1df258b1c59f43e12bea6fd67af3b5f53918ebd7",
      "record_id": "span:opus5-2608.14798v1/haar-cert",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Algorithm 1 (HaarCertify): compute $\\delta_\\beta$, normalize, and decide by whether $\\delta_\\beta=o(1)$."
   },
   {
    "component_id": "comp:design",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:d4fe8c0baa68a46de6e9197d5795354698737c5aa566efb34a4b92b3e469a161",
      "record_id": "span:opus5-2608.14798v1/haar-vs-design",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "A fixed $\\alpha$-SRE cannot distinguish a $k$-design from Haar once moments agree, typically requiring $k<2\\alpha$ for discrimination; the SPF, being a series in all $\\alpha$, is sensitive to true Haar randomness."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:normalized",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:dec3bf87cf2b5ba5862b8eb4da19f9fd6a827a99540a39875c56be4000f389cb",
      "record_id": "span:opus5-2608.14798v1/haar-conc",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "the lemma is stated for the 'properly normalized' SPF, with the deviation divided by the Lipschitz constant $L_n(\\beta)$"
   },
   {
    "condition_id": "cond:smallbeta",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:dec3bf87cf2b5ba5862b8eb4da19f9fd6a827a99540a39875c56be4000f389cb",
      "record_id": "span:opus5-2608.14798v1/haar-conc",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "Algorithm 1 requires $\\beta=o(\\sqrt{d_n})$"
   },
   {
    "condition_id": "cond:oracle",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:dec3bf87cf2b5ba5862b8eb4da19f9fd6a827a99540a39875c56be4000f389cb",
      "record_id": "span:opus5-2608.14798v1/haar-conc",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "Algorithm 1 assumes oracle access to $\\mathcal{Z}_\\beta(\\psi)$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:dec3bf87cf2b5ba5862b8eb4da19f9fd6a827a99540a39875c56be4000f389cb",
    "record_id": "span:opus5-2608.14798v1/haar-conc",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:6102405ae2aaa9650b45615f1df258b1c59f43e12bea6fd67af3b5f53918ebd7",
    "record_id": "span:opus5-2608.14798v1/haar-cert",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:d4fe8c0baa68a46de6e9197d5795354698737c5aa566efb34a4b92b3e469a161",
    "record_id": "span:opus5-2608.14798v1/haar-vs-design",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Lemma (Levy's Lemma for the SPF): ${\\rm Prob}(|\\mathcal{Z}_\\beta(\\psi)-\\mathcal{Z}_\\beta({\\rm Haar}_n)|/L_n(\\beta)\\geq\\epsilon)\\leq4\\exp(-\\frac{2}{9\\pi^3}2^n\\epsilon^2)$, so deviations are doubly exponentially suppressed in the qubit number and almost all Haar states share essentially the same SPF. Algorithm 1 uses a single oracle call to the SPF at small $\\beta$ to certify Haar randomness. The paper argues the SPF is a better Haar witness than a fixed-$\\alpha$ SRE because high-order designs reproduce individual SRE values.",
  "system": "Haar-random $n$-qubit pure states"
 },
