 ],
 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the unfiltered SPF $\\mathcal{Z}_\\beta$",
  "components": [
   {
    "component_id": "comp:def",
    "role": "DEFINITION",
    "source_span_refs": [
     {
      "content_hash": "sha256:dc09fcb572558b951c2bc8c947007285625c0d15e37754f704ca1a06449dfa98",
      "record_id": "span:opus5-2608.14798v1/cspf-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{Z}^c_\\beta(\\psi)=\\mathcal{Z}_\\beta(\\psi)-d^2e^{-\\beta}$."
   },
   {
    "component_id": "comp:stab",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:dc09fcb572558b951c2bc8c947007285625c0d15e37754f704ca1a06449dfa98",
      "record_id": "span:opus5-2608.14798v1/cspf-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{Z}^c_\\beta({\\rm STAB}_n)=e^{-\\beta}d_n(\\cosh\\beta-1)$."
   },
   {
    "component_id": "comp:why",
    "role": "ASSUMPTION",
    "source_span_refs": [
     {
      "content_hash": "sha256:2a438e1f5fcaacb5a52aa1fb40173eb318096ea5e6b59c58125552387ca2a431",
      "record_id": "span:opus5-2608.14798v1/why-cspf",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Motivation: the removed term is the Pauli count and spoils multiplicative composition."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:beta",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:dc09fcb572558b951c2bc8c947007285625c0d15e37754f704ca1a06449dfa98",
      "record_id": "span:opus5-2608.14798v1/cspf-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\beta\\in\\mathbb{R}$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:dc09fcb572558b951c2bc8c947007285625c0d15e37754f704ca1a06449dfa98",
    "record_id": "span:opus5-2608.14798v1/cspf-def",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:2a438e1f5fcaacb5a52aa1fb40173eb318096ea5e6b59c58125552387ca2a431",
    "record_id": "span:opus5-2608.14798v1/why-cspf",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "The core SPF is defined by dropping the leading-order constant of the SPF, $\\mathcal{Z}^c_\\beta(\\psi)=e^{-\\beta}\\sum_x(\\cosh(\\beta x)-1)=\\mathcal{Z}_\\beta(\\psi)-d^2e^{-\\beta}$; for stabilizer states it takes the simpler form $\\mathcal{Z}^c_\\beta({\\rm STAB}_n)=e^{-\\beta}d_n(\\cosh\\beta-1)$. The stated reason for using the cSPF to build the monotone is that the SPF's leading term scales with the number of Pauli operators and does not combine multiplicatively under tensor products in a manner consistent with the higher-moment structure.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
