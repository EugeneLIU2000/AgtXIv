 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "a single stabilizer Renyi entropy $M_\\alpha$ at fixed $\\alpha$, which fixes one moment",
  "components": [
   {
    "component_id": "comp:def",
    "role": "DEFINITION",
    "source_span_refs": [
     {
      "content_hash": "sha256:3bf5b5598106687717b8c87f61506dcc4ba762ed0318f0eb646c54947ab4fad2",
      "record_id": "span:opus5-2608.14798v1/spf-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\mathcal{Z}_\\beta(\\psi)=\\frac12\\tr[e^{-\\beta\\hat H(\\psi)}]=e^{-\\beta}\\sum_{x\\in{\\rm Spec}(\\psi)}\\cosh(\\beta x)$."
   },
   {
    "component_id": "comp:mgf",
    "role": "MODEL",
    "source_span_refs": [
     {
      "content_hash": "sha256:3bf5b5598106687717b8c87f61506dcc4ba762ed0318f0eb646c54947ab4fad2",
      "record_id": "span:opus5-2608.14798v1/spf-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The SPF is a moment-generating function capturing the full statistics of the Pauli spectrum."
   },
   {
    "component_id": "comp:hi-t",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:4d0e30bf4c310a4c5f9cac2c7bae525760d0a9905f3f8333d1d3177ad4913e0c",
      "record_id": "span:opus5-2608.14798v1/spf-limits",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\lim_{\\beta\\to0}\\mathcal{Z}_\\beta(\\psi)=d_n^2$ for every state."
   },
   {
    "component_id": "comp:lo-t",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:4d0e30bf4c310a4c5f9cac2c7bae525760d0a9905f3f8333d1d3177ad4913e0c",
      "record_id": "span:opus5-2608.14798v1/spf-limits",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\lim_{\\beta\\to\\infty}\\mathcal{Z}_\\beta(\\psi)=|{\\rm STAB}(\\psi)|/2$."
   },
   {
    "component_id": "comp:rewrite",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:4d0e30bf4c310a4c5f9cac2c7bae525760d0a9905f3f8333d1d3177ad4913e0c",
      "record_id": "span:opus5-2608.14798v1/spf-limits",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "For every $\\beta$, $\\mathcal{Z}_\\beta(\\psi)=e^{-\\beta}(|{\\rm Ker}(\\psi)|+\\sum_{P\\in{\\rm Supp}(\\psi)}\\cosh(\\tr{P\\psi}))$."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:beta",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:3bf5b5598106687717b8c87f61506dcc4ba762ed0318f0eb646c54947ab4fad2",
      "record_id": "span:opus5-2608.14798v1/spf-def",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\beta\\in\\mathbb{R}$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:3bf5b5598106687717b8c87f61506dcc4ba762ed0318f0eb646c54947ab4fad2",
    "record_id": "span:opus5-2608.14798v1/spf-def",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:4d0e30bf4c310a4c5f9cac2c7bae525760d0a9905f3f8333d1d3177ad4913e0c",
    "record_id": "span:opus5-2608.14798v1/spf-limits",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:786affeaa50291416a171f2ecb76b1fd12e35e3c8cc029a4e70c266a2f3794e6",
    "record_id": "span:opus5-2608.14798v1/spf-lowT-supp",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "The stabilizer partition function is defined as $\\mathcal{Z}_\\beta(\\psi)=\\frac12\\tr[e^{-\\beta\\hat H(\\psi)}]=e^{-\\beta}\\sum_{x\\in{\\rm Spec}(\\psi)}\\cosh(\\beta x)$ and is described as a moment-generating function that captures the full statistical properties of the Pauli spectrum rather than a single moment. Its limits are $\\lim_{\\beta\\to0}\\mathcal{Z}_\\beta(\\psi)=d_n^2$ and $\\lim_{\\beta\\to\\infty}\\mathcal{Z}_\\beta(\\psi)=|{\\rm STAB}(\\psi)|/2$.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
