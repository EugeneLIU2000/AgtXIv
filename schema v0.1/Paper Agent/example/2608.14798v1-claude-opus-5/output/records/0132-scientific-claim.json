 "payload": {
  "attribution": "Restated by the authors from prior literature, as cited in the paper; this record does not check the cited source",
  "comparison_baseline": "robustness of magic, stabilizer extent/rank, relative entropies of magic, T-count",
  "components": [
   {
    "component_id": "comp:props",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:fbbcc195c76c2617961a018fc1b955d02f516729222e9ec1a4ddee7edc483198",
      "record_id": "span:opus5-2608.14798v1/sre-props",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$M_\\alpha$ is faithful, Clifford-stable, additive, and a monotone for $\\alpha\\geq2$."
   },
   {
    "component_id": "comp:hier",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:25929687d030602e2423f507448861df3b6250ec26be24d56556dc4120f7163e",
      "record_id": "span:opus5-2608.14798v1/renyi-hierarchy",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$M_\\alpha\\leq M_0=\\log(|{\\rm Supp}|/d_n)\\leq\\nu$."
   },
   {
    "component_id": "comp:rom",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:25929687d030602e2423f507448861df3b6250ec26be24d56556dc4120f7163e",
      "record_id": "span:opus5-2608.14798v1/renyi-hierarchy",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$M_\\alpha\\leq2\\log{\\rm RoM}$ and $M_\\alpha\\leq T$-count for $\\alpha\\geq\\frac12$."
   },
   {
    "component_id": "comp:tradeoff",
    "role": "LIMITATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:95d3f7eee42f8ef294c7c46b5fe767e97c495743b4927419720442f48865059b",
      "record_id": "span:opus5-2608.14798v1/intro-tradeoff",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Framing claim: no existing measure is simultaneously resource-theoretically clean, computable/measurable and fine-grained."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:alpha2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:fbbcc195c76c2617961a018fc1b955d02f516729222e9ec1a4ddee7edc483198",
      "record_id": "span:opus5-2608.14798v1/sre-props",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "Monotonicity of $M_\\alpha$ under stabilizer protocols is stated only for $\\alpha\\geq2$ and described as unresolved for $\\alpha<2$"
   },
   {
    "condition_id": "cond:integer",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:fbbcc195c76c2617961a018fc1b955d02f516729222e9ec1a4ddee7edc483198",
      "record_id": "span:opus5-2608.14798v1/sre-props",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "Bell-sampling measurability is stated for integer $\\alpha\\geq2$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:fbbcc195c76c2617961a018fc1b955d02f516729222e9ec1a4ddee7edc483198",
    "record_id": "span:opus5-2608.14798v1/sre-props",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:25929687d030602e2423f507448861df3b6250ec26be24d56556dc4120f7163e",
    "record_id": "span:opus5-2608.14798v1/renyi-hierarchy",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:95d3f7eee42f8ef294c7c46b5fe767e97c495743b4927419720442f48865059b",
    "record_id": "span:opus5-2608.14798v1/intro-tradeoff",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "The stabilizer Renyi entropies are faithful, Clifford-stable and additive, and are magic monotones for $\\alpha\\geq2$; they satisfy $M_\\alpha(\\psi)\\leq M_0=\\log(|{\\rm Supp}(\\psi)|/d_n)\\leq\\nu(\\psi)$, and $M_\\alpha(\\psi)\\leq 2\\log{\\rm RoM}(\\psi)$ and $M_\\alpha(\\psi)\\leq T(\\psi)$ for $\\alpha\\geq\\frac12$. The paper's framing claim is that computable measures carry structural caveats (monotonicity unresolved for $\\alpha<2$; estimation cost grows exactly where the measure is largest; nullity cannot separate states with trivial stabilizer group) while operationally strong measures are not evaluable at scale.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
