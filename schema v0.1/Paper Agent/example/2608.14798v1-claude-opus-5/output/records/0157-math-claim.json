     }
    ],
    "object_type": "real function $\\mathbb{R}\\times\\mathcal{H}\\to\\mathbb{R}$",
    "symbol": "\\mathcal{Z}_\\beta(\\psi)",
    "unit": ""
   }
  ],
  "quantifiers": [
   {
    "domain": "the range of $\\beta$ is not stated in the theorem; the prefactor $e^{-\\beta}$ is not symmetric under $\\beta\\to-\\beta$",
    "kind": "FORALL",
    "variable": "\\beta"
   },
   {
    "domain": "pure states in $\\mathcal{H}_n$",
