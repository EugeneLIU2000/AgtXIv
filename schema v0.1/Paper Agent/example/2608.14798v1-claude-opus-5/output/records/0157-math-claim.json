  },
  "component_ids": [
   "comp:bound"
  ],
  "conclusion": "$|\\mathcal{Z}_{\\beta}(\\psi)-\\mathcal{Z}_{\\beta}(\\phi)|\\leq L_{n}(\\beta)\\,\\|\\psi-\\phi\\|_{1}$ with $L_{n}(\\beta)=e^{-\\beta}d_{n}\\beta\\sinh\\beta$.",
  "definition_refs": [
   {
    "content_hash": "sha256:25570ca9d76dba9ce2ede37ad0830435a435d4f94bf0861893df91243ce438e8",
    "record_id": "definition:opus5-2608.14798v1/spf",
    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   }
  ],
  "exactness": "EXACT",
  "normalization": "$L_n(\\beta)$ grows like $d_n=2^n$, so the bound is extensive in Hilbert-space dimension",
  "objects": [
   {
    "convention": "sum over the full multiset ${\\rm Spec}(\\psi)$ including the identity Pauli; $\\mathcal{Z}_0=d_n^2$",
    "definition_refs": [
     {
      "content_hash": "sha256:25570ca9d76dba9ce2ede37ad0830435a435d4f94bf0861893df91243ce438e8",
      "record_id": "definition:opus5-2608.14798v1/spf",
      "record_type": "agtxiv.v3.definition/0.0.0",
