 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the stabilizer nullity $\\nu$ and the 2-stabilizer Renyi entropy $M_2$",
  "components": [
   {
    "component_id": "comp:bounds",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:93166ae31a65c9c07c357908adc5acf6703a91778cffe6b6b3693318d0fa72b2",
      "record_id": "span:opus5-2608.14798v1/sw-bounds",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Explicit two-sided bound following from the state-independent SPF bounds."
   },
   {
    "component_id": "comp:lowT",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:1c816c509422f606b5fb3f24a22dddd16b094aafe601f9a6807fced80a79961e",
      "record_id": "span:opus5-2608.14798v1/sw-limits",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\beta\\to\\infty$: stabilizer work converges to stabilizer nullity."
   },
   {
    "component_id": "comp:hiT",
    "role": "APPROXIMATION",
    "source_span_refs": [
     {
      "content_hash": "sha256:1c816c509422f606b5fb3f24a22dddd16b094aafe601f9a6807fced80a79961e",
      "record_id": "span:opus5-2608.14798v1/sw-limits",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$\\beta\\to0$: at leading order a function of $M_2$ alone."
   },
   {
    "component_id": "comp:interp",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:1c816c509422f606b5fb3f24a22dddd16b094aafe601f9a6807fced80a79961e",
      "record_id": "span:opus5-2608.14798v1/sw-limits",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Continuous and monotonic interpolation between $M_2$ and $\\nu$."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:beta",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:93166ae31a65c9c07c357908adc5acf6703a91778cffe6b6b3693318d0fa72b2",
      "record_id": "span:opus5-2608.14798v1/sw-bounds",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\beta\\in\\mathbb{R}$ in the corollary; the limit statements concern $\\beta\\to0$ and $\\beta\\to\\infty$"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:93166ae31a65c9c07c357908adc5acf6703a91778cffe6b6b3693318d0fa72b2",
    "record_id": "span:opus5-2608.14798v1/sw-bounds",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:1c816c509422f606b5fb3f24a22dddd16b094aafe601f9a6807fced80a79961e",
    "record_id": "span:opus5-2608.14798v1/sw-limits",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Corollary (Bounds on Stabilizer Work): $0\\leq\\mathcal{W}_\\beta(\\psi)\\leq\\log\\frac{d_A\\cosh\\beta-d_A}{\\cosh\\beta+(d_A^2-1)\\cosh(\\beta/\\sqrt{d_A+1})-d_A^2}$. In the limit $\\beta\\to\\infty$ the stabilizer work converges to the stabilizer nullity; for $\\beta\\to0$ it reduces, at leading order, to a function of the second-order stabilizer Renyi entropy alone. The paper concludes that stabilizer work provides a continuous and monotonic interpolation between two previously independent measures.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
