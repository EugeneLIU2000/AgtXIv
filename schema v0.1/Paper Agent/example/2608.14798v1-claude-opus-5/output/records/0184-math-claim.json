   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "$p_k=w_ka_k/\\sum_k w_ka_k$ is a probability distribution and $p_k/p^\\star_k$ is non-increasing in $k$"
   },
   {
    "condition_id": "assumption:a3",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "$\\sum_{k\\geq1}w_k=\\cosh\\beta-1$"
   }
  ],
