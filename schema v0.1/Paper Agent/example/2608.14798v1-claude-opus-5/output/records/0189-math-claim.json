    "statement": "$U$ is Haar-distributed on $U(2^n)$ and $\\ket{\\psi}=U\\ket{0}^{\\otimes n}$"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "the averaged Pauli-spectrum density of Haar states is the imported Proposition attributed to Turkeshi et al. (2025)"
   }
  ],
  "claim_ref": {
