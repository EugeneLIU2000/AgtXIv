    "record_type": "agtxiv.v3.definition/0.0.0",
    "revision": 1
   }
  ],
  "exactness": "EXACT",
  "normalization": "the $k=0$ term is the Pauli count $d_n^2$ and the $k=1$ term is purity-fixed; neither carries magic",
