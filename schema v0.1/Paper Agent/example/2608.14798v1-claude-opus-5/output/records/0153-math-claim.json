 "payload": {
  "approximation_error": "",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [],
    "statement": "$\\sum_{x\\in{\\rm Spec}(\\psi)}x^{2k}=2^{\\,n-(k-1)M_k(\\psi)}$ for integer $k\\geq2$, i.e. the definition of $M_k$ rearranged"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [],
    "statement": "$\\sum_{x\\in{\\rm Spec}(\\psi)}x^{2}=d_n$ for pure states, giving the $\\beta^2$ term"
   }
  ],
  "claim_ref": {
   "content_hash": "sha256:0933f410328d71a49eb0149eef98100476ead2c0d03983c0ebd9de8085e76700",
   "record_id": "claim:opus5-2608.14798v1/c10",
   "record_type": "agtxiv.v3.scientific-claim/0.0.0",
   "revision": 1
  },
  "component_ids": [
   "comp:renyi"
  ],
  "conclusion": "$\\mathcal{Z}_{\\beta}(\\psi)=e^{-\\beta}\\left[d_{n}^{2}+\\frac{d_{n}}{2}\\beta^{2}+\\sum_{k\\geq 2}\\frac{\\beta^{2k}}{(2k)!}2^{\\,n-(k-1)M_{k}(\\psi)}\\right]$.",
  "definition_refs": [
   {
