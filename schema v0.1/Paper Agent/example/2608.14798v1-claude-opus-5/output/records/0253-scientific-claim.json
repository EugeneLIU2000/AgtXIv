      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Disclosure that Claude was used to refine the Introduction and Discussion, including surfacing the Li-Haldane entanglement-spectrum connection."
   }
