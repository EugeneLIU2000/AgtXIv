      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "'a faithful, subadditive magic monotone at every temperature'."
   },
   {
    "component_id": "comp:efficient",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:70a0f2d15b2b6a97f4d6941d6eefaa4af275e30088e7ed19441a3419c6cc53c0",
      "record_id": "span:opus5-2608.14798v1/abstract",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "'efficiently estimable via Bell sampling', stated for both objects without qualification."
   },
   {
    "component_id": "comp:limits",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:70a0f2d15b2b6a97f4d6941d6eefaa4af275e30088e7ed19441a3419c6cc53c0",
      "record_id": "span:opus5-2608.14798v1/abstract",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Third-law reading of the $\\beta\\to\\infty$ limit and $M_2$ recovery at $\\beta\\to0$."
   },
   {
    "component_id": "comp:strictly-more",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:70a0f2d15b2b6a97f4d6941d6eefaa4af275e30088e7ed19441a3419c6cc53c0",
      "record_id": "span:opus5-2608.14798v1/abstract",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "'the full temperature profile ... carrying strictly more information than either endpoint'."
   },
   {
    "component_id": "comp:classifier",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:70a0f2d15b2b6a97f4d6941d6eefaa4af275e30088e7ed19441a3419c6cc53c0",
      "record_id": "span:opus5-2608.14798v1/abstract",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Exact ensemble formulas plus concentration make the SPF a classifier of magic classes."
   },
   {
    "component_id": "comp:ai",
    "role": "ATTRIBUTION",
    "source_span_refs": [
     {
      "content_hash": "sha256:7ea21cfa726052bf06a886505d2d51f8800d4933235da4c140866674774853af",
