    "condition_id": "assumption:a1",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "the Pauli spectrum factorizes over tensor factors"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "$4^n-3^n$ Pauli strings contain at least one $Z$ and contribute zero"
   },
   {
    "condition_id": "assumption:a3",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "there are $\\binom{n}{k}2^k$ weight-$k$ strings built from $\\{X,Y\\}$, each contributing $2^{-k/2}$"
   }
  ],
