  "approximation_error": "",
  "assumptions": [
   {
    "condition_id": "assumption:a1",
    "origin": "SOURCE_RECONSTRUCTED",
    "source_span_refs": [],
    "statement": "$e^{\\beta}\\mathcal{Z}_\\beta(\\psi)=\\sum_{x\\in{\\rm Spec}(\\psi)}\\cosh(\\beta x)$ is entire in $\\beta$, so term-by-term differentiation is legitimate"
   },
   {
    "condition_id": "assumption:a2",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [],
    "statement": "the SPF derivatives are positive, which the source offers as the justification for exchanging limit and differentiation"
   }
  ],
  "claim_ref": {
   "content_hash": "sha256:dbe85ef6047f8ad702795502a4b72f0cfabcc308988cab6903148317542087fc",
