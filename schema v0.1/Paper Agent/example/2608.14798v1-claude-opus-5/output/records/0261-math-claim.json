   "revision": 1
  },
  "component_ids": [
   "comp:formula"
  ],
  "conclusion": "$M_{\\alpha}(\\psi)=\\lim_{\\beta\\to0}\\frac{1}{1-\\alpha}\\log\\left(\\frac{1}{d_{n}}\\frac{\\partial^{2\\alpha}}{\\partial\\beta^{2\\alpha}}e^{\\beta}\\mathcal{Z}_{\\beta}(\\psi)\\right)$ for $\\alpha\\in\\mathbb{N}$.",
