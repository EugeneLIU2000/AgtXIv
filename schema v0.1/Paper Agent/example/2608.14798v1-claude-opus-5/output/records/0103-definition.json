 "payload": {
  "name": "Stabilizer nullity nu(psi)",
  "objects": [
   {
    "convention": "$\\nu=0$ for stabilizer states; imported from Beverland et al. (2020)",
    "definition_refs": [],
    "object_type": "non-negative integer",
    "symbol": "\\nu(\\psi)",
    "unit": ""
   }
  ],
  "origin": "IMPORTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:89b0b1b9bb761f721849ddbbb360b66caa0125425274f00059b8a1c4acaa5815",
    "record_id": "span:opus5-2608.14798v1/nullity-def",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "For an $n$-qubit state $\\ket{\\psi}$ stabilized by $2^{n-\\nu}$ Pauli strings, $\\nu(\\psi)=\\nu$, equivalently $\\log_2|{\\rm Stab}(\\psi)|=n-\\nu(\\psi)$, equivalently the count of Pauli-spectrum entries equal to $\\pm1$ is $2^{n-\\nu}$."
 },
