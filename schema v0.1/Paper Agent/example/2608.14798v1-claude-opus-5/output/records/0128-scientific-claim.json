 "payload": {
  "attribution": "Salazar, Saxena, Baker, Kwek, Kyaw, arXiv:2608.14798v1; asserted by the authors in the paper text",
  "comparison_baseline": "the trivial bound |Ker| <= 4^n - |Stab(psi)|",
  "components": [
   {
    "component_id": "comp:split",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:b0c6259ed4473609490dd40634b7819356b57ad033d791adbbfec93918c0c97a",
      "record_id": "span:opus5-2608.14798v1/spec-split",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     },
     {
      "content_hash": "sha256:898b1749d5f29aa322d30058a627ec62c2a59d0ecd8667db02bcc672063b96be",
      "record_id": "span:opus5-2608.14798v1/supp-ker",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "Disjoint decomposition of $\\mathcal{P}_n$ into support and Pauli kernel."
   },
   {
    "component_id": "comp:bounds",
    "role": "CONCLUSION",
    "source_span_refs": [
     {
      "content_hash": "sha256:0e3d08c193074a5cbe14de738cc8560a4c6fff3eb342ad8284bc2f87e1e9f076",
      "record_id": "span:opus5-2608.14798v1/kernel-bound",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "$2^n(2^n-2^{\\nu})\\leq|{\\rm Ker}_\\mathcal{P}(\\psi)|\\leq 4^n-2^n$."
   },
   {
    "component_id": "comp:tighter",
    "role": "EVIDENCE",
    "source_span_refs": [
     {
      "content_hash": "sha256:0e3d08c193074a5cbe14de738cc8560a4c6fff3eb342ad8284bc2f87e1e9f076",
      "record_id": "span:opus5-2608.14798v1/kernel-bound",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "text": "The proof first derives the nullity-dependent upper bound $4^n-2^{n-\\nu(\\psi)}$ and then replaces it by the state-independent $4^n-2^n$, described as 'tighter more fundamental'."
   }
  ],
  "conditions": [
   {
    "condition_id": "cond:pure",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:b0c6259ed4473609490dd40634b7819356b57ad033d791adbbfec93918c0c97a",
      "record_id": "span:opus5-2608.14798v1/spec-split",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "$\\psi$ is pure"
   },
   {
    "condition_id": "cond:m0",
    "origin": "SOURCE_EXPLICIT",
    "source_span_refs": [
     {
      "content_hash": "sha256:b0c6259ed4473609490dd40634b7819356b57ad033d791adbbfec93918c0c97a",
      "record_id": "span:opus5-2608.14798v1/spec-split",
      "record_type": "agtxiv.v3.source-span/0.0.0",
      "revision": 1
     }
    ],
    "statement": "The lower bound uses $|{\\rm Supp}(\\psi)|=d\\,2^{M_0(\\psi)}\\leq d\\,2^{\\nu(\\psi)}$, attributed to Leone et al. (2024), with $M_0$ the zero-order stabilizer Renyi entropy"
   }
  ],
  "modality": "ASSERTED",
  "source_span_refs": [
   {
    "content_hash": "sha256:b0c6259ed4473609490dd40634b7819356b57ad033d791adbbfec93918c0c97a",
    "record_id": "span:opus5-2608.14798v1/spec-split",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:898b1749d5f29aa322d30058a627ec62c2a59d0ecd8667db02bcc672063b96be",
    "record_id": "span:opus5-2608.14798v1/supp-ker",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   },
   {
    "content_hash": "sha256:0e3d08c193074a5cbe14de738cc8560a4c6fff3eb342ad8284bc2f87e1e9f076",
    "record_id": "span:opus5-2608.14798v1/kernel-bound",
    "record_type": "agtxiv.v3.source-span/0.0.0",
    "revision": 1
   }
  ],
  "statement": "Every pure state induces a disjoint decomposition $\\mathcal{P}_n={\\rm Supp}(\\psi)\\cup{\\rm Ker}_\\mathcal{P}(\\psi)$ with $|{\\rm Supp}|+|{\\rm Ker}_\\mathcal{P}|=d_n^2$, ${\\rm Stab}(\\psi)\\subseteq{\\rm Supp}(\\psi)$ with equality for stabilizer states, and the kernel obeys $2^n(2^n-2^{\\nu(\\psi)})\\leq|{\\rm Ker}_\\mathcal{P}(\\psi)|\\leq 4^n-2^n$.",
  "system": "$n$-qubit pure states, $\\mathcal{H}_n\\cong(\\mathbb{C}^2)^{\\otimes n}$, $d_n=2^n$, finite $n$"
 },
