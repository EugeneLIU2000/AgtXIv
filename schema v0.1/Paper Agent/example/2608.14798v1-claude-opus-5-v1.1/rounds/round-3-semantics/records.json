       "revision": 1
      }
     ],
     "statement": "the Jordan-Wigner encoding is fixed; no other fermion-to-qubit encoding is tested"
    },
    {
     "condition_id": "condition:assumption-2",
     "origin": "SOURCE_EXPLICIT",
     "source_span_refs": [
