            "record_id": "example:2608.14798v1-span-788-805",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          }
        ],
        "statement": "The input is n identical copies of a single-qubit pure state, not an arbitrary collection of different local states."
      },
      {
        "condition_id": "condition:product-powers-1",
        "origin": "SOURCE_RECONSTRUCTED",
        "source_span_refs": [
          {
            "content_hash": "sha256:04a4b89f584e24997befa43b698276361cb5ef7cdf38031cc0feb5ac77f16736",
