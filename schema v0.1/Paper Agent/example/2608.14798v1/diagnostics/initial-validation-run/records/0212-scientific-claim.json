            "record_id": "example:2608.14798v1-span-1187-1192",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          },
          {
            "content_hash": "sha256:881396a153eba0763da9fcb8e5a105091b5d77c9cc2ca631d1bb55291daacc55",
            "record_id": "example:2608.14798v1-span-1614-1634",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          },
          {
            "content_hash": "sha256:8cc7a0f40f20d92f1495e51f3b755f5b6bfb33ebaf5be3c9558504e88891431b",
            "record_id": "example:2608.14798v1-span-1669-1669",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          }
        ],
        "statement": "Free mixed states admit decompositions into pure stabilizer states."
      },
      {
        "condition_id": "condition:mixed-channel-extension-2",
        "origin": "SOURCE_RECONSTRUCTED",
        "source_span_refs": [
