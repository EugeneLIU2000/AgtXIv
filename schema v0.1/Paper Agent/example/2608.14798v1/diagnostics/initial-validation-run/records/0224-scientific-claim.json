            "record_id": "example:2608.14798v1-span-2704-2721",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          }
        ],
        "statement": "Ground states are obtained by full diagonalization within a chosen finite one-particle basis and Jordan-Wigner encoding."
      },
      {
        "condition_id": "condition:hydrogen-basis-effects-1",
        "origin": "SOURCE_RECONSTRUCTED",
        "source_span_refs": [
          {
            "content_hash": "sha256:d107272281f3a9827c51c4cc33e3c0cd73bbd7361dd55c0638d1118b02d156d1",
            "record_id": "example:2608.14798v1-span-1516-1532",
