            "record_id": "example:2608.14798v1-span-2704-2721",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          }
        ],
        "statement": "STO-3G uses four spin-orbitals and four qubits; 6-31G uses eight spin-orbitals and eight qubits."
      },
      {
