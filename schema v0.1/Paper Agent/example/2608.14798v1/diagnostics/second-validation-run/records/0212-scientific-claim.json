            "record_id": "example:2608.14798v1-db635458e365-span-1187-1192",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          },
          {
            "content_hash": "sha256:9753ac5c82684165d37e67249f15b9f1915e4032e1e3f0b2154f7f22c003468c",
            "record_id": "example:2608.14798v1-db635458e365-span-1614-1634",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          },
          {
            "content_hash": "sha256:7107388ec35b5364f1700a29c0e0dfc2bd142794ae6cdf623da6ad7112efc5c1",
            "record_id": "example:2608.14798v1-db635458e365-span-1669-1669",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          }
        ],
        "statement": "Free mixed states admit decompositions into pure stabilizer states."
      },
      {
        "condition_id": "condition:mixed-channel-extension-2",
        "origin": "SOURCE_RECONSTRUCTED",
        "source_span_refs": [
          {
