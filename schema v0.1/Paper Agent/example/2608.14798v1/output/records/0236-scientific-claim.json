            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          },
          {
            "content_hash": "sha256:c445f7c82d560f93d34a28723df7d289c7ff0344614ba885ee62685ba56c6c4a",
            "record_id": "example:2608.14798v1-dcd840ebd74b-span-2089-2188",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          },
          {
            "content_hash": "sha256:d62fe347b1193712b79f5978c941a3c1b5af90044c7820c67dcfce1de924211c",
            "record_id": "example:2608.14798v1-dcd840ebd74b-span-2192-2231",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          }
        ],
        "statement": "Efficiency in the supplementary prose is stated for fixed k and beta."
      }
