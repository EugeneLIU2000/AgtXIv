            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          },
          {
            "content_hash": "sha256:2d61f34d0aa3e6a60baf5f05e168809c128628a9f488ec1daeecf9fbcbede3c3",
            "record_id": "example:2608.14798v1-dcd840ebd74b-span-1614-1634",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          },
          {
            "content_hash": "sha256:07c1532a715641b17eeaf4fd62147efbd1691f9994329c0693d872b7a3ce1b50",
            "record_id": "example:2608.14798v1-dcd840ebd74b-span-1669-1669",
            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          }
        ],
        "statement": "Free mixed states admit decompositions into pure stabilizer states."
      },
      {
        "condition_id": "condition:mixed-channel-extension-2",
        "origin": "SOURCE_RECONSTRUCTED",
        "source_span_refs": [
