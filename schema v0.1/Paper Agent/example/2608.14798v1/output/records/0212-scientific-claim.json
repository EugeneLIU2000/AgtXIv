            "record_type": "agtxiv.v3.source-span/0.0.0",
            "revision": 1
          }
        ],
        "statement": "rho is a finite-dimensional mixed quantum state and the supremum ranges over its pure-state decompositions with probabilities p_i."
      },
      {
        "condition_id": "condition:mixed-channel-extension-1",
        "origin": "SOURCE_RECONSTRUCTED",
        "source_span_refs": [
