            "reuse-decision",
            "environment-check",
            "formal-environment",
            "formal-check",
            "axis-assessment",
            "challenge",
            "frontier-item",
            "impact-analysis"
          ],
          "output_record_types": [
            "baseline-snapshot",
            "dependency-binding",
            "frontier-item"
          ],
          "capabilities": [
            "records.read",
            "dependency.search",
            "candidates.propose"
          ],
          "principles": [
            "检索绑定实际目标和有限来源范围；读取知识时使用精确快照，未知覆盖明确保留。",
            "只输出真实已有端点的候选绑定和固定基准，不维护数据库，不批准自身复用候选。",
            "条件相似、缓存命中或未找到旧结果都不是可复用或全球首次的证据。",
            "与 Proof 迭代；具体用途由独立 review.reuse 判断，预算耗尽后记录前沿而不无限递归。"
          ]
        }
      ]
    },
    {
      "agent_id": "formalization",
      "title": "Formalization：固定目标的形式代码生成",
      "execution_kind": "HYBRID",
      "operations": [
        {
          "operation": "formalization.generate",
          "input_record_types": [
            "formalization-packet",
