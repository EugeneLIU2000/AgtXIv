{
  "contract_version": "0.1.0",
  "agents": [
    {
      "agent_id": "paper",
      "title": "Paper：原文理解与数学提取",
      "execution_kind": "MODEL",
      "operations": [
        {
          "operation": "paper.extract",
          "input_record_types": [
            "source-snapshot",
            "source-span",
            "source-transformation",
            "paper-structure",
            "inventory-discovery",
            "frozen-scope",
            "scientific-claim",
            "derived-claim",
            "definition",
            "math-claim",
            "claim-component-map",
            "semantic-context",
            "challenge",
            "frontier-item"
          ],
          "output_record_types": [
            "source-span",
            "paper-structure",
            "inventory-discovery",
            "scientific-claim",
            "definition",
            "math-claim",
            "claim-component-map",
            "semantic-context",
            "frontier-item"
          ],
          "capabilities": [
            "records.read",
            "source.read",
            "candidates.propose"
          ],
          "principles": [
            "必需精确 source-snapshot、agentization-plan、processing-profile 及可取得的原文字节；输入目录不是每项必填清单。",
            "保留原文条件、未分类来源和提取缺口；数学抽取不授予来源忠实性或数学正确性。",
            "不得冻结自己的发现或批准自身产物；范围由独立 review.scope 审阅。",
            "业务输出必须在本任务 expected_record_types 中事先声明；无法完成时保留真实诊断。"
          ]
        }
      ]
    },
    {
      "agent_id": "proof",
      "title": "Proof：逐步论证与证明路线",
      "execution_kind": "MODEL",
      "operations": [
        {
          "operation": "proof.expand",
          "input_record_types": [
            "math-claim",
            "frozen-scope",
            "scientific-claim",
            "derived-claim",
            "source-snapshot",
            "source-span",
            "definition",
            "semantic-context",
            "assumption-context",
            "argument-node",
            "inference-step",
            "proof-plan",
            "dependency-binding",
            "reuse-decision",
            "argument-snapshot",
            "argument-review",
            "challenge",
            "challenge-disposition",
            "upstream-import",
            "counterexample",
            "frontier-item"
          ],
          "output_record_types": [
            "argument-node",
            "assumption-context",
            "inference-step",
            "proof-plan",
            "argument-snapshot",
            "derived-claim",
            "math-claim",
            "counterexample",
            "challenge",
            "frontier-item"
          ],
          "capabilities": [
            "records.read",
            "argument.expand",
            "candidates.propose"
          ],
          "principles": [
            "必需 math-claim 与 frozen-scope；证明可与依赖检索按具体目标并行，未证前提必须明列。",
            "Lamport 风格层级只用于阅读；共同前提和替代证明路线分别保留，不能把目录树当推理图。",
            "新增条件形成不同命题，修复归属不冒充原作者；生产者不能关闭独立异议。",
            "交付公开论证与缺口不等于科学成功；review.argument 独立审查，形式包交 utility.assemble-packet 组装。"
          ]
        }
      ]
    },
    {
      "agent_id": "dependency",
      "title": "Dependency：基准、依赖与复用候选",
      "execution_kind": "HYBRID",
      "operations": [
        {
          "operation": "dependency.search",
          "input_record_types": [
            "source-snapshot",
            "source-span",
            "paper-structure",
            "inventory-discovery",
            "scientific-claim",
            "derived-claim",
            "math-claim",
            "definition",
            "semantic-context",
