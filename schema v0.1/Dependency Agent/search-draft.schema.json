{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/dependency-agent/1.0/search-draft.schema.json",
  "title": "Dependency search proposal — not a retrieval receipt, a reuse authorization or a novelty claim",
  "description": "Internal model-to-host draft for dependency.search. Payload shapes come only from the pinned v0.0 business schemas. search_requests are proposed retrieval actions, not evidence that any retrieval ran. The host owns record envelopes, real execution attribution and validation. A shape-valid draft is not evidence of reusability and not evidence of absence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_version",
    "search_requests",
    "records",
    "open_items",
    "follow_up_requests"
  ],
  "properties": {
    "draft_version": {
      "const": "1.0"
    },
    "search_requests": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_ref",
          "query",
          "sources"
        ],
        "properties": {
          "target_ref": {
            "anyOf": [
              {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/common.schema.json#/$defs/RecordRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "sources": {
            "$ref": "https://agtxiv.org/schema/orchestration/0.1.0/common.schema.json#/$defs/Strings"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_type",
              "payload"
            ],
            "properties": {
              "record_type": {
                "const": "agtxiv.v3.baseline-snapshot/0.0.0"
              },
              "payload": {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/baseline-snapshot.schema.json#/properties/payload"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_type",
              "payload"
            ],
            "properties": {
              "record_type": {
                "const": "agtxiv.v3.dependency-binding/0.0.0"
              },
              "payload": {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/dependency-binding.schema.json#/properties/payload"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_type",
              "payload"
            ],
            "properties": {
              "record_type": {
                "const": "agtxiv.v3.frontier-item/0.0.0"
              },
              "payload": {
                "$ref": "https://agtxiv.org/schema/v3/0.0.0/frontier-item.schema.json#/properties/payload"
              }
            }
          }
        ]
      }
    },
    "open_items": {
      "$ref": "https://agtxiv.org/schema/orchestration/0.1.0/common.schema.json#/$defs/Strings"
    },
    "follow_up_requests": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://agtxiv.org/schema/orchestration/0.1.0/common.schema.json#/$defs/FollowUp"
      }
    }
  }
}
