{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/orchestration/0.1.0/archive-batch.schema.json",
  "title": "Closed candidate export with exact bytes, not a release or admission",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "batch_kind", "batch_id", "source_store_id", "created_at", "parent_batch_id", "base_bundle_hash", "files"],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "batch_kind": {"const": "CANDIDATE_EXPORT"},
    "batch_id": {"$ref": "common.schema.json#/$defs/Id"},
    "source_store_id": {"$ref": "common.schema.json#/$defs/Id"},
    "created_at": {"$ref": "common.schema.json#/$defs/Time"},
    "parent_batch_id": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/Id"}]},
    "base_bundle_hash": {"$ref": "common.schema.json#/$defs/Hash"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "kind", "sha256", "size_bytes", "ref"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "kind": {"enum": ["RECORD", "ARTIFACT"]},
          "sha256": {"$ref": "common.schema.json#/$defs/Hash"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "ref": {"oneOf": [{"$ref": "common.schema.json#/$defs/RecordRef"}, {"$ref": "common.schema.json#/$defs/ArtifactRef"}]}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "RECORD"}}}, "then": {"properties": {"ref": {"$ref": "common.schema.json#/$defs/RecordRef"}}}},
          {"if": {"properties": {"kind": {"const": "ARTIFACT"}}}, "then": {"properties": {"ref": {"$ref": "common.schema.json#/$defs/ArtifactRef"}}}}
        ]
      }
    }
  }
}
