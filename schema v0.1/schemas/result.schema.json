{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtxiv.org/schema/orchestration/0.1.0/result.schema.json",
  "title": "Attempt delivery and declared execution receipt, never a scientific approval",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "task_id", "attempt_id", "outcome", "output_refs", "artifacts", "open_items", "follow_up_requests", "execution"],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "task_id": {"$ref": "common.schema.json#/$defs/Id"},
    "attempt_id": {"$ref": "common.schema.json#/$defs/Id"},
    "outcome": {"enum": ["DELIVERED", "BLOCKED", "FAILED", "DEFERRED"]},
    "output_refs": {"$ref": "common.schema.json#/$defs/Refs"},
    "artifacts": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/ArtifactRef"}},
    "open_items": {"$ref": "common.schema.json#/$defs/Strings"},
    "follow_up_requests": {"type": "array", "maxItems": 1000, "items": {"$ref": "common.schema.json#/$defs/FollowUp"}},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["principal_id", "execution_id", "visible_input_refs", "visible_artifact_refs", "started_at", "finished_at", "cost_units"],
      "properties": {
        "principal_id": {"$ref": "common.schema.json#/$defs/PrincipalId"},
        "execution_id": {"$ref": "common.schema.json#/$defs/Id"},
        "visible_input_refs": {"$ref": "common.schema.json#/$defs/Refs"},
        "visible_artifact_refs": {"$ref": "common.schema.json#/$defs/ArtifactRefs"},
        "started_at": {"$ref": "common.schema.json#/$defs/Time"},
        "finished_at": {"$ref": "common.schema.json#/$defs/Time"},
        "cost_units": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      },
      "description": "Must be captured by a trusted execution host in a real system. This JSON is not an authenticated attestation."
    }
  }
}
